+@pytest.mark.parametrize("is_admin", [False, True])
+def test_graphql_nested_model_versions_require_model_permission(
+    workspace_permission_setup, monkeypatch, is_admin
+):
+    store = workspace_permission_setup["store"]
+    username = workspace_permission_setup["username"]
+    _set_workspace_permission(store, username, NO_PERMISSIONS.name)
+    store.grant_user_permission(username, "experiment", "exp-1", READ.name)
+    store.grant_user_permission(username, "registered_model", "readable", READ.name)
+    store.update_user(username, is_admin=is_admin)
+    registry_store = _RegistryStore({
+        "readable": "team-a",
+        "private": "team-a",
+        "other-workspace": "team-b",
+    })
+    monkeypatch.setattr(auth_module, "_get_model_registry_store", lambda: registry_store)
+    monkeypatch.setattr(
+        handlers,
+        "get_run_impl",
+        lambda _: SimpleNamespace(run=SimpleNamespace(info=SimpleNamespace(run_id="run-1"))),
+    )
+    monkeypatch.setattr(
+        handlers,
+        "search_model_versions_impl",
+        lambda _: SimpleNamespace(model_versions=[
+            SimpleNamespace(name=name) for name in registry_store._model_workspaces
+        ]),
+    )
+
+    result = schema.execute(
+        '''{
+            mlflowGetRun(input: {runId: "run-1"}) {
+                run { linkedModels: modelVersions { name } }
+            }
+        }''',
+        middleware=[auth_module.GraphQLAuthorizationMiddleware()],
+    )
+
+    assert not result.errors
+    versions = result.data["mlflowGetRun"]["run"]["linkedModels"]
+    assert {version["name"] for version in versions} == (
+        {"readable", "private", "other-workspace"} if is_admin else {"readable"}
+    )
+
