+@pytest.mark.parametrize("resource_type", ["prompt", "registered_model"])
+def test_graphql_model_versions_respect_prompt_namespace(workspace_permission_setup, resource_type):
+    store = workspace_permission_setup["store"]
+    username = workspace_permission_setup["username"]
+    _set_workspace_permission(store, username, NO_PERMISSIONS.name)
+    role = store.create_role(name="version-reader", workspace="team-a")
+    store.add_role_permission(role.id, resource_type, "*", READ.name)
+    store.assign_role_to_user(store.get_user(username).id, role.id)
+
+    result = SearchModelVersions.Response()
+    prompt = result.model_versions.add(name="prompt", version="1")
+    prompt.tags.add(key=IS_PROMPT_TAG_KEY, value="true")
+    result.model_versions.add(name="model", version="1")
+    resolver = Mock(return_value=result)
+
+    filtered = auth_module.GraphQLAuthorizationMiddleware().resolve(
+        resolver, None, SimpleNamespace(field_name="mlflowSearchModelVersions")
+    )
+
+    assert [mv.name for mv in filtered.model_versions] == [
+        "prompt" if resource_type == "prompt" else "model"
+    ]
+    resolver.assert_called_once()
+
