+@pytest.mark.parametrize(
+    ("resource_type", "pattern", "grant_workspace", "expected_names"),
+    [
+        ("prompt", "foo", "team-a", ["foo"]),
+        ("registered_model", "foo", "team-a", []),
+        ("prompt", "*", "team-a", ["foo"]),
+        ("registered_model", "*", "team-a", ["bar"]),
+        ("prompt", "*", "team-b", []),
+        ("registered_model", "*", "team-b", []),
+        ("workspace", "*", "team-a", ["foo", "bar"]),
+    ],
+)
+def test_graphql_search_model_versions_respects_prompt_namespace(
+    workspace_permission_setup, resource_type, pattern, grant_workspace, expected_names
+):
+    store = workspace_permission_setup["store"]
+    username = workspace_permission_setup["username"]
+    _set_workspace_permission(store, username, NO_PERMISSIONS.name)
+    role = store.create_role(name="reader", workspace=grant_workspace)
+    permission = MANAGE if resource_type == "workspace" else READ
+    store.add_role_permission(role.id, resource_type, pattern, permission.name)
+    store.assign_role_to_user(store.get_user(username).id, role.id)
+
+    response = SearchModelVersions.Response(
+        model_versions=[
+            {
+                "name": "foo",
+                "version": "1",
+                "tags": [{"key": IS_PROMPT_TAG_KEY, "value": "true"}],
+            },
+            {"name": "bar", "version": "1"},
+        ],
+        next_page_token="next-page",
+    )
+    resolver = Mock(return_value=response)
+    result = auth_module.GraphQLAuthorizationMiddleware().resolve(
+        resolver,
+        None,
+        SimpleNamespace(field_name="mlflowSearchModelVersions"),
+        input=SimpleNamespace(),
+    )
+
+    resolver.assert_called_once()
+    assert [mv.name for mv in result.model_versions] == expected_names
+    assert result.next_page_token == "next-page"
+
