+@pytest.mark.parametrize("is_admin", [False, True])
+@pytest.mark.parametrize("alias", ["modelVersions", "linkedModels: modelVersions"])
+def test_graphql_nested_model_versions_respect_permissions(
+    workspace_permission_setup, monkeypatch, is_admin, alias
+):
+    store = workspace_permission_setup["store"]
+    username = workspace_permission_setup["username"]
+    _set_workspace_permission(store, username, NO_PERMISSIONS.name)
+    store.grant_user_permission(username, "experiment", "exp-1", READ.name)
+    store.grant_user_permission(username, "registered_model", "visible-model", READ.name)
+    store.update_user(username, is_admin=is_admin)
+    monkeypatch.setattr(
+        handlers,
+        "get_run_impl",
+        lambda _: SimpleNamespace(run=SimpleNamespace(info=SimpleNamespace(run_id="run-1"))),
+    )
+    monkeypatch.setattr(
+        handlers,
+        "search_model_versions_impl",
+        lambda _: SimpleNamespace(
+            model_versions=[
+                SimpleNamespace(name="visible-model", version="1"),
+                SimpleNamespace(name="private-model", version="1"),
+            ]
+        ),
+    )
+
+    with auth_module.app.test_request_context("/graphql"):
+        result = schema.execute(
+            """
+            query {
+                mlflowGetRun(input: {runId: "run-1"}) {
+                    run { %s { name version } }
+                }
+            }
+            """
+            % alias,
+            middleware=[auth_module.GraphQLAuthorizationMiddleware()],
+        )
+
+    assert not result.errors
+    field = "linkedModels" if ":" in alias else "modelVersions"
+    versions = result.data["mlflowGetRun"]["run"][field]
+    expected = [{"name": "visible-model", "version": "1"}]
+    if is_admin:
+        expected.append({"name": "private-model", "version": "1"})
+    assert versions == expected
+
+
