+@pytest.mark.parametrize("is_admin", [False, True])
+@pytest.mark.parametrize("search_runs", [False, True])
+def test_graphql_nested_model_versions_authorization(
+    workspace_permission_setup, monkeypatch, is_admin, search_runs
+):
+    store = workspace_permission_setup["store"]
+    username = workspace_permission_setup["username"]
+    _set_workspace_permission(store, username, NO_PERMISSIONS.name)
+    role = store.create_role("reader", "team-a")
+    store.add_role_permission(role.id, "experiment", "exp-1", READ.name)
+    store.add_role_permission(role.id, "registered_model", "visible", READ.name)
+    store.assign_role_to_user(store.get_user(username).id, role.id)
+    if is_admin:
+        store.update_user(username, is_admin=True)
+
+    run = SimpleNamespace(info=SimpleNamespace(run_id="run-1", experiment_id="exp-1"))
+    monkeypatch.setattr(handlers, "get_run_impl", lambda req: SimpleNamespace(run=run))
+    monkeypatch.setattr(handlers, "search_runs_impl", lambda req: SimpleNamespace(runs=[run]))
+    monkeypatch.setattr(
+        handlers,
+        "search_model_versions_impl",
+        lambda req: SimpleNamespace(
+            model_versions=[SimpleNamespace(name="visible"), SimpleNamespace(name="private")]
+        ),
+    )
+    if search_runs:
+        query = """
+            { mlflowSearchRuns(input: {experimentIds: ["exp-1"]}) {
+                runs { leaked: modelVersions { name } }
+            } }
+        """
+    else:
+        query = """
+            { mlflowGetRun(input: {runId: "run-1"}) {
+                run { leaked: modelVersions { name } }
+            } }
+        """
+
+    result = schema.execute(query, middleware=[auth_module.GraphQLAuthorizationMiddleware()])
+
+    assert result.errors is None
+    if search_runs:
+        versions = result.data["mlflowSearchRuns"]["runs"][0]["leaked"]
+    else:
+        versions = result.data["mlflowGetRun"]["run"]["leaked"]
+    expected = [{"name": "visible"}, {"name": "private"}] if is_admin else [{"name": "visible"}]
+    assert versions == expected
+
+
