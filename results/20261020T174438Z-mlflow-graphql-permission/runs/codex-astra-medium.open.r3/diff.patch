+@pytest.mark.parametrize("is_admin", [False, True])
+@pytest.mark.parametrize("allowed_models", [[], ["readable-model"]])
+def test_graphql_nested_model_versions_permissions(
+    workspace_permission_setup, monkeypatch, is_admin, allowed_models
+):
+    store = workspace_permission_setup["store"]
+    username = workspace_permission_setup["username"]
+    _set_workspace_permission(store, username, NO_PERMISSIONS.name)
+    user = store.get_user(username)
+    role = store.create_role(name="run-reader", workspace="team-a")
+    store.add_role_permission(role.id, "experiment", "exp-1", READ.name)
+    for name in allowed_models:
+        store.add_role_permission(role.id, "registered_model", name, READ.name)
+    store.assign_role_to_user(user.id, role.id)
+    store.update_user(username, is_admin=is_admin)
+
+    model_names = ["readable-model", "private-model"]
+    monkeypatch.setattr(
+        "mlflow.server.handlers.get_run_impl",
+        lambda request: SimpleNamespace(run=SimpleNamespace(info=SimpleNamespace(run_id="run-1"))),
+    )
+    monkeypatch.setattr(
+        "mlflow.server.handlers.search_model_versions_impl",
+        lambda request: SimpleNamespace(
+            model_versions=[SimpleNamespace(name=name) for name in model_names]
+        ),
+    )
+
+    result = schema.execute(
+        """
+        query {
+            mlflowGetRun(input: {runId: "run-1"}) {
+                run { versions: modelVersions { name } }
+            }
+        }
+        """,
+        middleware=[auth_module.GraphQLAuthorizationMiddleware()],
+    )
+
+    assert result.errors is None
+    assert result.data["mlflowGetRun"]["run"]["versions"] == [
+        {"name": name} for name in (model_names if is_admin else allowed_models)
+    ]
+
+
