+@pytest.mark.parametrize("resource_type", ["prompt", "registered_model"])
+def test_graphql_model_versions_respect_permission_namespace(
+    workspace_permission_setup, resource_type
+):
+    store = workspace_permission_setup["store"]
+    username = workspace_permission_setup["username"]
+    _set_workspace_permission(store, username, NO_PERMISSIONS.name)
+    role = store.create_role(name="reader", workspace="team-a")
+    store.add_role_permission(role.id, resource_type, "foo", READ.name)
+    store.assign_role_to_user(store.get_user(username).id, role.id)
+
+    response = SearchModelVersions.Response()
+    response.model_versions.add(
+        name="foo", version="1", tags=[{"key": IS_PROMPT_TAG_KEY, "value": "true"}]
+    )
+    response.model_versions.add(name="foo", version="2")
+    response.model_versions.add(name="ungranted", version="1")
+    middleware = auth_module.GraphQLAuthorizationMiddleware()
+
+    result = middleware.resolve(
+        lambda root, info, **args: response,
+        None,
+        SimpleNamespace(field_name="mlflowSearchModelVersions"),
+        input=SimpleNamespace(),
+    )
+
+    assert [(mv.name, mv.version) for mv in result.model_versions] == [
+        ("foo", "1" if resource_type == "prompt" else "2")
+    ]
+
