+@pytest.mark.parametrize("grant_workspace", [None, "team-a", "team-b"])
+@pytest.mark.parametrize("is_admin", [False, True])
+def test_graphql_nested_model_versions_authorization(
+    workspace_permission_setup, monkeypatch, grant_workspace, is_admin
+):
+    store = workspace_permission_setup["store"]
+    username = workspace_permission_setup["username"]
+    user_id = store.get_user(username).id
+    _set_workspace_permission(store, username, NO_PERMISSIONS.name)
+    experiment_role = store.create_role(name="experiment-reader", workspace="team-a")
+    store.add_role_permission(experiment_role.id, "experiment", "exp-1", READ.name)
+    store.assign_role_to_user(user_id, experiment_role.id)
+    if is_admin:
+        store.update_user(username, is_admin=True)
+    if grant_workspace:
+        role = store.create_role(name="model-reader", workspace=grant_workspace)
+        store.add_role_permission(role.id, "registered_model", "readable-model", READ.name)
+        store.assign_role_to_user(user_id, role.id)
+
+    run = SimpleNamespace(info=SimpleNamespace(run_id="run-1", experiment_id="exp-1"))
+    monkeypatch.setattr("mlflow.server.handlers.get_run_impl", lambda _: SimpleNamespace(run=run))
+    monkeypatch.setattr(
+        "mlflow.server.handlers.search_model_versions_impl",
+        lambda _: SimpleNamespace(
+            model_versions=[
+                SimpleNamespace(name="readable-model", version="1"),
+                SimpleNamespace(name="private-model", version="2"),
+            ]
+        ),
+    )
+
+    result = schema.execute(
+        '{ mlflowGetRun(input: {runId: "run-1"}) { run { '
+        "versions: modelVersions { name version } } } }",
+        middleware=[auth_module.GraphQLAuthorizationMiddleware()],
+    )
+    assert not result.errors
+    expected = []
+    if is_admin or grant_workspace == "team-a":
+        expected.append({"name": "readable-model", "version": "1"})
+    if is_admin:
+        expected.append({"name": "private-model", "version": "2"})
+    assert result.data == {"mlflowGetRun": {"run": {"versions": expected}}}
+
