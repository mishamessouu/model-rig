diff --git a/tests/server/auth/test_auth_workspace.py b/tests/server/auth/test_auth_workspace.py
index c24ffce..fa6a3e2 100644
--- a/tests/server/auth/test_auth_workspace.py
+++ b/tests/server/auth/test_auth_workspace.py
@@ -58,6 +58,45 @@ def test_cleanup_workspace_permissions_handler(monkeypatch):
     mock_delete_roles.assert_called_once_with(workspace_name)
 
 
+def test_list_users_is_scoped_to_active_workspace(monkeypatch):
+    monkeypatch.setenv(MLFLOW_ENABLE_WORKSPACES.name, "true")
+    requester = SimpleNamespace(
+        id=1,
+        username="requester",
+        is_admin=False,
+        to_json=lambda: {"username": "requester", "is_admin": False},
+    )
+    other_workspace_user = SimpleNamespace(
+        username="other",
+        is_admin=False,
+        to_json=lambda: {"username": "other", "is_admin": False},
+    )
+    requester_role = SimpleNamespace(workspace="team-a", to_json=lambda: {})
+    other_role = SimpleNamespace(workspace="team-b", to_json=lambda: {})
+    monkeypatch.setattr(
+        auth_module.store,
+        "list_users_with_roles",
+        lambda: [
+            (requester, [requester_role]),
+            (other_workspace_user, [other_role]),
+        ],
+    )
+    monkeypatch.setattr(auth_module.store, "get_user", lambda _: requester)
+    monkeypatch.setattr(auth_module.store, "list_workspace_admin_workspaces", lambda _: set())
+    monkeypatch.setattr(
+        auth_module, "authenticate_request", lambda: SimpleNamespace(username="requester")
+    )
+
+    token = workspace_context.set_server_request_workspace("team-a")
+    try:
+        with auth_module.app.test_request_context("/api/3.0/mlflow/users/list", method="GET"):
+            response = auth_module.list_users()
+    finally:
+        workspace_context._WORKSPACE.reset(token)
+
+    assert [user["username"] for user in response.json["users"]] == ["requester"]
+
+
 def _create_workspace_response(workspace_name: str) -> Response:
     payload = {"workspace": {"name": workspace_name}}
     return Response(json.dumps(payload), status=201, content_type="application/json")
