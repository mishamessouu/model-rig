+@pytest.mark.parametrize("permission", [READ, USE, EDIT, MANAGE])
+def test_graphql_experiment_and_run_permissions_honor_resource_grants(
+    workspace_permission_setup, permission
+):
+    store = workspace_permission_setup["store"]
+    username = workspace_permission_setup["username"]
+    _set_workspace_permission(store, username, NO_PERMISSIONS.name)
+    store.grant_user_resource_permission(username, "experiment", "exp-1", permission.name)
+
+    assert auth_module._get_experiment_permission("exp-1", username) == permission
+    assert auth_module._graphql_get_permission_for_experiment("exp-1", username) == permission
+    assert auth_module._graphql_get_permission_for_run("run-1", username) == permission
+    assert not auth_module._graphql_can_read_experiment("exp-2", username)
+    assert not auth_module._graphql_can_read_run("run-2", username)
+
