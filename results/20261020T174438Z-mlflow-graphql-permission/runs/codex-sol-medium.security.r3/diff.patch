         "mlflowSearchModelVersions",
+        "modelVersions",
     }
 
     def resolve(self, next, root, info, **args):
@@ -5194,6 +5195,10 @@ class GraphQLAuthorizationMiddleware:
 
     def _post_resolve(self, field_name: str, result, username: str):
         """Apply post-resolution filtering on GraphQL results."""
+        if field_name == "modelVersions":
+            # Runs can reference models with permissions independent of the experiment.
+            can_read = _role_based_read_predicate(username, "registered_model")
+            return [mv for mv in result if can_read(mv.name)]
         if field_name == "mlflowSearchModelVersions":
             return self._filter_model_versions_result(result, username)
         return result
diff --git a/tests/server/auth/test_client_workspace.py b/tests/server/auth/test_client_workspace.py
index f35fb1a..298aabf 100644
--- a/tests/server/auth/test_client_workspace.py
+++ b/tests/server/auth/test_client_workspace.py
@@ -343,3 +343,61 @@ def test_registered_model_access_controls_across_workspaces(workspace_setup, mon
     )
     assert resp.status_code == 403
     assert "Permission denied" in resp.text
+
+
+@pytest.mark.parametrize("search_runs", [False, True])
+def test_graphql_nested_model_versions_require_model_permission(workspace_setup, search_runs):
+    _, tracking_uri, workspace, username, password = workspace_setup
+    experiment_id = _create_experiment(tracking_uri, workspace)
+    run_id = _create_run(tracking_uri, workspace, experiment_id)
+    readable_model = f"readable-{random_str()}"
+    private_model = f"private-{random_str()}"
+    for model_name in (readable_model, private_model):
+        _create_registered_model(tracking_uri, workspace, model_name)
+        _create_model_version(tracking_uri, workspace, model_name, run_id)
+
+    grant_role_permission(
+        tracking_uri, username, "experiment", experiment_id, "READ", workspace=workspace
+    )
+    grant_role_permission(
+        tracking_uri, username, "registered_model", readable_model, "READ", workspace=workspace
+    )
+    if search_runs:
+        query = """
+        query($input: MlflowSearchRunsInput) {
+          mlflowSearchRuns(input: $input) {
+            runs { versions: modelVersions { name version source } }
+          }
+        }
+        """
+        input_data = {"experimentIds": [experiment_id]}
+    else:
+        query = """
+        query($input: MlflowGetRunInput) {
+          mlflowGetRun(input: $input) {
+            run { versions: modelVersions { name version source } }
+          }
+        }
+        """
+        input_data = {"runId": run_id}
+
+    for credentials, expected_models in (
+        ((ADMIN_USERNAME, ADMIN_PASSWORD), {readable_model, private_model}),
+        ((username, password), {readable_model}),
+    ):
+        response = requests.post(
+            f"{tracking_uri}/graphql",
+            json={"query": query, "variables": {"input": input_data}},
+            auth=credentials,
+            headers={WORKSPACE_HEADER_NAME: workspace},
+        )
+        response.raise_for_status()
+        payload = response.json()
+        assert not payload.get("errors")
+        runs = (
+            payload["data"]["mlflowSearchRuns"]["runs"]
+            if search_runs
+            else [payload["data"]["mlflowGetRun"]["run"]]
+        )
+        assert len(runs) == 1
+        assert {version["name"] for version in runs[0]["versions"]} == expected_models
