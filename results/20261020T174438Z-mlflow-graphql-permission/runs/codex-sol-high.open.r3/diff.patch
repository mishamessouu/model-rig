+@pytest.mark.parametrize("search_runs", [False, True])
+def test_graphql_run_model_versions_require_model_read_permission(workspace_setup, search_runs):
+    _, tracking_uri, workspace, username, password = workspace_setup
+    experiment_id = _create_experiment(tracking_uri, workspace)
+    run_id = _create_run(tracking_uri, workspace, experiment_id)
+    readable_model = f"readable-{random_str()}"
+    hidden_model = f"hidden-{random_str()}"
+    for name in (readable_model, hidden_model):
+        _create_registered_model(tracking_uri, workspace, name)
+        _create_model_version(tracking_uri, workspace, name, run_id)
+
+    grant_role_permission(
+        tracking_uri, username, "experiment", experiment_id, "READ", workspace=workspace
+    )
+    if search_runs:
+        query = """
+        query($input: MlflowSearchRunsInput) {
+          result: mlflowSearchRuns(input: $input) {
+            runs { versions: modelVersions { name version source } }
+          }
+        }
+        """
+        input_data = {"experimentIds": [experiment_id]}
+    else:
+        query = """
+        query($input: MlflowGetRunInput) {
+          result: mlflowGetRun(input: $input) {
+            run { versions: modelVersions { name version source } }
+          }
+        }
+        """
+        input_data = {"runId": run_id}
+
+    def get_model_names(credentials):
+        response = requests.post(
+            f"{tracking_uri}/graphql",
+            json={"query": query, "variables": {"input": input_data}},
+            auth=credentials,
+            headers={WORKSPACE_HEADER_NAME: workspace},
+        )
+        response.raise_for_status()
+        payload = response.json()
+        assert not payload.get("errors")
+        result = payload["data"]["result"]
+        run = result["runs"][0] if search_runs else result["run"]
+        return {version["name"] for version in run["versions"]}
+
+    assert get_model_names((username, password)) == set()
+
+    grant_role_permission(
+        tracking_uri, username, "registered_model", readable_model, "READ", workspace=workspace
+    )
+    assert get_model_names((username, password)) == {readable_model}
+    assert get_model_names((ADMIN_USERNAME, ADMIN_PASSWORD)) == {readable_model, hidden_model}
+
+
 def test_registered_model_access_controls_across_workspaces(workspace_setup, monkeypatch):
