+@pytest.mark.parametrize("operation", ["get_run", "search_runs_query", "search_runs_mutation"])
+@pytest.mark.parametrize("access", ["none", "read", "admin"])
+def test_graphql_run_model_versions_require_model_permission(
+    workspace_permission_setup, monkeypatch, operation, access
+):
+    store = workspace_permission_setup["store"]
+    username = workspace_permission_setup["username"]
+    _set_workspace_permission(store, username, NO_PERMISSIONS.name)
+    store.create_experiment_permission("exp-1", username, READ.name)
+    if access == "read":
+        store.create_registered_model_permission("readable-model", username, READ.name)
+        other_role = store.create_role("other-workspace-reader", workspace="team-b")
+        store.add_role_permission(other_role.id, "registered_model", "private-model", READ.name)
+        store.assign_role_to_user(store.get_user(username).id, other_role.id)
+    elif access == "admin":
+        store.update_user(username, is_admin=True)
+
+    run = Run(info=RunInfo(run_id="run-1", experiment_id="exp-1"))
+    monkeypatch.setattr(handlers, "get_run_impl", lambda _: GetRun.Response(run=run))
+    monkeypatch.setattr(handlers, "search_runs_impl", lambda _: SearchRuns.Response(runs=[run]))
+    search_versions = Mock(
+        return_value=SearchModelVersions.Response(model_versions=[
+            ModelVersion(name="readable-model", version="1"),
+            ModelVersion(name="private-model", version="1", description="private description"),
+        ])
+    )
+    monkeypatch.setattr(handlers, "search_model_versions_impl", search_versions)
+
+    if operation == "get_run":
+        query = """
+            query {
+                result: mlflowGetRun(input: {runId: "run-1"}) {
+                    run { ...Versions }
+                }
+            }
+        """
+    else:
+        operation_type = "mutation" if operation == "search_runs_mutation" else "query"
+        query = operation_type + """ {
+                result: mlflowSearchRuns(input: {experimentIds: ["exp-1"]}) {
+                    runs { ...Versions }
+                }
+            }
+        """
+    query += """
+        fragment Versions on MlflowRunExtension {
+            versions: modelVersions { name version description }
+        }
+    """
+
+    with auth_module.app.test_request_context("/graphql", method="POST"):
+        result = schema.execute(query, middleware=[auth_module.GraphQLAuthorizationMiddleware()])
+
+    assert result.errors is None
+    run_data = (
+        result.data["result"]["run"]
+        if operation == "get_run"
+        else result.data["result"]["runs"][0]
+    )
+    expected_names = {
+        "none": [],
+        "read": ["readable-model"],
+        "admin": ["readable-model", "private-model"],
+    }
+    assert [mv["name"] for mv in run_data["versions"]] == expected_names[access]
+    search_versions.assert_called_once()
+    assert search_versions.call_args.args[0].filter == "run_id='run-1'"
+
