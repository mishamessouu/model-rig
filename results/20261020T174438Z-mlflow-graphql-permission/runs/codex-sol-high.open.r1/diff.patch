+@pytest.mark.parametrize("operation", ["get_run", "search_runs", "search_model_versions"])
+@pytest.mark.parametrize(
+    ("access", "expected_names"),
+    [
+        ("none", []),
+        ("model", ["visible"]),
+        ("other_workspace", []),
+        ("workspace", ["visible", "hidden"]),
+        ("admin", ["visible", "hidden"]),
+    ],
+)
+def test_graphql_model_versions_authorization(
+    workspace_permission_setup, monkeypatch, operation, access, expected_names
+):
+    store = workspace_permission_setup["store"]
+    username = workspace_permission_setup["username"]
+    _set_workspace_permission(store, username, NO_PERMISSIONS.name)
+    store.grant_user_permission(username, "experiment", "exp-1", READ.name)
+    if access == "model":
+        store.grant_user_permission(username, "registered_model", "visible", READ.name)
+    elif access == "other_workspace":
+        with workspace_context.WorkspaceContext("team-b"):
+            store.grant_user_permission(username, "registered_model", "visible", READ.name)
+    elif access == "workspace":
+        _set_workspace_permission(store, username, MANAGE.name)
+    elif access == "admin":
+        store.update_user(username, is_admin=True)
+
+    run = Run(info=RunInfo(run_id="run-1", experiment_id="exp-1"))
+    monkeypatch.setattr(
+        "mlflow.server.handlers.get_run_impl", lambda request_message: GetRun.Response(run=run)
+    )
+    monkeypatch.setattr(
+        "mlflow.server.handlers.search_runs_impl",
+        lambda request_message: SearchRuns.Response(runs=[run]),
+    )
+    monkeypatch.setattr(
+        "mlflow.server.handlers.search_model_versions_impl",
+        lambda request_message: SearchModelVersions.Response(
+            model_versions=[
+                ModelVersion(name="visible", version="1"),
+                ModelVersion(name="hidden", version="1"),
+            ]
+        ),
+    )
+    if operation == "search_runs":
+        query = """
+            mutation {
+                mlflowSearchRuns(input: {experimentIds: ["exp-1"]}) {
+                    runs { versions: modelVersions { name } }
+                }
+            }
+        """
+    elif operation == "get_run":
+        query = """
+            query {
+                mlflowGetRun(input: {runId: "run-1"}) {
+                    run { versions: modelVersions { name } }
+                }
+            }
+        """
+    else:
+        query = """
+            query {
+                mlflowSearchModelVersions(input: {}) {
+                    versions: modelVersions { name }
+                }
+            }
+        """
+    result = schema.execute(query, middleware=[auth_module.GraphQLAuthorizationMiddleware()])
+    assert result.errors is None
+    if operation == "search_runs":
+        response = result.data["mlflowSearchRuns"]["runs"][0]
+    elif operation == "get_run":
+        response = result.data["mlflowGetRun"]["run"]
+    else:
+        response = result.data["mlflowSearchModelVersions"]
+    assert [version["name"] for version in response["versions"]] == expected_names
+
