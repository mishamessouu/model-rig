+@pytest.mark.parametrize("is_admin", [False, True])
+@pytest.mark.parametrize("workspaces_enabled", [False, True])
+def test_graphql_nested_model_versions_authorization(
+    workspace_permission_setup, monkeypatch, is_admin, workspaces_enabled
+):
+    store = workspace_permission_setup["store"]
+    username = workspace_permission_setup["username"]
+    monkeypatch.setenv(MLFLOW_ENABLE_WORKSPACES.name, str(workspaces_enabled).lower())
+    _set_workspace_permission(store, username, NO_PERMISSIONS.name)
+    workspace = "team-a" if workspaces_enabled else "default"
+    user = store.get_user(username)
+    role = store.create_role(name="reader", workspace=workspace)
+    store.add_role_permission(role.id, "experiment", "exp-1", READ.name)
+    store.add_role_permission(role.id, "registered_model", "visible-model", READ.name)
+    store.assign_role_to_user(user.id, role.id)
+    store.update_user(username, is_admin=is_admin)
+
+    monkeypatch.setattr(
+        "mlflow.server.handlers.get_run_impl",
+        lambda _: SimpleNamespace(run=SimpleNamespace(info=SimpleNamespace(run_id="run-1"))),
+    )
+    monkeypatch.setattr(
+        "mlflow.server.handlers.search_model_versions_impl",
+        lambda _: SimpleNamespace(
+            model_versions=[
+                SimpleNamespace(name="visible-model"),
+                SimpleNamespace(name="private-model"),
+            ]
+        ),
+    )
+    result = schema.execute(
+        '''{
+            mlflowGetRun(input: {runId: "run-1"}) {
+                run { linkedModels: modelVersions { name } }
+            }
+        }''',
+        middleware=[auth_module.GraphQLAuthorizationMiddleware()],
+    )
+    assert result.errors is None
+    expected = [{"name": "visible-model"}]
+    if is_admin:
+        expected.append({"name": "private-model"})
+    assert result.data["mlflowGetRun"]["run"]["linkedModels"] == expected
+
+
