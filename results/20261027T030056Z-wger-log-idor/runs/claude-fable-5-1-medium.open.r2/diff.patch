+    def test_post_foreign_slot_entry(self):
+        """
+        A user can not attach a log to a slot entry belonging to another user
+        """
+        self.authenticate(self.user_access)
+        foreign_entry = SlotEntry.objects.exclude(
+            slot__day__routine__user__username=self.user_access
+        ).first()
+        self.assertIsNotNone(foreign_entry)
+
+        data = dict(self.data, slot_entry=foreign_entry.pk)
+        response = self.client.post(self.url, data=data)
+        self.assertEqual(response.status_code, status.HTTP_403_FORBIDDEN)
+        self.assertFalse(WorkoutLog.objects.filter(slot_entry=foreign_entry).exists())
+
+        own_routine = Routine.objects.get(pk=self.data['routine'])
+        own_day = Day.objects.create(routine=own_routine, name='Day', order=1)
+        own_slot = Slot.objects.create(day=own_day, order=1)
+        own_entry = SlotEntry.objects.create(slot=own_slot, exercise_id=1, order=1)
+        data = dict(self.data, slot_entry=own_entry.pk)
+        response = self.client.post(self.url, data=data)
+        self.assertEqual(response.status_code, status.HTTP_201_CREATED)
