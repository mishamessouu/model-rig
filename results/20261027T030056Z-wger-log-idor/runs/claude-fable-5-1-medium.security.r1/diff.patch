+
+
+class WorkoutLogSlotEntryOwnershipTestCase(WgerTestCase):
+    """
+    A workout log must not be attached to a slot entry belonging to another
+    user's routine. The routine's progression logic reads every log linked to
+    its slot entries, so a foreign log would alter the owner's calculated
+    weights, repetitions and iteration requirements.
+    """
+
+    # Slot entry 1 belongs to routine 1, owned by user "admin" (pk 1)
+    FOREIGN_SLOT_ENTRY_PK = 1
+
+    def setUp(self):
+        super().setUp()
+        self.url = reverse('workoutlog-list')
+        self.data = {
+            'exercise': 1,
+            'routine': 3,
+            'slot_entry': self.FOREIGN_SLOT_ENTRY_PK,
+            'repetitions': 3,
+            'repetitions_unit': 1,
+            'weight_unit': 2,
+            'weight': 2,
+            'date': datetime.date.today(),
+        }
+
+    def test_cannot_create_log_for_foreign_slot_entry(self):
+        self.user_login('test')
+        count_before = WorkoutLog.objects.filter(slot_entry_id=self.FOREIGN_SLOT_ENTRY_PK).count()
+
+        response = self.client.post(self.url, self.data)
+
+        self.assertEqual(response.status_code, 403)
+        self.assertEqual(
+            WorkoutLog.objects.filter(slot_entry_id=self.FOREIGN_SLOT_ENTRY_PK).count(),
+            count_before,
+        )
+
+    def test_cannot_move_log_to_foreign_slot_entry(self):
+        self.user_login('test')
+        log = WorkoutLog.objects.filter(user__username='test').first()
+        self.assertIsNotNone(log)
+
+        response = self.client.patch(
+            reverse('workoutlog-detail', kwargs={'pk': log.pk}),
+            {'slot_entry': self.FOREIGN_SLOT_ENTRY_PK},
+            content_type='application/json',
+        )
+
+        self.assertEqual(response.status_code, 403)
+        log.refresh_from_db()
+        self.assertNotEqual(log.slot_entry_id, self.FOREIGN_SLOT_ENTRY_PK)
+
+    def test_owner_can_create_log_for_own_slot_entry(self):
+        self.user_login('admin')
+        self.data['routine'] = 1
+        response = self.client.post(self.url, self.data)
+        self.assertEqual(response.status_code, 201)
+        self.assertEqual(response.data['slot_entry'], self.FOREIGN_SLOT_ENTRY_PK)
