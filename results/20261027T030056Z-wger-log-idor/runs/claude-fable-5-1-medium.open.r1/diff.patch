+
+    def test_post_slot_entry_of_other_user(self):
+        """
+        A log cannot reference a slot entry that belongs to another user's routine
+        """
+        # Slot entry 1 belongs to a routine of user "admin", not "test"
+        self.authenticate(self.user_access)
+        data = dict(self.data, slot_entry=1)
+        response = self.client.post(self.url, data=data)
+        self.assertEqual(response.status_code, status.HTTP_403_FORBIDDEN)
+        self.assertFalse(WorkoutLog.objects.filter(user__username='test', slot_entry=1).exists())
+
+    def test_patch_slot_entry_of_other_user(self):
+        """
+        An existing log cannot be pointed at another user's slot entry
+        """
+        self.authenticate(self.user_access)
+        response = self.client.patch(self.url_detail, data={'slot_entry': 1})
+        self.assertEqual(response.status_code, status.HTTP_403_FORBIDDEN)
+        self.assertIsNone(WorkoutLog.objects.get(pk=self.pk).slot_entry_id)
