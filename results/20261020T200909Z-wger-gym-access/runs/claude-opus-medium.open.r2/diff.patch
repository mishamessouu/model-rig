+    def test_reset_password_blocked_for_gym_staff(self):
+        """
+        A gym manager must not reset the password of other staff in the same
+        gym (admin, general manager, fellow manager or trainer)
+        """
+        self.user_login('manager1')
+        for staff_pk in (1, 4, 10, 12):  # admin, trainer1, manager2, general_manager1
+            old_password_hash = User.objects.get(pk=staff_pk).password
+            response = self.client.post(
+                reverse('gym:gym:reset-user-password', kwargs={'user_pk': staff_pk})
+            )
+            self.assertEqual(response.status_code, 403)
+            self.assertEqual(User.objects.get(pk=staff_pk).password, old_password_hash)
+
     def test_permissions_edit_blocked_when_both_gyms_none(self):
         self._both_gyms_none(attacker_pk=9)
         self.user_login('manager1')
