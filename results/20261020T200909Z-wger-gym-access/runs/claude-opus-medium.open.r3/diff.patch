@@ -382,6 +382,24 @@ class GymScopeGuardsTestCase(WgerTestCase):
         self.assertEqual(response.status_code, 200)
         self.assertNotEqual(User.objects.get(pk=self.VICTIM_USER_PK).password, old_password_hash)
 
+    def test_reset_password_blocked_for_more_privileged_user(self):
+        """
+        A gym manager must not reset the password of a same-gym user with
+        more privileges (general manager or admin), as that would allow
+        taking over the account.
+        """
+        self.user_login('manager1')
+
+        for victim_pk in (1, 12):  # admin, general_manager1 (both in gym 1)
+            victim = User.objects.get(pk=victim_pk)
+            old_password_hash = victim.password
+
+            response = self.client.post(
+                reverse('gym:gym:reset-user-password', kwargs={'user_pk': victim_pk})
+            )
+            self.assertEqual(response.status_code, 403)
+            self.assertEqual(User.objects.get(pk=victim_pk).password, old_password_hash)
+
     def test_permissions_edit_blocked_when_both_gyms_none(self):
         self._both_gyms_none(attacker_pk=9)
         self.user_login('manager1')
