@@ -382,6 +382,36 @@ class GymScopeGuardsTestCase(WgerTestCase):
         self.assertEqual(response.status_code, 200)
         self.assertNotEqual(User.objects.get(pk=self.VICTIM_USER_PK).password, old_password_hash)
 
+    def test_reset_password_blocked_for_privileged_users(self):
+        """
+        A gym manager must not reset the password of superusers or other staff
+        in the same gym, neither when active nor when deactivated.
+        """
+        self.user_login('manager1')
+
+        # admin, trainer1, manager2, general_manager1
+        for victim_pk in (1, 4, 10, 12):
+            victim = User.objects.get(pk=victim_pk)
+            old_password_hash = victim.password
+            url = reverse('gym:gym:reset-user-password', kwargs={'user_pk': victim_pk})
+
+            for is_active in (True, False):
+                victim.is_active = is_active
+                victim.save()
+
+                self.assertEqual(self.client.get(url).status_code, 403)
+                self.assertEqual(self.client.post(url).status_code, 403)
+                self.assertEqual(User.objects.get(pk=victim_pk).password, old_password_hash)
+
+    def test_reset_password_general_manager_privileged_user(self):
+        """
+        General managers may still reset the password of other staff
+        """
+        self.user_login('general_manager1')
+
+        response = self.client.post(reverse('gym:gym:reset-user-password', kwargs={'user_pk': 9}))
+        self.assertEqual(response.status_code, 200)
+
     def test_permissions_edit_blocked_when_both_gyms_none(self):
         self._both_gyms_none(attacker_pk=9)
         self.user_login('manager1')
