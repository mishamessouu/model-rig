+    @staticmethod
+    def _extra_watch_config_path(data_dir, filename):
+        """
+        Resolve a processor config filename inside the watch data directory.
+
+        The filename is usually derived from the watch's 'processor' value, which can come from
+        imported/restored data, so refuse anything that is not a plain file name in data_dir.
+
+        Returns:
+            str: Absolute path to the file, or None if the filename is unsafe
+        """
+        import os
+
+        if not filename or not isinstance(filename, str) or os.path.basename(filename) != filename or filename.startswith('.'):
+            return None
+
+        base = os.path.realpath(data_dir)
+        filepath = os.path.realpath(os.path.join(base, filename))
+        if os.path.dirname(filepath) != base:
+            return None
+
+        return filepath
+
