@@ -0,0 +1,15 @@
+#!/usr/bin/env python3
+import os
+
+from changedetectionio.processors.base import difference_detection_processor
+
+
+def test_extra_watch_config_path_stays_in_data_dir(tmp_path):
+    data_dir = str(tmp_path / "watch-uuid")
+    os.makedirs(data_dir)
+    resolve = difference_detection_processor._extra_watch_config_path
+
+    assert resolve(data_dir, "text_json_diff.json") == os.path.join(os.path.realpath(data_dir), "text_json_diff.json")
+
+    for bad in ("../url-watches.json", "../../../tmp/pwn.json", "/etc/passwd.json", "sub/x.json", "..", ".", ""):
+        assert resolve(data_dir, bad) is None, bad
