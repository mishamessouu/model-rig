+        """
+        Resolve `filename` inside `data_dir`, refusing anything that could escape it.
+
+        The filename is usually derived from the watch's `processor` name, so a
+        malformed or hostile value (e.g. "../../etc/foo") must never turn into a
+        read or write outside the watch's own data directory.
+
+        Returns:
+            str: Absolute path inside data_dir, or None if the name is unsafe.
+        """
+        import os
+
+        if not filename or not isinstance(filename, str):
+            return None
+
+        # Must be a bare filename - no directory components of any kind
+        if filename in ('.', '..') or os.path.basename(filename) != filename:
+            return None
+
+        base = os.path.realpath(data_dir)
+        filepath = os.path.realpath(os.path.join(base, filename))
+        if os.path.dirname(filepath) != base:
+            return None
+
+        return filepath
