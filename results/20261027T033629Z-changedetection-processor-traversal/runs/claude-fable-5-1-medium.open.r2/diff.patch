@@ -0,0 +1,75 @@
+#!/usr/bin/env python3
+"""
+Processor extra-config files are named after the watch's `processor` value and
+live in the watch's data directory. These tests make sure that name can never be
+used to read or write outside that directory.
+
+Run: cd changedetectionio && python3 -m pytest tests/unit/test_extra_watch_config_path.py
+"""
+import json
+import os
+import unittest
+import tempfile
+import shutil
+
+from changedetectionio.processors.base import difference_detection_processor
+
+
+class _FakeWatch(dict):
+    def __init__(self, data_dir):
+        super().__init__()
+        self.data_dir = data_dir
+
+    def ensure_data_dir_exists(self):
+        os.makedirs(self.data_dir, exist_ok=True)
+
+
+class _FakeDatastore:
+    def __init__(self, watch):
+        self.data = {'watching': {'uuid-1': watch}, 'settings': {}}
+
+
+class TestExtraWatchConfigPath(unittest.TestCase):
+    def setUp(self):
+        self.root = tempfile.mkdtemp()
+        self.data_dir = os.path.join(self.root, 'watch-data')
+        os.makedirs(self.data_dir)
+        self.watch = _FakeWatch(self.data_dir)
+        self.datastore = _FakeDatastore(self.watch)
+        self.processor = difference_detection_processor(self.datastore, 'uuid-1')
+
+    def tearDown(self):
+        shutil.rmtree(self.root, ignore_errors=True)
+
+    def test_round_trip_with_plain_filename(self):
+        self.processor.update_extra_watch_config('text_json_diff.json', {'a': 1})
+        self.assertTrue(os.path.isfile(os.path.join(self.data_dir, 'text_json_diff.json')))
+        self.assertEqual(self.processor.get_extra_watch_config('text_json_diff.json'), {'a': 1})
+
+    def test_write_refuses_to_escape_data_dir(self):
+        for bad in ('../escaped.json', '../../escaped.json', '/tmp/escaped.json',
+                    'sub/escaped.json', '..', '.', '', None):
+            with self.subTest(filename=bad):
+                self.processor.update_extra_watch_config(bad, {'pwned': True})
+
+        # Nothing was created anywhere outside/inside except the data dir itself
+        self.assertFalse(os.path.exists(os.path.join(self.root, 'escaped.json')))
+        self.assertFalse(os.path.exists('/tmp/escaped.json'))
+        self.assertEqual(os.listdir(self.data_dir), [])
+
+    def test_read_refuses_to_escape_data_dir(self):
+        secret = os.path.join(self.root, 'secret.json')
+        with open(secret, 'w') as f:
+            json.dump({'secret': 'yes'}, f)
+
+        self.assertEqual(self.processor.get_extra_watch_config('../secret.json'), {})
+        self.assertEqual(self.processor.get_extra_watch_config(secret), {})
+
+    def test_helper_resolves_inside_data_dir(self):
+        p = difference_detection_processor._safe_extra_config_path(self.data_dir, 'restock_diff.json')
+        self.assertEqual(p, os.path.join(os.path.realpath(self.data_dir), 'restock_diff.json'))
+        self.assertIsNone(difference_detection_processor._safe_extra_config_path(self.data_dir, '../x.json'))
+
+
+if __name__ == '__main__':
+    unittest.main()
