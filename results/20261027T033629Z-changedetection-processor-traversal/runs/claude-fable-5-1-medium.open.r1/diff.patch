diff --git a/changedetectionio/tests/unit/test_processor_name_validation.py b/changedetectionio/tests/unit/test_processor_name_validation.py
new file mode 100644
index 0000000..deb23a7
--- /dev/null
+++ b/changedetectionio/tests/unit/test_processor_name_validation.py
@@ -0,0 +1,64 @@
+"""
+The watch 'processor' value is used as a filename ('{processor}.json' inside the watch
+data directory) and as a module lookup key. Make sure an attacker-controlled value such as
+'../../something' can never reach the filesystem, neither via add_watch nor via the
+extra-config read/write helpers directly.
+"""
+import json
+import os
+import tempfile
+
+from changedetectionio.processors.base import _is_safe_config_filename, difference_detection_processor
+
+
+def test_unsafe_config_filenames_are_rejected():
+    for bad in ['../x.json', '../../etc/passwd', '/etc/passwd', 'a/b.json', 'a\\b.json', '..', '.', '', None]:
+        assert not _is_safe_config_filename(bad), bad
+    for good in ['text_json_diff.json', 'restock_diff.json', 'my-plugin_1.json']:
+        assert _is_safe_config_filename(good), good
+
+
+def test_add_watch_rejects_unknown_processor_name():
+    from changedetectionio import store
+
+    with tempfile.TemporaryDirectory() as datastore_path:
+        datastore = store.ChangeDetectionStore(datastore_path=datastore_path, include_default_watches=False)
+        try:
+            # Path traversal style and simply unknown processor names must both be refused
+            for bad in ['../../evil', '../text_json_diff', 'does_not_exist']:
+                assert datastore.add_watch(url='https://example.com/x', extras={'processor': bad}) is None, bad
+            assert len(datastore.data['watching']) == 0
+
+            # A real processor is still accepted
+            uuid = datastore.add_watch(url='https://example.com/x', extras={'processor': 'text_json_diff'})
+            assert uuid
+            assert datastore.data['watching'][uuid]['processor'] == 'text_json_diff'
+        finally:
+            datastore.stop_thread = True
+
+
+def test_extra_watch_config_never_escapes_watch_data_dir():
+    from changedetectionio import store
+
+    with tempfile.TemporaryDirectory() as datastore_path:
+        datastore = store.ChangeDetectionStore(datastore_path=datastore_path, include_default_watches=False)
+        try:
+            uuid = datastore.add_watch(url='https://example.com/x')
+            watch = datastore.data['watching'][uuid]
+            processor = difference_detection_processor(datastore, uuid)
+
+            escaped = os.path.join(datastore_path, 'escaped.json')
+            processor.update_extra_watch_config('../escaped.json', {'a': 1})
+            assert not os.path.exists(escaped)
+
+            # A valid name still round-trips inside the watch dir
+            processor.update_extra_watch_config('text_json_diff.json', {'a': 1})
+            assert os.path.isfile(os.path.join(watch.data_dir, 'text_json_diff.json'))
+            assert processor.get_extra_watch_config('text_json_diff.json') == {'a': 1}
+
+            # Reading via a traversal name returns nothing, even if the target exists
+            with open(escaped, 'w') as f:
+                json.dump({'secret': True}, f)
+            assert processor.get_extra_watch_config('../escaped.json') == {}
+        finally:
+            datastore.stop_thread = True
