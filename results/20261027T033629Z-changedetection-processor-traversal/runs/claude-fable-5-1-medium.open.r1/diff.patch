+def _is_safe_config_filename(filename):
+    """
+    Extra watch config files must live directly inside the watch data directory.
+    Reject anything that could escape it (path separators, '..', absolute paths).
+    """
+    import os
+    if not filename or not isinstance(filename, str):
+        return False
+    if filename in ('.', '..') or os.path.isabs(filename):
+        return False
+    if os.path.basename(filename) != filename or '/' in filename or '\\' in filename:
+        return False
+    return True
+
