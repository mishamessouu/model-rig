         # After init, call run_changedetection() which will do the actual change-detection
 
+    @staticmethod
+    def _safe_extra_watch_config_path(data_dir, filename):
+        """
+        Build the path for a processor config file, confined to the watch's data directory.
+
+        The filename is often derived from the watch's ``processor`` value, which may come from
+        user input (import form, shared-watch JSON, stored data), so it must be treated as
+        untrusted. Returns None if the filename is not a plain file name inside data_dir.
+        """
+        import os
+
+        if not filename or not isinstance(filename, str):
+            return None
+
+        # Must be a single path component, no separators, no traversal, no hidden/special names
+        if filename in ('.', '..') or os.path.basename(filename) != filename:
+            return None
+        if '/' in filename or '\\' in filename or '\x00' in filename:
+            return None
+
+        base_dir = os.path.realpath(data_dir)
+        filepath = os.path.realpath(os.path.join(base_dir, filename))
+        if os.path.dirname(filepath) != base_dir:
+            return None
+
+        return filepath
+
