+#!/usr/bin/env python3
+"""
+The watch 'processor' name is used to build on-disk filenames (history-{processor}.txt).
+It arrives unvalidated from the shared-link metadata fetch and the UI import form, so
+add_watch() must reject anything that is not an installed processor.
+
+Run from the tests/ directory:
+    python -m unittest unit/test_add_watch_processor_validation.py
+"""
+import os
+import shutil
+import tempfile
+import time
+import unittest
+
+from changedetectionio.store import ChangeDetectionStore
+
+
+class TestAddWatchProcessorValidation(unittest.TestCase):
+    def setUp(self):
+        self.test_datastore_path = tempfile.mkdtemp()
+        self.store = ChangeDetectionStore(
+            datastore_path=self.test_datastore_path,
+            include_default_watches=False,
+        )
+
+    def tearDown(self):
+        self.store.stop_thread = True
+        time.sleep(0.5)
+        shutil.rmtree(self.test_datastore_path, ignore_errors=True)
+
+    def test_traversal_processor_name_is_rejected(self):
+        for bad in ['../../../../tmp/evil', 'nope', '', 123, 'text_json_diff/../../x']:
+            with self.subTest(processor=bad):
+                uuid = self.store.add_watch(url='https://example.com', extras={'processor': bad})
+                self.assertIsNone(uuid)
+        self.assertEqual(len(self.store.data['watching']), 0)
+
+    def test_installed_processor_is_accepted(self):
+        uuid = self.store.add_watch(url='https://example.com', extras={'processor': 'restock_diff'})
+        self.assertIsNotNone(uuid)
+        watch = self.store.data['watching'][uuid]
+        self.assertEqual(watch.get('processor'), 'restock_diff')
+        self.assertEqual(os.path.basename(watch.history_index_filename), 'history-restock_diff.txt')
+
+    def test_missing_processor_falls_back_to_default(self):
+        uuid = self.store.add_watch(url='https://example.com')
+        self.assertIsNotNone(uuid)
+        self.assertEqual(self.store.data['watching'][uuid].get('processor'), 'text_json_diff')
+
+
+if __name__ == '__main__':
+    unittest.main()
