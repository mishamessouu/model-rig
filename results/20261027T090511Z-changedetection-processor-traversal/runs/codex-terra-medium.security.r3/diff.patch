@@ -0,0 +1,17 @@
+import pytest
+
+from changedetectionio.processors.base import difference_detection_processor
+
+
+def test_processor_config_stays_in_watch_directory(tmp_path):
+    processor = object.__new__(difference_detection_processor)
+    watch_dir = tmp_path / 'watch'
+    watch_dir.mkdir()
+    outside = tmp_path / 'outside.json'
+    outside.write_text('{}')
+    (watch_dir / 'link.json').symlink_to(outside)
+
+    assert processor._extra_watch_config_path(str(watch_dir), 'restock_diff.json') == str(watch_dir / 'restock_diff.json')
+    for filename in ('../outside.json', str(outside), 'link.json'):
+        with pytest.raises(ValueError):
+            processor._extra_watch_config_path(str(watch_dir), filename)
