+def _extra_watch_config_path(data_dir, filename):
+    """Keep processor configuration files inside the watch directory."""
+    if (not isinstance(filename, str) or not filename or filename in ('.', '..')
+            or '/' in filename or '\\' in filename):
+        raise ValueError('Invalid processor config filename')
+    directory = os.path.realpath(data_dir)
+    path = os.path.realpath(os.path.join(directory, filename))
+    if os.path.dirname(path) != directory:
+        raise ValueError('Processor config path escapes watch directory')
+    return path
