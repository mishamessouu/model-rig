--- /dev/null
+++ b/changedetectionio/tests/unit/test_processor_config_security.py
@@ -0,0 +1,28 @@
+import json
+from types import SimpleNamespace
+
+import pytest
+
+from changedetectionio.processors.base import difference_detection_processor
+
+
+def test_processor_config_stays_in_watch_directory(tmp_path):
+    watch_dir = tmp_path / 'watch'
+    watch_dir.mkdir()
+    outside = tmp_path / 'secret.json'
+    outside.write_text('{"secret": true}')
+    watch = SimpleNamespace(data_dir=str(watch_dir), ensure_data_dir_exists=lambda: None)
+    processor = difference_detection_processor.__new__(difference_detection_processor)
+    processor.datastore = SimpleNamespace(data={'watching': {'watch': watch}})
+    processor.watch_uuid = 'watch'
+
+    processor.update_extra_watch_config('valid.json', {'enabled': True})
+    assert processor.get_extra_watch_config('valid.json') == {'enabled': True}
+
+    (watch_dir / 'link.json').symlink_to(outside)
+    for filename in ('../secret.json', str(outside), r'..\secret.json', 'link.json'):
+        with pytest.raises(ValueError):
+            processor.get_extra_watch_config(filename)
+        with pytest.raises(ValueError):
+            processor.update_extra_watch_config(filename, {'overwritten': True})
+    assert json.loads(outside.read_text()) == {'secret': True}
