+def _extra_watch_config_path(data_dir, filename):
+    """Keep processor configuration files inside the watch directory."""
+    if not isinstance(filename, str) or filename in ('', '.', '..') or os.path.basename(filename) != filename:
+        raise ValueError('Invalid processor configuration filename')
+    path = os.path.join(data_dir, filename)
+    if os.path.commonpath((os.path.realpath(data_dir), os.path.realpath(path))) != os.path.realpath(data_dir):
+        raise ValueError('Processor configuration path escapes watch directory')
+    return path
