@@ -0,0 +1,25 @@
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import pytest
+
+from changedetectionio import processors
+
+
+@pytest.mark.parametrize("error, expected_missing", [
+    (ModuleNotFoundError(name="example.difference"), True),
+    (ModuleNotFoundError(name="missing_dependency"), False),
+    (ImportError("cannot import name from dependency"), False),
+])
+def test_optional_processor_submodule_only_ignores_its_own_absence(error, expected_missing):
+    processor = SimpleNamespace(__name__="example.processor")
+    parent = SimpleNamespace(__name__="example")
+    with patch.object(processors, "find_processors", return_value=[(processor, "example")]), \
+         patch.object(processors, "get_parent_module", return_value=parent), \
+         patch.object(processors.importlib, "import_module", side_effect=error):
+        if expected_missing:
+            assert processors.get_processor_submodule("example", "difference") is None
+        else:
+            with pytest.raises(type(error)) as exc:
+                processors.get_processor_submodule("example", "difference")
+            assert exc.value is error
