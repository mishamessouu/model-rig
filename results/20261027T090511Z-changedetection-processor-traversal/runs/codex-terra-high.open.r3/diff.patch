@@ -0,0 +1,27 @@
+from types import SimpleNamespace
+
+import pytest
+
+from changedetectionio.processors.base import difference_detection_processor
+
+
+def test_processor_config_is_confined_to_watch_directory(tmp_path):
+    watch_dir = tmp_path / 'watch'
+    watch_dir.mkdir()
+    outside = tmp_path / 'outside.json'
+    outside.write_text('{"secret": true}')
+    watch = SimpleNamespace(data_dir=str(watch_dir), ensure_data_dir_exists=lambda: None)
+    processor = object.__new__(difference_detection_processor)
+    processor.datastore = SimpleNamespace(data={'watching': {'watch': watch}})
+    processor.watch_uuid = 'watch'
+
+    processor.update_extra_watch_config('valid.json', {'enabled': True})
+    assert processor.get_extra_watch_config('valid.json') == {'enabled': True}
+
+    (watch_dir / 'link.json').symlink_to(outside)
+    for filename in ('../outside.json', str(outside), 'link.json'):
+        with pytest.raises(ValueError):
+            processor.get_extra_watch_config(filename)
+        with pytest.raises(ValueError):
+            processor.update_extra_watch_config(filename, {'changed': True})
+    assert outside.read_text() == '{"secret": true}'
