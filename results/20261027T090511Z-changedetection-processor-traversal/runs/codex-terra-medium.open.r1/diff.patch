@@ -0,0 +1,24 @@
+from types import SimpleNamespace
+
+import pytest
+
+from changedetectionio import processors
+from changedetectionio.processors import base
+
+
+@pytest.mark.parametrize('name', ['../../outside', '/tmp/outside', r'..\outside', '', None])
+def test_processor_config_rejects_unsafe_names(monkeypatch, name):
+    datastore = SimpleNamespace(data={'watching': {'watch': {'processor': name}}})
+    monkeypatch.setattr(base, 'difference_detection_processor', lambda *args: pytest.fail('unexpected write'))
+
+    assert processors.save_processor_config(datastore, 'watch', {'enabled': True}) is False
+
+
+def test_processor_config_accepts_plugin_name(monkeypatch):
+    datastore = SimpleNamespace(data={'watching': {'watch': {'processor': 'my-plugin'}}})
+    writes = []
+    instance = SimpleNamespace(update_extra_watch_config=lambda filename, data: writes.append((filename, data)))
+    monkeypatch.setattr(base, 'difference_detection_processor', lambda *args: instance)
+
+    assert processors.save_processor_config(datastore, 'watch', {'enabled': True}) is True
+    assert writes == [('my-plugin.json', {'enabled': True})]
