--- /dev/null
+++ b/changedetectionio/tests/unit/test_processor_config_paths.py
@@ -0,0 +1,26 @@
+import json
+from types import SimpleNamespace
+
+import pytest
+
+from changedetectionio.processors.base import difference_detection_processor
+
+
+def test_processor_config_stays_in_watch_directory(tmp_path):
+    watch_dir = tmp_path / 'watch'
+    watch_dir.mkdir()
+    outside = tmp_path / 'outside.json'
+    outside.write_text('{"secret": true}', encoding='utf-8')
+    watch = SimpleNamespace(data_dir=str(watch_dir), ensure_data_dir_exists=lambda: None)
+    processor = difference_detection_processor(SimpleNamespace(data={'watching': {'id': watch}}), 'id')
+
+    processor.update_extra_watch_config('restock_diff.json', {'enabled': True})
+    assert processor.get_extra_watch_config('restock_diff.json') == {'enabled': True}
+
+    (watch_dir / 'link.json').symlink_to(outside)
+    for filename in ('../outside.json', str(outside), 'link.json'):
+        with pytest.raises(ValueError):
+            processor.get_extra_watch_config(filename)
+        with pytest.raises(ValueError):
+            processor.update_extra_watch_config(filename, {'overwritten': True})
+    assert json.loads(outside.read_text(encoding='utf-8')) == {'secret': True}
