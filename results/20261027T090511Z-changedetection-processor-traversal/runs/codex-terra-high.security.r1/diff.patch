+def _extra_watch_config_path(data_dir, filename):
+    """Resolve a config filename only within its watch directory."""
+    if not isinstance(filename, str) or not filename or os.path.basename(filename) != filename:
+        raise ValueError('Invalid processor config filename')
+    directory = os.path.realpath(data_dir)
+    path = os.path.realpath(os.path.join(directory, filename))
+    if os.path.dirname(path) != directory:
+        raise ValueError('Processor config must be inside the watch directory')
+    return path
