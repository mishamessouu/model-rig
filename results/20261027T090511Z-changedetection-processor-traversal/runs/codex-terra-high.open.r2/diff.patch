+++ b/changedetectionio/tests/unit/test_processor_config_path.py
@@ -0,0 +1,42 @@
+from types import SimpleNamespace
+
+import pytest
+
+from changedetectionio.processors.base import difference_detection_processor
+
+
+@pytest.fixture
+def processor(tmp_path):
+    watch_dir = tmp_path / 'watch'
+    watch_dir.mkdir()
+    watch = SimpleNamespace(data_dir=str(watch_dir), ensure_data_dir_exists=lambda: None)
+    instance = difference_detection_processor.__new__(difference_detection_processor)
+    instance.watch_uuid = 'watch'
+    instance.datastore = SimpleNamespace(data={'watching': {'watch': watch}})
+    return instance
+
+
+def test_config_read_and_merge(processor):
+    processor.update_extra_watch_config('restock_diff.json', {'first': 1})
+    processor.update_extra_watch_config('restock_diff.json', {'second': 2})
+    assert processor.get_extra_watch_config('restock_diff.json') == {'first': 1, 'second': 2}
+
+
+@pytest.mark.parametrize('filename', ['../outside.json', '/tmp/outside.json', '..\\outside.json'])
+def test_config_rejects_paths_outside_watch(processor, tmp_path, filename):
+    outside = tmp_path / 'outside.json'
+    outside.write_text('{"secret": true}')
+    assert processor.get_extra_watch_config(filename) == {}
+    with pytest.raises(ValueError):
+        processor.update_extra_watch_config(filename, {'changed': True})
+    assert outside.read_text() == '{"secret": true}'
+
+
+def test_config_rejects_symlink_outside_watch(processor, tmp_path):
+    outside = tmp_path / 'outside.json'
+    outside.write_text('{"secret": true}')
+    (tmp_path / 'watch' / 'config.json').symlink_to(outside)
+    assert processor.get_extra_watch_config('config.json') == {}
+    with pytest.raises(ValueError):
+        processor.update_extra_watch_config('config.json', {'changed': True})
+    assert outside.read_text() == '{"secret": true}'
