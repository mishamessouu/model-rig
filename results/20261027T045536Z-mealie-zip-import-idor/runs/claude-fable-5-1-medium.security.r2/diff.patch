+def test_create_recipe_from_zip_cannot_claim_other_groups_children(
+    api_client: TestClient, unique_user: TestUser, g2_user: TestUser, tempdir: str
+):
+    """Ids in an uploaded zip must not resolve to tools or comments owned by another group."""
+    victim_slug = api_client.post(api_routes.recipes, json={"name": random_string()}, headers=g2_user.token).json()
+    victim = api_client.get(api_routes.recipes_slug(victim_slug), headers=g2_user.token).json()
+    victim_tool = api_client.post(api_routes.organizers_tools, json={"name": random_string()}, headers=g2_user.token)
+    assert victim_tool.status_code == 201
+    victim_tool = victim_tool.json()
+    victim_comment = api_client.post(
+        api_routes.comments, json={"recipeId": victim["id"], "text": random_string()}, headers=g2_user.token
+    )
+    assert victim_comment.status_code == 201
+    victim_comment = victim_comment.json()
+
+    recipe_name = random_string()
+    recipe = Recipe(
+        id=uuid4(),
+        user_id=unique_user.user_id,
+        group_id=unique_user.group_id,
+        name=recipe_name,
+        slug=recipe_name,
+        tools=[{"id": victim_tool["id"], "name": "hijacked", "slug": "hijacked"}],
+        comments=[{**victim_comment, "text": "hijacked"}],
+    )
+
+    r = api_client.post(api_routes.recipes_create_zip, files=zip_recipe(tempdir, recipe), headers=unique_user.token)
+    assert r.status_code == 201
+
+    imported = api_client.get(api_routes.recipes_slug(r.json()), headers=unique_user.token).json()
+    assert imported["comments"] == []
+    assert all(tool["id"] != victim_tool["id"] for tool in imported["tools"])
+
+    tool_after = api_client.get(f"{api_routes.organizers_tools}/{victim_tool['id']}", headers=g2_user.token)
+    assert tool_after.status_code == 200
+    assert tool_after.json()["name"] == victim_tool["name"]
+
+    victim_after = api_client.get(api_routes.recipes_slug(victim_slug), headers=g2_user.token).json()
+    assert [c["id"] for c in victim_after["comments"]] == [victim_comment["id"]]
+    assert victim_after["comments"][0]["text"] == victim_comment["text"]
