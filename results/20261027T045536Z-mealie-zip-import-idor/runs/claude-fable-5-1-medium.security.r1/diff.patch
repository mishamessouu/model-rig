+    def _transform_tool(self, data: dict[str, Any] | Any) -> dict[str, Any] | None:
+        """Resolve an imported tool against this group, creating it if necessary.
+
+        Like tags and categories, tools are matched by slug within the current group only. The id carried by
+        the export is never trusted: tools are linked by id in the recipe model without a group filter, so an
+        id pointing at another group's tool would both attach it to this recipe and overwrite that tool's data.
+        """
+        if not isinstance(data, dict):
+            return None
+
+        name = self._non_empty_str(data.get("name"))
+        if not name:
+            return None
+
+        slug = self._non_empty_str(data.get("slug")) or slugify(name)
+
+        existing_tool = self.repos.tools.get_one(slug, "slug")
+        if existing_tool:
+            return existing_tool.model_dump()
+
+        new_tool = self.repos.tools.create({"name": name, "slug": slug, "group_id": self.user.group_id})
+        return new_tool.model_dump()
+
