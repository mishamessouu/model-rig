+    def _transform_organizer(self, data: dict[str, Any] | Any, repo: RepositoryGeneric) -> dict[str, Any] | None:
+        """Resolve an imported category, tag or tool to one that belongs to the current group.
+
+        The exported item is matched on slug within the group-scoped repo and created there when
+        missing. The imported id is never kept: the ORM later resolves many-to-many members by id
+        without a group filter and overwrites whatever row it finds, so a foreign id would let an
+        import rename and re-home another group's organizer.
+        """
+        if not isinstance(data, dict):
+            return None
+
