+@pytest.mark.parametrize(
+    ["field", "schema", "repo_name", "item_route"],
+    [
+        ("recipe_category", RecipeCategory, "categories", api_routes.organizers_categories_item_id),
+        ("tags", RecipeTag, "tags", api_routes.organizers_tags_item_id),
+        ("tools", RecipeTool, "tools", api_routes.organizers_tools_item_id),
+    ],
+    ids=["category", "tag", "tool"],
+)
+def test_create_recipe_from_zip_cannot_hijack_other_groups_organizer(
+    api_client: TestClient,
+    unique_user: TestUser,
+    g2_user: TestUser,
+    tempdir: str,
+    field: str,
+    schema: type,
+    repo_name: str,
+    item_route,
+):
+    """An imported organizer carrying another group's id must not touch that group's row."""
+    victim_name = random_string()
+    victim = getattr(g2_user.repos, repo_name).create({"name": victim_name, "group_id": g2_user.group_id})
+
+    recipe_name = random_string()
+    hijacked_name = random_string()
+    recipe = RecipeSummary(
+        id=uuid4(),
+        user_id=unique_user.user_id,
+        group_id=unique_user.group_id,
+        name=recipe_name,
+        slug=recipe_name,
+        **{field: [schema(id=victim.id, name=hijacked_name, slug=slugify(hijacked_name))]},
+    )
+    r = api_client.post(api_routes.recipes_create_zip, files=zip_recipe(tempdir, recipe), headers=unique_user.token)
+    assert r.status_code == 201
+
+    # the victim's organizer is unchanged and still in its own group
+    r = api_client.get(item_route(victim.id), headers=g2_user.token)
+    assert r.status_code == 200
+    assert r.json()["name"] == victim_name
+    assert api_client.get(item_route(victim.id), headers=unique_user.token).status_code == 404
+    assert getattr(unique_user.repos, repo_name).get_one(victim.id) is None
+
+    # the importer gets a fresh organizer in their own group instead
+    imported = api_client.get(api_routes.recipes_slug(recipe_name), headers=unique_user.token).json()
+    imported_items = imported["recipeCategory" if field == "recipe_category" else field]
+    assert len(imported_items) == 1
+    assert imported_items[0]["id"] != str(victim.id)
+    assert imported_items[0]["name"] == hijacked_name
+    assert getattr(unique_user.repos, repo_name).get_one(imported_items[0]["id"]) is not None
+
+
