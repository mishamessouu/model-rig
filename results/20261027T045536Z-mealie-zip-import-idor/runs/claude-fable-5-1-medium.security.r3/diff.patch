+    def _transform_tool(self, data: dict[str, Any] | Any) -> dict[str, Any] | None:
+        """Resolve an imported tool to one in the current group, creating it if necessary.
+
+        Tools are a many-to-many relationship, so without this the ORM would look the exported id up
+        across every group and then overwrite that row with the imported values. An id is only honored
+        when it belongs to this group; otherwise the tool is matched by slug or created fresh.
+        """
+        if not isinstance(data, dict):
+            return None
+
+        tool_id = data.get("id")
+        if tool_id:
+            try:
+                tool_id = UUID(str(tool_id))
+            except ValueError:
+                tool_id = None
+
+        if tool_id and (existing_tool := self.repos.tools.get_one(tool_id)):
+            return existing_tool.model_dump()
+
+        name = self._non_empty_str(data.get("name"))
+        if not name:
+            return None
+
+        existing_tool = self.repos.tools.get_one(slugify(name), "slug")
+        if existing_tool:
+            return existing_tool.model_dump()
+
+        new_tool = self.repos.tools.create(RecipeToolSave(name=name, group_id=self.user.group_id))
+        return new_tool.model_dump()
+
