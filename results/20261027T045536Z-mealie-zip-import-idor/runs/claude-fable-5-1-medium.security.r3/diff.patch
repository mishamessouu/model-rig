+def test_create_recipe_from_zip_does_not_touch_other_groups_tool(
+    api_client: TestClient, unique_user: TestUser, g2_user: TestUser, tempdir: str
+):
+    """A zip naming another group's tool id must not link to or modify that tool."""
+    other_name = random_string()
+    other_tool = api_client.post(api_routes.organizers_tools, json={"name": other_name}, headers=g2_user.token).json()
+
+    recipe_name = random_string()
+    recipe = RecipeSummary(
+        id=uuid4(),
+        user_id=unique_user.user_id,
+        group_id=unique_user.group_id,
+        household_id=unique_user.household_id,
+        name=recipe_name,
+        slug=recipe_name,
+        tools=[{"id": other_tool["id"], "name": "hijacked", "slug": "hijacked", "group_id": other_tool["groupId"]}],
+    )
+    r = api_client.post(api_routes.recipes_create_zip, files=zip_recipe(tempdir, recipe), headers=unique_user.token)
+    assert r.status_code == 201
+
+    imported = api_client.get(api_routes.recipes_slug(r.json()), headers=unique_user.token).json()
+    assert [t["name"] for t in imported["tools"]] == ["hijacked"]
+    assert all(t["id"] != other_tool["id"] for t in imported["tools"])
+    assert all(t["groupId"] == str(unique_user.group_id) for t in imported["tools"])
+
+    untouched = api_client.get(api_routes.organizers_tools_item_id(other_tool["id"]), headers=g2_user.token).json()
+    assert untouched["name"] == other_name
+    assert untouched["groupId"] == other_tool["groupId"]
