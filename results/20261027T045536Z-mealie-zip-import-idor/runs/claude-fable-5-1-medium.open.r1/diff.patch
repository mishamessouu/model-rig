+    def _transform_tool(self, data: dict[str, Any] | Any) -> dict[str, Any] | None:
+        """Resolve a tool from the export to a tool in this group, creating it if necessary.
+
+        The exported id must never be used to look the tool up: tools are only unique per group, and
+        the model auto-init resolves relationships by primary key across every group, so an id that
+        happens to belong to another group's tool would link to -- and overwrite -- that tool.
+        """
+        if not isinstance(data, dict):
+            return None
+
+        name = self._non_empty_str(data.get("name"))
+        if not name:
+            return None
+
+        slug = self._non_empty_str(data.get("slug")) or slugify(name)
+        existing_tool = self.repos.tools.get_one(slug, "slug")
+        if existing_tool:
+            return existing_tool.model_dump()
+
+        # households are per-instance, so the exported household slugs are dropped
+        new_tool = self.repos.tools.create(RecipeToolSave(name=name, group_id=self.user.group_id))
+        return new_tool.model_dump()
+
