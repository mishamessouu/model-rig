+def test_create_recipe_from_zip_does_not_touch_other_groups_tools(
+    api_client: TestClient, unique_user: TestUser, g2_user: TestUser, tempdir: str
+):
+    """A zip whose tool carries another group's tool id must not link to or modify that tool."""
+    victim_tool = api_client.post(
+        api_routes.organizers_tools, json={"name": random_string()}, headers=unique_user.token
+    ).json()
+
+    attacker_tool_name = random_string()
+    recipe_name = random_string()
+    recipe = RecipeSummary(
+        id=uuid4(),
+        user_id=g2_user.user_id,
+        group_id=g2_user.group_id,
+        name=recipe_name,
+        slug=recipe_name,
+        tools=[{"id": victim_tool["id"], "name": attacker_tool_name, "slug": attacker_tool_name}],
+    )
+
+    r = api_client.post(api_routes.recipes_create_zip, files=zip_recipe(tempdir, recipe), headers=g2_user.token)
+    assert r.status_code == 201
+
+    # the victim's tool is unchanged and still in the victim's group
+    r = api_client.get(api_routes.organizers_tools_item_id(victim_tool["id"]), headers=unique_user.token)
+    assert r.status_code == 200
+    assert r.json()["name"] == victim_tool["name"]
+    assert r.json()["groupId"] == str(unique_user.group_id)
+
+    # the importer got their own tool, in their own group, not the victim's
+    imported = api_client.get(api_routes.recipes_slug(recipe.slug), headers=g2_user.token).json()
+    assert len(imported["tools"]) == 1
+    assert imported["tools"][0]["id"] != victim_tool["id"]
+    assert imported["tools"][0]["name"] == attacker_tool_name
+    assert imported["tools"][0]["groupId"] == str(g2_user.group_id)
