+class TestApplyOrderingForeignKeyTraversal(TestCase):
+    """Ordering columns must honour the same foreign-key rules as filter columns."""
+
+    def test_rejects_foreign_key_traversal(self):
+        from data_manager.managers import validate_ordering_field_name
+
+        for raw_field_name in [
+            'tasks:annotations__completed_by__password',
+            'tasks:-updated_by__password',
+            '-tasks:annotations__completed_by__email',
+            'updated_by__password',
+        ]:
+            with self.subTest(raw_field_name=raw_field_name):
+                with self.assertRaises(ValidationError):
+                    validate_ordering_field_name(raw_field_name)
+
+    def test_allows_plain_columns_data_keys_and_allowlisted_traversals(self):
+        from data_manager.managers import validate_ordering_field_name
+
+        for raw_field_name in [
+            'tasks:id',
+            '-tasks:completed_at',
+            'tasks:-total_annotations',
+            'tasks:data.my__nested__key',
+            'tasks:annotations__completed_by',
+            'tasks:updated_by__active_organization',
+        ]:
+            with self.subTest(raw_field_name=raw_field_name):
+                validate_ordering_field_name(raw_field_name)
