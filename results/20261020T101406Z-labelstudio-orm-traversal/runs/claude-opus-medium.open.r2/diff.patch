+def validate_ordering_field_name(raw_field_name: str) -> None:
+    """Reject ordering columns that traverse foreign keys, mirroring `FilterSerializer.validate_column`.
+
+    Ordering reaches `order_by()` with a user-supplied column name, so without this check an
+    ordering expression can walk relations the Data Manager never exposes (the ORM Leak class of
+    issue, see #5012). Accesses into the `task.data` JSONField are safe because they don't leverage
+    foreign keys, and deployments can opt specific traversals back in via DATA_MANAGER_FILTER_ALLOWLIST.
+
+    Edit with care; these validations are critical for security. In particular it is not advisable
+    to use `replace` or other calls that replace all instances of a string within this function.
+    """
+    column = raw_field_name
+
+    # Descending marker `-` may come before and/or after the `tasks:` prefix
+    if column.startswith('-'):
+        column = column[1:]
+    if column.startswith('tasks:'):
+        column = column[len('tasks:') :]
+    if column.startswith('-'):
+        column = column[1:]
+
+    # Underscores are allowed inside `task.data` keys: these don't leverage foreign keys
+    if column.startswith('data.'):
+        return
+
+    if column in settings.DATA_MANAGER_FILTER_ALLOWLIST:
+        return
+
+    if '__' in column:
+        raise ValidationError(
+            f'"__" is not generally allowed in ordering. Consider asking your administrator to add "{column}" '
+            'to DATA_MANAGER_FILTER_ALLOWLIST, but note that some ordering expressions may pose a security risk'
+        )
+
+
