             numeric_ordering = True
         field_name, ascending = preprocess_field_name(raw_field_name, project=project)
 
+        # Ordering is never validated by FilterSerializer.validate_column, so apply the same rule here:
+        # no foreign key traversals unless allowlisted, otherwise sorting by e.g.
+        # `annotations__completed_by__password` leaks related fields one comparison at a time (ORM Leak).
+        if (
+            '__' in field_name
+            and not field_name.startswith('data__')
+            and field_name not in settings.DATA_MANAGER_FILTER_ALLOWLIST
+        ):
+            raise ValidationError(f'"__" is not allowed in ordering field "{raw_field_name}"')
+
         if field_name.startswith('data__'):
             # annotate task with data field for float/int/bool ordering support
             json_field = field_name.replace('data__', '')
