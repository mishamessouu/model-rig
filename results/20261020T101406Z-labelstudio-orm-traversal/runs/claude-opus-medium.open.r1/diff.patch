+@pytest.mark.parametrize(
+    'ordering',
+    [
+        ['tasks:annotations__completed_by__password'],
+        ['-tasks:updated_by__password'],
+        ['tasks:-project__created_by__email'],
+    ],
+)
+@pytest.mark.django_db
+def test_views_ordering_rejects_foreign_key_traversal(ordering, business_client, project_id):
+    """Ordering must not allow ORM traversal into related models (ORM Leak sort oracle)."""
+    response = business_client.post(
+        '/api/dm/views/',
+        data=json.dumps({'project': project_id, 'data': {'ordering': ordering}}),
+        content_type='application/json',
+    )
+    assert response.status_code == 201, response.content
+    view_id = response.json()['id']
+
+    response = business_client.get(f'/api/tasks?view={view_id}')
+    assert response.status_code == 400, response.content
+
