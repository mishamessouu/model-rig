+def ensure_no_orm_traversal(field_name, raw_field_name):
+    """Reject ORM field names that traverse relations (``__``), mirroring
+    FilterSerializer.validate_column for ad-hoc filters and ordering that never pass
+    through the serializer (e.g. the ``query`` param). Without this, a column such as
+    ``updated_by__password`` turns filtering or sorting into a data-leak oracle (ORM Leak, #5012).
+
+    ``data__*`` keys are JSONField key lookups, not relation traversals, so they are allowed.
+    """
+    if field_name.startswith('data__') or field_name in settings.DATA_MANAGER_FILTER_ALLOWLIST:
+        return
+    if '__' in field_name:
+        raise ValidationError(f'"__" is not allowed in data manager filters or ordering: "{raw_field_name}"')
+
