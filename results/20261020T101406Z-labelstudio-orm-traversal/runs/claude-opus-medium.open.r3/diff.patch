--- a/label_studio/data_manager/tests/test_managers.py
+++ b/label_studio/data_manager/tests/test_managers.py
@@ -1431,3 +1431,65 @@ class TestApplyFiltersInvalidRegex(TestCase):
         assert result == 'EMPTY'
         load_func.assert_not_called()
         queryset.none.assert_called_once_with()
+
+
+class TestAdHocOrmTraversalRejected(TestCase):
+    """Ad-hoc filters/ordering (e.g. the ``query`` param) skip FilterSerializer.validate_column,
+    so the ``__`` relation-traversal guard must also hold at query time (ORM Leak, #5012)."""
+
+    def setUp(self):
+        self.project = ProjectFactory()
+        self.user = UserFactory()
+        TaskFactory(project=self.project, data={'text': 'a'}, updated_by=self.user)
+
+    def test_filter_traversing_relation_is_rejected(self):
+        from data_manager.managers import apply_filters
+        from rest_framework.exceptions import ValidationError
+
+        filters = Filters(
+            conjunction=ConjunctionEnum.AND,
+            items=[
+                Filter(
+                    filter='filter:tasks:updated_by__password',
+                    operator='starts_with',
+                    type='String',
+                    value='pbkdf2',
+                )
+            ],
+        )
+        with self.assertRaises(ValidationError):
+            apply_filters(Task.objects.filter(project=self.project), filters, self.project, Mock())
+
+    def test_ordering_traversing_relation_is_rejected(self):
+        from data_manager.managers import apply_ordering
+        from rest_framework.exceptions import ValidationError
+
+        for ordering in (['tasks:updated_by__password'], ['-tasks:updated_by__password']):
+            with self.assertRaises(ValidationError):
+                apply_ordering(Task.objects.filter(project=self.project), ordering, self.project, Mock())
+
+    def test_data_keys_and_allowlisted_fields_still_work(self):
+        from data_manager.managers import apply_filters, apply_ordering
+
+        queryset = Task.objects.filter(project=self.project)
+        apply_ordering(queryset, ['tasks:data.text'], self.project, Mock()).count()
+        filters = Filters(
+            conjunction=ConjunctionEnum.AND,
+            items=[
+                Filter(filter='filter:tasks:data.text', operator='equal', type='String', value='a'),
+            ],
+        )
+        self.assertEqual(apply_filters(queryset, filters, self.project, Mock()).count(), 1)
+
+        allowlisted = Filters(
+            conjunction=ConjunctionEnum.AND,
+            items=[
+                Filter(
+                    filter='filter:tasks:updated_by__active_organization',
+                    operator='empty',
+                    type='Unknown',
+                    value=False,
+                ),
+            ],
+        )
+        apply_filters(queryset, allowlisted, self.project, Mock()).count()
