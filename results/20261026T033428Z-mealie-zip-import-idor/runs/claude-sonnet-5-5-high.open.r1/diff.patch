+def test_create_recipe_from_zip_tool_in_another_group(
+    api_client: TestClient, unique_user: TestUser, g2_user: TestUser, tempdir: str
+):
+    """A tool id from another group must not be linked to, or modified by, an imported recipe."""
+    other_tool = api_client.post(
+        api_routes.organizers_tools, json={"name": random_string()}, headers=g2_user.token
+    ).json()
+
+    hijacked_name = random_string()
+    recipe_name = random_string()
+    recipe = RecipeSummary(
+        id=uuid4(),
+        user_id=unique_user.user_id,
+        group_id=unique_user.group_id,
+        name=recipe_name,
+        slug=recipe_name,
+        tools=[{"id": other_tool["id"], "name": hijacked_name, "slug": hijacked_name}],  # type: ignore[list-item]
+    )
+
+    r = api_client.post(api_routes.recipes_create_zip, files=zip_recipe(tempdir, recipe), headers=unique_user.token)
+    assert r.status_code == 201
+
+    # the other group's tool is untouched
+    still_there = api_client.get(api_routes.organizers_tools_item_id(other_tool["id"]), headers=g2_user.token)
+    assert still_there.status_code == 200
+    assert still_there.json()["name"] == other_tool["name"]
+    assert still_there.json()["groupId"] == other_tool["groupId"]
+
+    # the imported recipe gets a tool of its own, owned by the importing group
+    imported = api_client.get(api_routes.recipes_slug(r.json()), headers=unique_user.token).json()
+    assert len(imported["tools"]) == 1
+    assert imported["tools"][0]["id"] != other_tool["id"]
+    assert imported["tools"][0]["name"] == hijacked_name
+    assert imported["tools"][0]["groupId"] == str(unique_user.group_id)
+
+
+def test_create_recipe_from_zip_unnamed_tool(api_client: TestClient, unique_user: TestUser, tempdir: str):
+    recipe_name = random_string()
+    recipe = json.loads(RecipeSummary(id=uuid4(), user_id=unique_user.user_id, name=recipe_name).model_dump_json())
+    recipe.update({"slug": recipe_name, "tools": [{"id": str(uuid4()), "name": "", "slug": ""}]})
+    with tempfile.TemporaryDirectory() as td:
+        zip_path = Path(td) / "zipfile.zip"
+        with ZipFile(zip_path, "w") as zf:
+            zf.writestr(f"{recipe_name}.json", json.dumps(recipe))
+        archive = zip_path.read_bytes()
+
+    r = api_client.post(api_routes.recipes_create_zip, files={"archive": archive}, headers=unique_user.token)
+    assert r.status_code == 201
+
+    imported = api_client.get(api_routes.recipes_slug(r.json()), headers=unique_user.token).json()
+    assert imported["tools"] == []
+
+
+def test_create_recipe_from_zip_existing_tool(api_client: TestClient, unique_user: TestUser, tempdir: str):
+    tool = api_client.post(api_routes.organizers_tools, json={"name": random_string()}, headers=unique_user.token).json()
+
+    recipe_name = random_string()
+    recipe = RecipeSummary(
+        id=uuid4(),
+        user_id=unique_user.user_id,
+        group_id=unique_user.group_id,
+        name=recipe_name,
+        slug=recipe_name,
+        tools=[{"id": uuid4(), "name": tool["name"], "slug": tool["slug"]}],  # type: ignore[list-item]
+    )
+
+    r = api_client.post(api_routes.recipes_create_zip, files=zip_recipe(tempdir, recipe), headers=unique_user.token)
+    assert r.status_code == 201
+
+    imported = api_client.get(api_routes.recipes_slug(r.json()), headers=unique_user.token).json()
+    assert [t["id"] for t in imported["tools"]] == [tool["id"]]
+
