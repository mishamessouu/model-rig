+    def _transform_tool(self, data: dict[str, Any] | Any) -> dict[str, Any] | None:
+        # Ensures the tool from the source instance exists in this group, creating it if necessary.
+        # The exported id is never reused: the ORM resolves relationship ids across every group, so
+        # keeping it would link this recipe to (and overwrite) a tool owned by another group.
+        if not isinstance(data, dict):
+            return None
+
+        name = self._non_empty_str(data.get("name"))
+        if not name:
+            return None
+
+        slug = self._non_empty_str(data.get("slug")) or slugify(name)
+        existing_tool = self.repos.tools.get_one(slug, "slug")
+        if existing_tool:
+            return existing_tool.model_dump()
+
+        new_tool = self.repos.tools.create(RecipeToolSave(name=name, group_id=self.user.group_id))
+        return new_tool.model_dump()
+
