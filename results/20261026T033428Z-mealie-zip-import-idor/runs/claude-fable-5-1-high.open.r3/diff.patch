+    def _transform_tool(self, data: dict[str, Any] | Any) -> dict[str, Any] | None:
+        """Resolve an exported tool to one owned by the importing group.
+
+        The exported id must not be trusted: the ORM resolves many-to-many members by id without a
+        group filter and then overwrites the matched row with the incoming fields, so an id copied
+        from another group would let an import rename and re-home that group's tool.
+        """
+        if not isinstance(data, dict):
+            return None
+
+        name = self._non_empty_str(data.get("name"))
+        if not name:
+            return None
+
+        # Tools are keyed by slug within a group, and the model derives the slug from the name,
+        # so check both the exported slug and the one this instance would generate.
+        candidate_slugs = dict.fromkeys(filter(None, [self._non_empty_str(data.get("slug")), slugify(name)]))
+        for slug in candidate_slugs:
+            existing_tool = self.repos.tools.get_one(slug, "slug")
+            if existing_tool:
+                return existing_tool.model_dump()
+
+        new_tool = self.repos.tools.create(RecipeToolSave(name=name, group_id=self.user.group_id))
+        return new_tool.model_dump()
+
