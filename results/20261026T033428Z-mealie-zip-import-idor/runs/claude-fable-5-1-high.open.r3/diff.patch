+
+
+def test_create_recipe_from_zip_cannot_hijack_tool_from_another_group(
+    api_client: TestClient, unique_user: TestUser, g2_user: TestUser, tempdir: str
+):
+    """A zip that references another group's tool id must not touch that group's tool.
+
+    Tools in the archive are resolved by name within the importing group, so the import
+    gets its own tool and the other group's tool keeps its name and group.
+    """
+    victim_tool = api_client.post(
+        api_routes.organizers_tools, json={"name": random_string()}, headers=g2_user.token
+    ).json()
+
+    hijacked_name = random_string()
+    recipe_name = random_string()
+    recipe = Recipe(
+        id=uuid4(),
+        user_id=unique_user.user_id,
+        group_id=unique_user.group_id,
+        name=recipe_name,
+        slug=recipe_name,
+    )
+    recipe_dict = json.loads(recipe.model_dump_json())
+    recipe_dict["tools"] = [
+        {
+            "id": victim_tool["id"],
+            "groupId": str(g2_user.group_id),
+            "name": hijacked_name,
+            "slug": slugify(hijacked_name),
+            "onHand": True,
+        }
+    ]
+    recipe_dict["userId"] = str(g2_user.user_id)
+
+    with tempfile.NamedTemporaryFile(mode="w+", dir=tempdir, suffix=".json", delete=False) as data_file:
+        json.dump(recipe_dict, data_file)
+        data_file.flush()
+        zip_file = os.path.join(tempdir, "hijack.zip")
+        with ZipFile(zip_file, "w") as zf:
+            zf.write(data_file.name)
+
+    r = api_client.post(
+        api_routes.recipes_create_zip, files={"archive": Path(zip_file).read_bytes()}, headers=unique_user.token
+    )
+    assert r.status_code == 201
+
+    # the other group's tool is untouched
+    untouched = api_client.get(api_routes.organizers_tools_item_id(victim_tool["id"]), headers=g2_user.token)
+    assert untouched.status_code == 200
+    assert untouched.json()["name"] == victim_tool["name"]
+    assert untouched.json()["groupId"] == str(g2_user.group_id)
+
+    # the importing user gets a tool of their own in their group
+    imported = api_client.get(api_routes.recipes_slug(r.json()), headers=unique_user.token).json()
+    assert [t["name"] for t in imported["tools"]] == [hijacked_name]
+    assert imported["tools"][0]["id"] != victim_tool["id"]
+    assert imported["tools"][0]["groupId"] == str(unique_user.group_id)
+    assert imported["userId"] == str(unique_user.user_id)
