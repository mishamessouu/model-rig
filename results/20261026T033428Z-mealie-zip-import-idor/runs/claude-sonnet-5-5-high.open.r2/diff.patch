+    def _transform_tool(self, data: dict[str, Any]) -> dict[str, Any] | None:
+        # Tools are matched by name within this group. The id in the archive is never trusted, since it could
+        # belong to a tool in another group, which would otherwise be attached to the recipe and rewritten.
+        name = self._non_empty_str(data.get("name"))
+        if not name:
+            return None
+
