+def test_create_recipe_from_zip_tool_from_another_group(
+    api_client: TestClient, unique_user: TestUser, g2_user: TestUser, tempdir: str
+):
+    """A tool id in the export must never resolve to, or modify, a tool owned by another group."""
+    tool_name = random_string()
+    other_tool = api_client.post(api_routes.organizers_tools, json={"name": tool_name}, headers=g2_user.token).json()
+
+    recipe_name = random_string()
+    recipe = RecipeSummary(
+        id=uuid4(),
+        user_id=unique_user.user_id,
+        group_id=unique_user.group_id,
+        name=recipe_name,
+        slug=recipe_name,
+        tools=[RecipeTool(id=other_tool["id"], name="hijacked", slug="hijacked")],
+    )
+
+    r = api_client.post(api_routes.recipes_create_zip, files=zip_recipe(tempdir, recipe), headers=unique_user.token)
+    assert r.status_code == 201
+
+    imported = api_client.get(api_routes.recipes_slug(r.json()), headers=unique_user.token).json()
+    assert len(imported["tools"]) == 1
+    assert imported["tools"][0]["id"] != other_tool["id"]
+    assert imported["tools"][0]["slug"] == "hijacked"
+    assert imported["tools"][0]["groupId"] == str(unique_user.group_id)
+
+    # the other group's tool is untouched
+    still_there = api_client.get(api_routes.organizers_tools_item_id(other_tool["id"]), headers=g2_user.token)
+    assert still_there.status_code == 200
+    assert still_there.json()["name"] == tool_name
+    assert still_there.json()["groupId"] == str(g2_user.group_id)
+
+
+def test_create_recipe_from_zip_existing_tool(api_client: TestClient, unique_user: TestUser, tempdir: str):
+    database = unique_user.repos
+    tool = database.tools.create({"name": random_string(), "group_id": unique_user.group_id})
+    exported_tool = RecipeTool(id=uuid4(), name=tool.name, slug=tool.slug)
+
+    recipe_name = random_string()
+    recipe = RecipeSummary(
+        id=uuid4(),
+        user_id=unique_user.user_id,
+        group_id=unique_user.group_id,
+        name=recipe_name,
+        slug=recipe_name,
+        tools=[exported_tool],
+    )
+
+    r = api_client.post(api_routes.recipes_create_zip, files=zip_recipe(tempdir, recipe), headers=unique_user.token)
+    assert r.status_code == 201
+
+    fetched_recipe = database.recipes.get_by_slug(unique_user.group_id, recipe.slug)
+    assert fetched_recipe
+    assert len(fetched_recipe.tools) == 1
+    assert str(fetched_recipe.tools[0].id) == str(tool.id)
+
