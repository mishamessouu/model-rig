+def test_create_recipe_from_zip_tool_id_from_another_group(
+    api_client: TestClient, unique_user: TestUser, g2_user: TestUser, tempdir: str
+):
+    """A tool id belonging to another group must not be adopted or modified by an import."""
+    other_tool = api_client.post(
+        api_routes.organizers_tools, json={"name": random_string()}, headers=g2_user.token
+    ).json()
+
+    recipe_name = random_string()
+    with tempfile.NamedTemporaryFile(mode="w+", dir=tempdir, suffix=".json", delete=False) as data_file:
+        json.dump(
+            {
+                "name": recipe_name,
+                "slug": recipe_name,
+                "tools": [{"id": other_tool["id"], "name": "hijacked", "slug": "hijacked"}],
+            },
+            data_file,
+        )
+        data_file.flush()
+
+        zip_file = os.path.join(tempdir, "foreign_tool_zipfile.zip")
+        with ZipFile(zip_file, "w") as zf:
+            zf.write(data_file.name)
+
+    r = api_client.post(
+        api_routes.recipes_create_zip, files={"archive": Path(zip_file).read_bytes()}, headers=unique_user.token
+    )
+    assert r.status_code == 201
+
+    # the other group still owns its tool, unchanged
+    g2_tools = api_client.get(api_routes.organizers_tools, headers=g2_user.token).json()["items"]
+    assert [(t["id"], t["name"]) for t in g2_tools] == [(other_tool["id"], other_tool["name"])]
+
+    # the import got a tool of its own in the importing group
+    imported = api_client.get(api_routes.recipes_slug(r.json()), headers=unique_user.token).json()
+    assert [t["name"] for t in imported["tools"]] == ["hijacked"]
+    assert imported["tools"][0]["id"] != other_tool["id"]
+    assert imported["tools"][0]["groupId"] == str(unique_user.group_id)
+
+
