+def _is_group_owned(relation_cls: type[SqlAlchemyBase]) -> bool:
+    """Returns True when the related class stores a group of its own.
+
+    Only a real column counts: classes that expose `group_id` as an association proxy derive
+    their group from a parent row instead, so there is nothing to filter on.
+    """
+    try:
+        return "group_id" in inspect(relation_cls).columns
+    except Exception:
+        return False
+
+
+def _owning_group_id(instance: SqlAlchemyBase, kwargs: dict) -> UUID | str | None:
+    """Returns the group this row belongs to, or None when it does not belong to one.
+
+    On an update the row is already persisted, so its stored group is used when the caller did
+    not supply one. `group_id` can also be an association proxy, which raises on a row whose
+    parent is not set yet, hence the broad guard.
+    """
+    group_id = kwargs.get("group_id", None)
+    if group_id is not None:
+        return group_id
+
+    try:
+        return getattr(instance, "group_id", None)
+    except Exception:
+        return None
 
 
