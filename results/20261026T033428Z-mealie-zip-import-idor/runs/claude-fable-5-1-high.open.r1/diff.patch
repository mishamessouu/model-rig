+def test_create_recipe_from_zip_cannot_reach_a_tool_from_another_group(
+    api_client: TestClient, unique_user: TestUser, g2_user: TestUser, tempdir: str
+):
+    """
+    A zip is untrusted input, and the organizer ids inside it are resolved against the whole
+    instance rather than the importing group. Matching an id from another group hands the
+    importer that group's tool row, and the values from the zip are then written onto it,
+    renaming it and moving it into the importing group.
+    """
+
+    foreign_tool = g2_user.repos.tools.create(RecipeToolSave(name=random_string(), group_id=g2_user.group_id))
+
+    recipe_name = random_string()
+    hijacked_name = random_string()
+    recipe = RecipeSummary(
+        id=uuid4(),
+        user_id=unique_user.user_id,
+        group_id=unique_user.group_id,
+        name=recipe_name,
+        slug=recipe_name,
+        tools=[
+            RecipeTool(
+                id=foreign_tool.id,
+                group_id=unique_user.group_id,
+                name=hijacked_name,
+                slug=slugify(hijacked_name),
+            )
+        ],
+    )
+
+    r = api_client.post(api_routes.recipes_create_zip, files=zip_recipe(tempdir, recipe), headers=unique_user.token)
+    assert r.status_code == 201
+
+    # the other group still owns its tool, under its original name
+    untouched = g2_user.repos.tools.get_one(foreign_tool.id)
+    assert untouched is not None
+    assert untouched.name == foreign_tool.name
+    assert str(untouched.group_id) == str(g2_user.group_id)
+
+    # and it was never linked to the imported recipe
+    imported = api_client.get(api_routes.recipes_slug(r.json()), headers=unique_user.token).json()
+    assert str(foreign_tool.id) not in [tool["id"] for tool in imported["tools"]]
