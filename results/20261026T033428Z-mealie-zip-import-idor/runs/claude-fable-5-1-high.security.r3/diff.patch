+def test_create_recipe_from_zip_ignores_ids_from_other_groups(
+    api_client: TestClient, unique_user: TestUser, g2_user: TestUser, tempdir: str
+):
+    """Nested ids in an uploaded zip must never bind to, or modify, rows that belong to another group."""
+    tool = api_client.post(
+        api_routes.organizers_tools, json={"name": random_string()}, headers=unique_user.token
+    ).json()
+    slug = api_client.post(api_routes.recipes, json={"name": random_string()}, headers=unique_user.token).json()
+    victim = api_client.get(api_routes.recipes_slug(slug), headers=unique_user.token).json()
+    victim["recipeInstructions"] = [{"text": "secret step"}]
+    victim["tools"] = [tool]
+    assert api_client.put(api_routes.recipes_slug(slug), json=victim, headers=unique_user.token).status_code == 200
+    victim = api_client.get(api_routes.recipes_slug(slug), headers=unique_user.token).json()
+    comment = api_client.post(
+        api_routes.comments, json={"recipeId": victim["id"], "text": "secret comment"}, headers=unique_user.token
+    ).json()
+
+    payload = {
+        "name": random_string(),
+        "tools": [{**tool, "name": "stolen"}],
+        "recipeInstructions": [{"id": victim["recipeInstructions"][0]["id"], "text": "overwritten"}],
+        "comments": [{**comment, "text": "overwritten"}],
+    }
+    with tempfile.NamedTemporaryFile(mode="w+", dir=tempdir, suffix=".json", delete=False) as data_file:
+        json.dump(payload, data_file)
+        data_file.flush()
+        zip_file = os.path.join(tempdir, "foreign-ids.zip")
+        with ZipFile(zip_file, "w") as zf:
+            zf.write(data_file.name)
+
+    r = api_client.post(
+        api_routes.recipes_create_zip, files={"archive": Path(zip_file).read_bytes()}, headers=g2_user.token
+    )
+    assert r.status_code == 201
+
+    # the other group's data is untouched
+    after = api_client.get(api_routes.recipes_slug(slug), headers=unique_user.token).json()
+    assert [step["text"] for step in after["recipeInstructions"]] == ["secret step"]
+    assert [c["text"] for c in after["comments"]] == ["secret comment"]
+    assert [t["id"] for t in after["tools"]] == [tool["id"]]
+    assert after["tools"][0]["name"] == tool["name"]
+
+    # the importer got their own rows, created in their own group
+    imported = api_client.get(api_routes.recipes_slug(r.json()), headers=g2_user.token).json()
+    assert imported["comments"] == []
+    assert imported["recipeInstructions"][0]["id"] != victim["recipeInstructions"][0]["id"]
+    assert len(imported["tools"]) == 1
+    assert imported["tools"][0]["id"] != tool["id"]
+    assert imported["tools"][0]["groupId"] == str(g2_user.group_id)
+
+
