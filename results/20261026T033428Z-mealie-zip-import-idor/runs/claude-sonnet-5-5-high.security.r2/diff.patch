+def test_create_recipe_from_zip_does_not_hijack_other_groups_tool(
+    api_client: TestClient, unique_user: TestUser, g2_user: TestUser, tempdir: str
+):
+    """A tool id in an imported zip must never resolve to (or modify) a tool owned by another group."""
+    victim_tool = g2_user.repos.tools.create(RecipeToolSave(name=random_string(), group_id=g2_user.group_id))
+
+    recipe_name = random_string()
+    recipe = Recipe(
+        id=uuid4(),
+        user_id=unique_user.user_id,
+        group_id=unique_user.group_id,
+        name=recipe_name,
+        slug=recipe_name,
+        tools=[RecipeTool(id=victim_tool.id, name="hijacked", slug="hijacked")],
+    )
+
+    r = api_client.post(api_routes.recipes_create_zip, files=zip_recipe(tempdir, recipe), headers=unique_user.token)
+    assert r.status_code == 201
+
+    # the other group's tool is untouched and still belongs to its group
+    unchanged = g2_user.repos.tools.get_one(victim_tool.id)
+    assert unchanged
+    assert unchanged.name == victim_tool.name
+    assert str(unchanged.group_id) == str(g2_user.group_id)
+
+    # the imported recipe gets its own tool in the importing group
+    imported = unique_user.repos.recipes.get_by_slug(unique_user.group_id, recipe.slug)
+    assert imported
+    assert len(imported.tools) == 1
+    assert imported.tools[0].id != victim_tool.id
