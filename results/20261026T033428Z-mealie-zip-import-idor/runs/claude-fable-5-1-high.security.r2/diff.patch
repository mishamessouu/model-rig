+    def _transform_tool(self, data: dict[str, Any] | Any) -> dict[str, Any] | None:
+        """Resolve an imported tool to one owned by this group, creating it if absent.
+
+        The exported id is only honored when it belongs to this group. The ORM links relationship
+        rows by id without a group filter and overwrites the matched row with the imported values,
+        so passing a foreign id through would let an import rename another group's tool and move
+        it into this group.
+        """
+        if not isinstance(data, dict):
+            return None
+
+        existing = None
+        if data.get("id"):
+            try:
+                existing = self.repos.tools.get_one(UUID(str(data["id"])))
+            except ValueError:
+                existing = None
+
+        if existing is None and data.get("slug"):
+            existing = self.repos.tools.get_one(str(data["slug"]), "slug")
+
+        if existing is None:
+            name = self._non_empty_str(data.get("name"))
+            if not name:
+                return None
+            existing = self.repos.tools.create({"name": name, "group_id": self.user.group_id})
+
+        return {
+            "id": str(existing.id),
+            "group_id": str(existing.group_id),
+            "name": existing.name,
+            "slug": existing.slug,
+        }
+
