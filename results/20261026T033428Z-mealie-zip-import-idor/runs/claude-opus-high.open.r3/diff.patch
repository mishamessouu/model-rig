+def test_create_recipe_from_zip_existing_tool(api_client: TestClient, unique_user: TestUser, tempdir: str):
+    database = unique_user.repos
+    tool = database.tools.create(RecipeToolSave(name=random_string(), group_id=unique_user.group_id))
+    exported_tool = RecipeTool(id=uuid4(), name=tool.name, slug=tool.slug)
+
+    recipe_name = random_string()
+    recipe = RecipeSummary(
+        id=uuid4(),
+        user_id=unique_user.user_id,
+        group_id=unique_user.group_id,
+        name=recipe_name,
+        slug=recipe_name,
+        tools=[exported_tool],
+    )
+
+    r = api_client.post(api_routes.recipes_create_zip, files=zip_recipe(tempdir, recipe), headers=unique_user.token)
+    assert r.status_code == 201
+
+    fetched_recipe = database.recipes.get_by_slug(unique_user.group_id, recipe.slug)
+    assert fetched_recipe
+    assert len(fetched_recipe.tools) == 1
+    assert str(fetched_recipe.tools[0].id) == str(tool.id)
+
+
+def test_create_recipe_from_zip_tool_id_from_another_group(
+    api_client: TestClient, unique_user: TestUser, g2_user: TestUser, tempdir: str
+):
+    """A tool id belonging to another group must not let the import rename or take over that group's tool."""
+    other_tool = g2_user.repos.tools.create(RecipeToolSave(name=random_string(), group_id=g2_user.group_id))
+    hijacked_name = random_string()
+    exported_tool = RecipeTool(id=other_tool.id, name=hijacked_name, slug=hijacked_name)
+
+    recipe_name = random_string()
+    recipe = RecipeSummary(
+        id=uuid4(),
+        user_id=unique_user.user_id,
+        group_id=unique_user.group_id,
+        name=recipe_name,
+        slug=recipe_name,
+        tools=[exported_tool],
+    )
+
+    r = api_client.post(api_routes.recipes_create_zip, files=zip_recipe(tempdir, recipe), headers=unique_user.token)
+    assert r.status_code == 201
+
+    # the other group's tool is untouched
+    g2_user.repos.session.expire_all()
+    still_there = g2_user.repos.tools.get_one(other_tool.id)
+    assert still_there
+    assert still_there.name == other_tool.name
+    assert str(still_there.group_id) == str(g2_user.group_id)
+
+    # the import got its own tool in the importing group
+    fetched_recipe = unique_user.repos.recipes.get_by_slug(unique_user.group_id, recipe.slug)
+    assert fetched_recipe
+    assert len(fetched_recipe.tools) == 1
+    assert fetched_recipe.tools[0].id != other_tool.id
+    assert fetched_recipe.tools[0].name == hijacked_name
+    assert str(fetched_recipe.tools[0].group_id) == str(unique_user.group_id)
+
+
