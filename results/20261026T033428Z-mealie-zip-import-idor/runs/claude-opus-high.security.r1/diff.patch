diff --git a/mealie/services/recipe/recipe_service.py b/mealie/services/recipe/recipe_service.py
index 3995216..d8797e6 100644
--- a/mealie/services/recipe/recipe_service.py
+++ b/mealie/services/recipe/recipe_service.py
@@ -364,6 +364,23 @@ class RecipeService(RecipeServiceBase):
         self._reset_data_matcher()
         return data
 
+    def _transform_referenced_recipe(self, data: dict[str, Any]) -> dict[str, Any] | None:
+        # The ORM resolves the reference by id without group scoping, so a link to a recipe
+        # outside this group (or from another instance) is dropped rather than followed.
+        recipe_id = data.get("id")
+        if not recipe_id:
+            return None
+
+        try:
+            recipe_id = UUID(str(recipe_id))
+        except ValueError:
+            return None
+
+        if not self.group_recipes.get_one(recipe_id, key="id"):
+            return None
+
+        return data
+
     def _process_recipe_data(self, key: str, data: list | dict | Any) -> Any:
         if isinstance(data, list):
             return [self._process_recipe_data(key, item) for item in data]
@@ -396,6 +413,8 @@ class RecipeService(RecipeServiceBase):
             return self._transform_food(data)
         elif key == "unit":
             return self._transform_unit(data)
+        elif key == "referenced_recipe":
+            return self._transform_referenced_recipe(data)
         # recursively process other objects
         for k, v in data.items():
             data[k] = self._process_recipe_data(k, v)
