+def test_create_recipe_from_zip_ignores_tool_of_another_group(
+    api_client: TestClient, unique_user: TestUser, g2_user: TestUser, tempdir: str
+):
+    """A tool id from another group in the archive must not be linked or modified."""
+    r = api_client.post(api_routes.organizers_tools, json={"name": random_string()}, headers=g2_user.token)
+    assert r.status_code == 201
+    foreign = r.json()
+
+    recipe_name = random_string()
+    with tempfile.NamedTemporaryFile(mode="w+", dir=tempdir, suffix=".json", delete=False) as data_file:
+        json.dump(
+            {
+                "name": recipe_name,
+                "slug": recipe_name,
+                "tools": [{"id": foreign["id"], "name": "hijacked", "slug": foreign["slug"], "groupId": g2_user.group_id}],
+            },
+            data_file,
+        )
+        data_file.flush()
+        zip_file = os.path.join(tempdir, "tool_zipfile.zip")
+        with ZipFile(zip_file, "w") as zf:
+            zf.write(data_file.name)
+
+    r = api_client.post(
+        api_routes.recipes_create_zip, files={"archive": Path(zip_file).read_bytes()}, headers=unique_user.token
+    )
+    assert r.status_code == 201
+
+    imported = api_client.get(api_routes.recipes_slug(r.json()), headers=unique_user.token).json()
+    assert all(t["id"] != foreign["id"] for t in imported["tools"])
+
+    still = api_client.get(api_routes.organizers_tools_item_id(foreign["id"]), headers=g2_user.token).json()
+    assert still["name"] == foreign["name"]
