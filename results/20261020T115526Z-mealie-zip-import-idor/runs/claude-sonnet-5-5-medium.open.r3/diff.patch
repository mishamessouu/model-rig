+def test_create_recipe_from_zip_ignores_tool_from_another_group(
+    api_client: TestClient, unique_user: TestUser, g2_user: TestUser, tempdir: str
+):
+    """A tool id belonging to another group must not be linked to (or rewritten by) the imported recipe."""
+    foreign_name = random_string()
+    foreign_tool = g2_user.repos.tools.create({"name": foreign_name, "group_id": g2_user.group_id})
+
+    recipe_name = random_string()
+    recipe = RecipeSummary(
+        id=uuid4(),
+        user_id=unique_user.user_id,
+        group_id=unique_user.group_id,
+        name=recipe_name,
+        slug=recipe_name,
+        tools=[{"id": str(foreign_tool.id), "name": "stolen-" + foreign_name, "slug": foreign_tool.slug}],
+    )
+    r = api_client.post(api_routes.recipes_create_zip, files=zip_recipe(tempdir, recipe), headers=unique_user.token)
+    assert r.status_code == 201
+
+    imported = unique_user.repos.recipes.get_by_slug(unique_user.group_id, recipe.slug)
+    assert imported
+    assert len(imported.tools) == 1
+    assert imported.tools[0].id != foreign_tool.id
+    assert str(imported.tools[0].group_id) == str(unique_user.group_id)
+
+    untouched = g2_user.repos.tools.get_one(foreign_tool.id)
+    assert untouched
+    assert untouched.name == foreign_name
+    assert str(untouched.group_id) == str(g2_user.group_id)
+
+
