+    def _transform_tool(self, data: dict[str, Any] | Any) -> dict[str, Any] | Any:
+        # Tools are matched by slug within the user's group. The imported id is never trusted: the
+        # many-to-many loader looks ids up across all groups, so a foreign id would link (and
+        # rewrite) another group's tool.
+        if not isinstance(data, dict):
+            return data
+
+        name = self._non_empty_str(data.get("name"))
+        if not name:
+            return None
+
+        existing = self.repos.tools.get_one(slugify(name), "slug")
+        if existing:
+            return existing.model_dump()
+
+        return self.repos.tools.create(RecipeToolSave(name=name, group_id=self.user.group_id)).model_dump()
+
