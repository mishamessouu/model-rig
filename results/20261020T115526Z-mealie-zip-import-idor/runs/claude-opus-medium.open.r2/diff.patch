+def test_create_recipe_from_zip_does_not_take_over_other_groups_tool(
+    api_client: TestClient, unique_user: TestUser, g2_user: TestUser
+):
+    """A zip naming another group's tool by id gets a tool in the importer's group; the other group's is untouched."""
+    victim_tool = api_client.post(
+        api_routes.organizers_tools, json={"name": random_string()}, headers=g2_user.token
+    ).json()
+
+    recipe_name = random_string()
+    recipe_dict = {
+        "name": recipe_name,
+        "slug": slugify(recipe_name),
+        "tools": [{"id": victim_tool["id"], "name": "hijacked", "slug": "hijacked"}],
+    }
+
+    with tempfile.TemporaryDirectory() as tmpdir:
+        zip_path = Path(tmpdir) / "recipe.zip"
+        with ZipFile(zip_path, "w") as zf:
+            zf.writestr("recipe.json", json.dumps(recipe_dict))
+        r = api_client.post(
+            api_routes.recipes_create_zip, files={"archive": zip_path.read_bytes()}, headers=unique_user.token
+        )
+    assert r.status_code == 201
+
+    imported = api_client.get(api_routes.recipes_slug(r.json()), headers=unique_user.token).json()
+    assert len(imported["tools"]) == 1
+    assert imported["tools"][0]["id"] != victim_tool["id"]
+    assert imported["tools"][0]["groupId"] == str(unique_user.group_id)
+
+    still_there = api_client.get(api_routes.organizers_tools_item_id(victim_tool["id"]), headers=g2_user.token)
+    assert still_there.status_code == 200
+    assert still_there.json()["name"] == victim_tool["name"]
+    assert still_there.json()["groupId"] == victim_tool["groupId"]
+
+
