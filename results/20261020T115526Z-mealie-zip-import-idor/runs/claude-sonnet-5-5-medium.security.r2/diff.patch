+    def _transform_tool(self, data: dict) -> dict:
+        # Tools are matched by slug within this group only. The id from the archive is never trusted,
+        # otherwise it could point at (and rewrite) a tool that belongs to another group.
+        name = self._non_empty_str(data.get("name"))
+        slug = self._non_empty_str(data.get("slug")) or (slugify(name) if name else None)
+        if not slug:
+            return data
+
+        existing = self.repos.tools.get_one(slug, "slug")
+        if existing:
+            return existing.model_dump()
+
+        new_tool = self.repos.tools.create(
+            {"name": name or slug, "slug": slug, "group_id": self.user.group_id}
+        )
+        return new_tool.model_dump()
+
