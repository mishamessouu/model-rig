+
+def test_create_recipe_from_zip_does_not_touch_other_groups_tools(
+    api_client: TestClient, unique_user: TestUser, g2_user: TestUser, tempdir: str
+):
+    """A zip referencing another group's tool id must not move or rename that tool."""
+    tool = api_client.post(api_routes.organizers_tools, json={"name": random_string()}, headers=g2_user.token).json()
+
+    recipe_name = random_string()
+    recipe = RecipeSummary(user_id=unique_user.user_id, group_id=unique_user.group_id, name=recipe_name, slug=recipe_name)
+    data = json.loads(recipe.model_dump_json())
+    data["tools"] = [{"id": tool["id"], "name": "hijacked", "slug": "hijacked"}]
+
+    zip_file = os.path.join(tempdir, "tool_zipfile.zip")
+    with ZipFile(zip_file, "w") as zf:
+        zf.writestr("recipe.json", json.dumps(data))
+
+    r = api_client.post(
+        api_routes.recipes_create_zip, files={"archive": Path(zip_file).read_bytes()}, headers=unique_user.token
+    )
+    assert r.status_code == 201
+
+    after = api_client.get(api_routes.organizers_tools_item_id(tool["id"]), headers=g2_user.token)
+    assert after.status_code == 200
+    assert after.json()["name"] == tool["name"]
+    assert after.json()["groupId"] == str(g2_user.group_id)
