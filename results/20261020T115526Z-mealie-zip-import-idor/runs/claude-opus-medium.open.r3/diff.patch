+def test_create_recipe_from_zip_cannot_take_over_other_groups_tool(
+    api_client: TestClient, unique_user: TestUser, g2_user: TestUser, tempdir: str
+):
+    """Nested ids in an archive must not reach into another group's data."""
+    tool_name = random_string()
+    other_tool = api_client.post(api_routes.organizers_tools, json={"name": tool_name}, headers=g2_user.token).json()
+
+    recipe_name = random_string()
+    recipe = Recipe(
+        user_id=unique_user.user_id,
+        group_id=unique_user.group_id,
+        name=recipe_name,
+        slug=recipe_name,
+        tools=[{"id": other_tool["id"], "name": "hijacked", "slug": other_tool["slug"]}],
+    )
+    r = api_client.post(api_routes.recipes_create_zip, files=zip_recipe(tempdir, recipe), headers=unique_user.token)
+    assert r.status_code == 201
+
+    imported = api_client.get(api_routes.recipes_slug(r.json()), headers=unique_user.token).json()
+    assert [t["id"] for t in imported["tools"]] != [other_tool["id"]]
+
+    # the other group's tool is untouched and still belongs to that group
+    still_there = api_client.get(api_routes.organizers_tools_item_id(other_tool["id"]), headers=g2_user.token)
+    assert still_there.status_code == 200
+    assert still_there.json()["name"] == tool_name
+
+
+def test_create_recipe_from_zip_cannot_reference_other_groups_recipe(
+    api_client: TestClient, unique_user: TestUser, g2_user: TestUser, tempdir: str
+):
+    """A sub-recipe in an archive may only link to a recipe the importing group can already see."""
+    other_slug = api_client.post(api_routes.recipes, json={"name": random_string()}, headers=g2_user.token).json()
+    other_recipe = api_client.get(api_routes.recipes_slug(other_slug), headers=g2_user.token).json()
+
+    recipe_name = random_string()
+    recipe = json.loads(
+        Recipe(
+            user_id=unique_user.user_id, group_id=unique_user.group_id, name=recipe_name, slug=recipe_name
+        ).model_dump_json()
+    )
+    recipe["recipe_ingredient"] = [{"note": "sub", "referenced_recipe": other_recipe}]
+
+    zip_file = os.path.join(tempdir, "subrecipe.zip")
+    with ZipFile(zip_file, "w") as zf:
+        zf.writestr("recipe.json", json.dumps(recipe))
+
+    r = api_client.post(
+        api_routes.recipes_create_zip, files={"archive": Path(zip_file).read_bytes()}, headers=unique_user.token
+    )
+    assert r.status_code == 201
+
+    imported = api_client.get(api_routes.recipes_slug(r.json()), headers=unique_user.token).json()
+    assert imported["recipeIngredient"][0]["referencedRecipe"] is None
