--- a/label_studio/data_manager/managers.py
+++ b/label_studio/data_manager/managers.py
@@ -797,6 +797,17 @@ def apply_filters(queryset, filters, project, request):
 
             # django orm loop expression attached to column name
             field_name, _ = preprocess_field_name(_filter.filter, project)
+            # Reject foreign key traversals here as well as in FilterSerializer.validate_column:
+            # ad hoc filters (``?query=`` / request body) never pass through the view serializer,
+            # so without this check any related model field (e.g. updated_by__password) could be
+            # probed with contains/regex (ORM Leak, #5012). Edit with care.
+            if '__' in field_name and not field_name.startswith('data__'):
+                if field_name not in settings.DATA_MANAGER_FILTER_ALLOWLIST:
+                    raise ValidationError(
+                        f'"__" is not generally allowed in filters. Consider asking your administrator to add '
+                        f'"{field_name}" to DATA_MANAGER_FILTER_ALLOWLIST, but note that some filter expressions '
+                        'may pose a security risk'
+                    )
             if _is_stale_agreement_field(queryset, field_name):
                 logger.warning('Skipping stale agreement filter field: %s', field_name)
                 continue
