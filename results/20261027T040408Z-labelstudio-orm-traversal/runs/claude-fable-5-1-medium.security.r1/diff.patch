+"""This file and its contents are licensed under the Apache License 2.0. Please see the included NOTICE for copyright information and LICENSE for a copy of the license."""
+
+import json
+from urllib.parse import quote
+
+import pytest
+from projects.models import Project
+
+from ..utils import make_task, project_id  # noqa
+
+
+def _query(column, operator='contains', value='x'):
+    return quote(
+        json.dumps(
+            {
+                'filters': {
+                    'conjunction': 'and',
+                    'items': [{'filter': column, 'operator': operator, 'type': 'String', 'value': value}],
+                }
+            }
+        )
+    )
+
+
+@pytest.mark.django_db
+def test_adhoc_query_rejects_foreign_key_traversal(business_client, project_id):
+    """Ad hoc filters bypass FilterSerializer.validate_column, so apply_filters must
+    reject '__' traversals itself (ORM Leak, #5012)."""
+    project = Project.objects.get(pk=project_id)
+    task = make_task({'data': {'text': 'x'}}, project)
+    task.updated_by = project.created_by
+    task.save()
+
+    column = 'filter:tasks:updated_by__password'
+    for value in (project.created_by.password[:4], 'not-a-prefix'):
+        response = business_client.get(f'/api/tasks?project={project_id}&query={_query(column, value=value)}')
+        assert response.status_code == 400, response.content
+        assert 'DATA_MANAGER_FILTER_ALLOWLIST' in response.content.decode()
+
+
+@pytest.mark.django_db
+def test_adhoc_query_allows_data_and_allowlisted_columns(business_client, project_id):
+    project = Project.objects.get(pk=project_id)
+    make_task({'data': {'text': 'x', 'my_key': 'hello'}}, project)
+
+    response = business_client.get(f'/api/tasks?project={project_id}&query={_query("filter:tasks:data.my_key", value="hell")}')
+    assert response.status_code == 200, response.content
+    assert response.json()['total'] == 1
+
+    response = business_client.get(
+        f'/api/tasks?project={project_id}&query={_query("filter:tasks:updated_by__active_organization", "empty", "true")}'
+    )
+    assert response.status_code == 200, response.content
