+@pytest.mark.django_db
+def test_inline_query_filter_rejects_orm_traversal(business_client, project_id):
+    """Filters passed inline via `query` must get the same foreign-key traversal check as saved
+    views, otherwise `contains` on e.g. `project__created_by__email` is a per-character oracle."""
+    project = Project.objects.get(pk=project_id)
+    make_task({'data': {'text': 'x'}}, project)
+    email = project.created_by.email
+
+    def _query(column, value):
+        query = {
+            'filters': {
+                'conjunction': 'and',
+                'items': [{'filter': column, 'operator': 'contains', 'type': 'String', 'value': value}],
+            }
+        }
+        return business_client.get(f'/api/tasks?project={project_id}&query={json.dumps(query)}')
+
+    for value in (email[:3], 'no-such-prefix'):
+        response = _query('filter:tasks:project__created_by__email', value)
+        assert response.status_code == 400, response.content
+        assert 'is not generally allowed in filters' in response.content.decode()
+
+    # task.data keys and allowlisted columns keep working
+    assert _query('filter:tasks:data.text', 'x').json()['total'] == 1
+    response = business_client.get(
+        f'/api/tasks?project={project_id}&query='
+        + json.dumps(
+            {
+                'filters': {
+                    'conjunction': 'and',
+                    'items': [
+                        {
+                            'filter': 'filter:tasks:updated_by__active_organization',
+                            'operator': 'empty',
+                            'type': 'String',
+                            'value': 'true',
+                        }
+                    ],
+                }
+            }
+        )
+    )
+    assert response.status_code == 200, response.content
