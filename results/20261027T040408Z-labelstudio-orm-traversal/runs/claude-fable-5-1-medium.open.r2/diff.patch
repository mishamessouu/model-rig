--- a/label_studio/data_manager/column_names.py
+++ b/label_studio/data_manager/column_names.py
@@ -19,3 +19,43 @@ UNQUERYABLE_COLUMN_NAME_CHARACTERS = (
 def is_queryable_column_name(name: str) -> bool:
     """Whether `name` can be used as a Data Manager filter, ordering or column selector target."""
     return not UNQUERYABLE_COLUMN_NAME_PATTERN.search(name)
+
+
+FILTER_COLUMN_PREFIX = 'filter:tasks:'
+
+
+def validate_filter_column_traversal(column: str) -> None:
+    """Reject filter columns that traverse foreign keys unless explicitly allowlisted.
+
+    A filter column becomes a Django ORM lookup path. Any `__` segment outside of the
+    `task.data` JSONField can hop across relations (`project__created_by__password`, ...)
+    and turn `contains`/`regex` filters into a character-by-character oracle for data the
+    caller must not see (ORM Leak, #5012). This check is the single source of truth and must
+    run wherever a filter is compiled, not only when a view is saved, because filters also
+    arrive inline via the `query` request parameter.
+
+    Raises ValueError with a user-facing message. Edit with care.
+    """
+    from django.conf import settings
+
+    column_copy = column
+    if not column_copy.startswith(FILTER_COLUMN_PREFIX):
+        raise ValueError(f'Filter "{column}" should start with "{FILTER_COLUMN_PREFIX}"')
+    column_copy = column_copy[len(FILTER_COLUMN_PREFIX) :]
+
+    if column_copy.startswith('-'):
+        column_copy = column_copy[1:]
+
+    # `task.data` keys are JSON lookups, not foreign keys, so `__` is harmless there.
+    if column_copy.startswith('data.'):
+        return
+
+    # Specific filters relying on foreign keys can be allowlisted.
+    if column_copy in settings.DATA_MANAGER_FILTER_ALLOWLIST:
+        return
+
+    if '__' in column_copy:
+        raise ValueError(
+            f'"__" is not generally allowed in filters. Consider asking your administrator to add "{column_copy}" '
+            'to DATA_MANAGER_FILTER_ALLOWLIST, but note that some filter expressions may pose a security risk'
+        )
