@@ -0,0 +1,54 @@
+"""This file and its contents are licensed under the Apache License 2.0. Please see the included NOTICE for copyright information and LICENSE for a copy of the license."""
+
+import json
+from urllib.parse import quote
+
+import pytest
+
+from ..utils import project_id  # noqa
+
+pytestmark = pytest.mark.django_db
+
+
+def _query(filter_name, operator='empty', value='true', filter_type='String'):
+    return quote(
+        json.dumps(
+            {
+                'filters': {
+                    'conjunction': 'and',
+                    'items': [{'filter': filter_name, 'operator': operator, 'type': filter_type, 'value': value}],
+                }
+            }
+        )
+    )
+
+
+@pytest.mark.parametrize(
+    'filter_name',
+    [
+        'filter:tasks:updated_by__password',
+        'filter:tasks:annotations__completed_by__password',
+        'filter:tasks:project__organization__token',
+        'filter:tasks:data__text__foo',
+    ],
+)
+def test_adhoc_task_filter_rejects_relation_traversal(business_client, project_id, filter_name):
+    response = business_client.get(f'/api/tasks?project={project_id}&query={_query(filter_name)}')
+    assert response.status_code == 400, response.content
+    assert '__' in json.dumps(response.json())
+
+
+@pytest.mark.parametrize(
+    'filter_name, operator, value, filter_type',
+    [
+        ('filter:tasks:data.text', 'empty', 'true', 'String'),
+        ('filter:tasks:annotations__completed_by', 'equal', 1, 'Number'),
+        ('filter:tasks:updated_by__active_organization', 'equal', 1, 'Number'),
+    ],
+)
+def test_adhoc_task_filter_allows_data_and_allowlisted_columns(
+    business_client, project_id, filter_name, operator, value, filter_type
+):
+    query = _query(filter_name, operator=operator, value=value, filter_type=filter_type)
+    response = business_client.get(f'/api/tasks?project={project_id}&query={query}')
+    assert response.status_code == 200, response.content
