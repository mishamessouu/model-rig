+def validate_filter_column_traversal(raw_filter: str) -> None:
+    """Reject filter columns that traverse foreign keys (``__``) unless explicitly allowlisted.
+
+    Mirrors ``FilterSerializer.validate_column`` so that filters arriving through the ad-hoc
+    ``query`` parameter (and any other path that bypasses the view serializer) are held to the
+    same rule. Without this, ``filter:tasks:updated_by__password`` with ``regex``/``contains``
+    becomes a boolean oracle over related tables (ORM leak, see #5012).
+
+    ``task.data`` keys (``data.<key>``) are allowed because they index a JSON field, not a relation.
+    """
+    column = raw_filter
+    if column.startswith('filter:tasks:'):
+        column = column[len('filter:tasks:') :]
+    if column.startswith('-'):
+        column = column[1:]
+    if column.startswith('data.'):
+        return
+    if column in settings.DATA_MANAGER_FILTER_ALLOWLIST:
+        return
+    if '__' in column:
+        raise ValidationError(
+            f'"__" is not generally allowed in filters. Consider asking your administrator to add "{column}" '
+            'to DATA_MANAGER_FILTER_ALLOWLIST, but note that some filter expressions may pose a security risk'
+        )
+
+
 def apply_filters(queryset, filters, project, request):
