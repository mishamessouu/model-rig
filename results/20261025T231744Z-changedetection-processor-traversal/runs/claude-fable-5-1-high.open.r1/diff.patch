+    def _safe_extra_watch_config_path(data_dir, filename):
+        """
+        Resolve `filename` to a path that is guaranteed to live directly inside `data_dir`.
+
+        The filename is often derived from the watch's `processor` value, which can come
+        from user input (e.g. the import form). Reject anything that is not a plain file
+        name (path separators, '..', absolute paths) or that resolves outside data_dir,
+        so a hostile processor name can't be used to read or write arbitrary files.
+
+        Returns:
+            str: Absolute, resolved path inside data_dir, or None if the filename is unsafe.
+        """
+        import os
+
+        if not isinstance(filename, str) or not filename or filename in ('.', '..'):
+            return None
+
+        # Must be a bare file name - no directory component of any kind
+        if os.path.basename(filename) != filename or '/' in filename or '\\' in filename:
+            return None
+
+        safe_data_dir = os.path.realpath(data_dir)
+        resolved_path = os.path.realpath(os.path.join(safe_data_dir, filename))
+
+        if os.path.dirname(resolved_path) != safe_data_dir:
+            return None
+
+        return resolved_path
