+#!/usr/bin/env python3
+
+# run from dir above changedetectionio/ dir
+# python3 -m pytest changedetectionio/tests/unit/test_processor_config_path_traversal.py
+
+import json
+import os
+import tempfile
+import unittest
+
+from changedetectionio.model import Watch
+from changedetectionio.processors.base import difference_detection_processor, _safe_extra_watch_config_path
+
+
+class _FakeDatastore:
+    def __init__(self, datastore_path, watch):
+        self.datastore_path = datastore_path
+        self.data = {
+            'settings': {'application': {}, 'requests': {}},
+            'watching': {watch['uuid']: watch},
+        }
+
+
+class TestProcessorConfigPathTraversal(unittest.TestCase):
+
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.datastore_path = self.tmp.name
+        mock_datastore = {'settings': {'application': {}}, 'watching': {}}
+        self.watch = Watch.model(datastore_path=self.datastore_path, __datastore=mock_datastore, default={})
+        self.watch.ensure_data_dir_exists()
+        self.datastore = _FakeDatastore(self.datastore_path, self.watch)
+        self.processor = difference_detection_processor(self.datastore, self.watch['uuid'])
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def test_safe_path_helper_rejects_traversal(self):
+        data_dir = self.watch.data_dir
+        for bad in ['../evil.json', '../../evil.json', '/etc/evil.json', 'sub/evil.json',
+                    '..\\evil.json', '', '.', '..', 'evil\0.json', None]:
+            self.assertIsNone(_safe_extra_watch_config_path(data_dir, bad), f"Should reject {bad!r}")
+
+        good = _safe_extra_watch_config_path(data_dir, 'text_json_diff.json')
+        self.assertEqual(good, os.path.join(os.path.realpath(data_dir), 'text_json_diff.json'))
+
+    def test_update_refuses_to_write_outside_watch_dir(self):
+        # A processor name like '../../x' would otherwise write <datastore>/<uuid>/../../x.json
+        self.processor.update_extra_watch_config('../../escaped.json', {'owned': True})
+
+        escaped = os.path.join(self.datastore_path, '..', 'escaped.json')
+        self.assertFalse(os.path.exists(escaped))
+        self.assertFalse(os.path.exists(os.path.join(self.datastore_path, 'escaped.json')))
+
+        # Legitimate name still works
+        self.processor.update_extra_watch_config('text_json_diff.json', {'ok': 1})
+        with open(os.path.join(self.watch.data_dir, 'text_json_diff.json'), encoding='utf-8') as f:
+            self.assertEqual(json.load(f), {'ok': 1})
+
+    def test_get_refuses_to_read_outside_watch_dir(self):
+        outside = os.path.join(self.datastore_path, 'secret.json')
+        with open(outside, 'w', encoding='utf-8') as f:
+            json.dump({'secret': 'value'}, f)
+
+        self.assertEqual(self.processor.get_extra_watch_config('../secret.json'), {})
+        # Sanity: a file genuinely in the watch dir is readable
+        self.processor.update_extra_watch_config('restock_diff.json', {'a': 1})
+        self.assertEqual(self.processor.get_extra_watch_config('restock_diff.json'), {'a': 1})
+
+    def test_save_processor_config_with_traversal_processor_name(self):
+        from changedetectionio.processors import save_processor_config
+        self.watch['processor'] = '../../pwned'
+        save_processor_config(self.datastore, self.watch['uuid'], {'x': 'y'})
+        self.assertFalse(os.path.exists(os.path.join(self.datastore_path, '..', 'pwned.json')))
+        self.assertFalse(os.path.exists(os.path.join(self.datastore_path, 'pwned.json')))
+
+
+if __name__ == '__main__':
+    unittest.main()
