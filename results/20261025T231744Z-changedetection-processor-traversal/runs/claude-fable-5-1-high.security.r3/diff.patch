+def _safe_extra_watch_config_path(data_dir, filename):
+    """
+    Resolve `filename` inside `data_dir` and refuse anything that would escape it.
+
+    The filename is built from the watch's processor name, which can be supplied by
+    a user (e.g. the add-watch form). A value such as '../../x' must never be allowed
+    to read or write outside the watch's own data directory.
+
+    Returns the absolute path, or None if the filename is not a plain file name
+    located directly inside data_dir.
+    """
+    import os
+
+    if not isinstance(filename, str) or not filename or filename in ('.', '..'):
+        return None
+
+    # Must be a bare file name - no directory components at all
+    if filename != os.path.basename(filename) or '/' in filename or '\\' in filename or '\0' in filename:
+        return None
+
+    safe_data_dir = os.path.realpath(data_dir)
+    resolved = os.path.realpath(os.path.join(safe_data_dir, filename))
+
+    if os.path.dirname(resolved) != safe_data_dir:
+        return None
+
+    return resolved
+
