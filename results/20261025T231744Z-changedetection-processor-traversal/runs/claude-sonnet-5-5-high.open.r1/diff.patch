@@ -0,0 +1,38 @@
+#!/usr/bin/env python3
+import os
+import tempfile
+import unittest
+from types import SimpleNamespace
+
+from changedetectionio.processors.base import difference_detection_processor
+
+
+def _processor(data_dir):
+    watch = SimpleNamespace(data_dir=data_dir, ensure_data_dir_exists=lambda: os.makedirs(data_dir, exist_ok=True))
+    p = difference_detection_processor.__new__(difference_detection_processor)
+    p.watch_uuid = 'u'
+    p.datastore = SimpleNamespace(data={'watching': {'u': watch}})
+    return p
+
+
+class TestExtraWatchConfigPath(unittest.TestCase):
+    def test_traversal_filename_is_not_written_or_read(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            data_dir = os.path.join(tmp, 'watch')
+            p = _processor(data_dir)
+            p.update_extra_watch_config('../../escaped.json', {'a': 1})
+            self.assertFalse(os.path.exists(os.path.join(tmp, 'escaped.json')))
+            with open(os.path.join(tmp, 'secret.json'), 'w') as f:
+                f.write('{"a": 1}')
+            os.makedirs(data_dir, exist_ok=True)
+            self.assertEqual(p.get_extra_watch_config('../secret.json'), {})
+
+    def test_normal_filename_round_trips(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            p = _processor(os.path.join(tmp, 'watch'))
+            p.update_extra_watch_config('restock_diff.json', {'a': 1})
+            self.assertEqual(p.get_extra_watch_config('restock_diff.json'), {'a': 1})
+
+
+if __name__ == '__main__':
+    unittest.main()
