@@ -5,6 +5,33 @@ import importlib
 import inspect
 import os
 import pkgutil
+import re
+
+# Processor names end up in on-disk filenames inside the watch data directory
+# (history-<processor>.txt, <processor>.json). Only allow plain identifiers so a
+# crafted name (e.g. from a restored backup or share link) can never traverse out.
+SAFE_PROCESSOR_NAME_RE = re.compile(r'^[A-Za-z0-9_-]+$')
+
+
+def is_safe_processor_name(processor_name):
+    """
+    True if processor_name is a plain identifier safe to embed in a filename.
+
+    :param processor_name: Processor machine name (e.g., 'text_json_diff')
+    """
+    return isinstance(processor_name, str) and bool(SAFE_PROCESSOR_NAME_RE.fullmatch(processor_name))
+
+
+def processor_config_filename(processor_name):
+    """
+    Return the per-processor JSON config filename for a watch, refusing unsafe names.
+
+    :param processor_name: Processor machine name (e.g., 'image_ssim_diff')
+    :raises ValueError: if the name could escape the watch data directory
+    """
+    if not is_safe_processor_name(processor_name):
+        raise ValueError(f"Refusing to build config filename from unsafe processor name {processor_name!r}")
+    return f'{processor_name}.json'
 
