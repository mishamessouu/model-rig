diff --git a/changedetectionio/tests/unit/test_processor_name_safety.py b/changedetectionio/tests/unit/test_processor_name_safety.py
new file mode 100644
index 0000000..decf5e4
--- /dev/null
+++ b/changedetectionio/tests/unit/test_processor_name_safety.py
@@ -0,0 +1,102 @@
+#!/usr/bin/env python3
+
+# run from dir above changedetectionio/ dir
+# python3 -m unittest changedetectionio.tests.unit.test_processor_name_safety
+
+"""
+The watch 'processor' name is embedded in filenames inside the watch data directory
+(history-<processor>.txt and <processor>.json). Values that arrive from a restored
+backup, a share link or any other untrusted source must never be able to traverse
+out of that directory.
+"""
+
+import os
+import shutil
+import tempfile
+import unittest
+
+from changedetectionio import processors
+from changedetectionio.model import Watch
+from changedetectionio.store import ChangeDetectionStore
+
+TRAVERSAL_NAMES = [
+    '../../../../tmp/pwned',
+    '..',
+    'foo/bar',
+    'foo\\bar',
+    '/etc/passwd',
+    'restock_diff/../../x',
+    '',
+]
+
+SAFE_NAMES = ['text_json_diff', 'restock_diff', 'image_ssim_diff', 'osint_recon', 'plugin-name', 'Abc123']
+
+
+class TestProcessorNameSafety(unittest.TestCase):
+
+    def setUp(self):
+        self.datastore_path = tempfile.mkdtemp()
+        self.mock_datastore = {'settings': {'application': {}}, 'watching': {}}
+
+    def tearDown(self):
+        shutil.rmtree(self.datastore_path, ignore_errors=True)
+
+    def test_is_safe_processor_name(self):
+        for name in SAFE_NAMES:
+            self.assertTrue(processors.is_safe_processor_name(name), name)
+        for name in TRAVERSAL_NAMES + [None, 123]:
+            self.assertFalse(processors.is_safe_processor_name(name), repr(name))
+
+    def test_processor_config_filename(self):
+        self.assertEqual(processors.processor_config_filename('image_ssim_diff'), 'image_ssim_diff.json')
+        for name in TRAVERSAL_NAMES:
+            with self.assertRaises(ValueError, msg=repr(name)):
+                processors.processor_config_filename(name)
+
+    def test_history_index_filename_stays_inside_data_dir(self):
+        for name in SAFE_NAMES:
+            watch = Watch.model(datastore_path=self.datastore_path, __datastore=self.mock_datastore,
+                                default={'processor': name, 'url': 'http://localhost'})
+            full = os.path.realpath(os.path.join(watch.data_dir, watch.history_index_filename))
+            self.assertEqual(os.path.dirname(full), os.path.realpath(watch.data_dir))
+
+        # The constructor already reads the history index, so an unsafe name is refused
+        # before any file path is ever built
+        for name in [n for n in TRAVERSAL_NAMES if n]:
+            with self.assertRaises(ValueError, msg=repr(name)):
+                Watch.model(datastore_path=self.datastore_path, __datastore=self.mock_datastore,
+                            default={'processor': name, 'url': 'http://localhost'})
+
+    def test_add_watch_rejects_unsafe_processor(self):
+        store = ChangeDetectionStore(datastore_path=self.datastore_path, include_default_watches=False)
+        try:
+            uuid = store.add_watch(url='http://localhost', extras={'processor': '../../../../tmp/pwned'})
+            self.assertIsNone(uuid)
+            self.assertEqual(len(store.data['watching']), 0)
+            # Nothing may have been written outside the datastore
+            self.assertFalse(os.path.exists('/tmp/tmp/pwned.txt'))
+
+            uuid = store.add_watch(url='http://localhost', extras={'processor': 'text_json_diff'})
+            self.assertIsNotNone(uuid)
+        finally:
+            store.stop_thread = True
+
+    def test_rehydrate_entity_falls_back_for_unsafe_processor(self):
+        # Mirrors what backup restore / loading from disk does with untrusted watch.json data
+        store = ChangeDetectionStore(datastore_path=self.datastore_path, include_default_watches=False)
+        try:
+            entity = {'url': 'http://localhost', 'processor': '../../../../tmp/pwned'}
+            watch = store.rehydrate_entity('11111111-1111-1111-1111-111111111111', entity)
+            self.assertEqual(watch.get('processor'), 'text_json_diff')
+            self.assertEqual(watch.history_index_filename, 'history.txt')
+
+            entity = {'url': 'http://localhost', 'processor': 'restock_diff'}
+            watch = store.rehydrate_entity('22222222-2222-2222-2222-222222222222', entity)
+            self.assertEqual(watch.get('processor'), 'restock_diff')
+            self.assertEqual(watch.history_index_filename, 'history-restock_diff.txt')
+        finally:
+            store.stop_thread = True
+
+
+if __name__ == '__main__':
+    unittest.main()
