@@ -0,0 +1,85 @@
+"""
+The processor config file helpers build a filename from the watch's ``processor`` value.
+Even though that value is validated at the API/form edges, the filesystem sink must
+never let a traversal or absolute name escape the watch's own data directory.
+"""
+import json
+import os
+import tempfile
+from unittest.mock import MagicMock
+
+import pytest
+
+from changedetectionio.processors.base import (
+    difference_detection_processor,
+    resolve_extra_watch_config_path,
+)
+
+
+def _make_processor(data_dir):
+    watch = MagicMock()
+    watch.data_dir = data_dir
+    watch.ensure_data_dir_exists = lambda: os.makedirs(data_dir, exist_ok=True)
+    datastore = MagicMock()
+    datastore.data = {'watching': {'some-uuid': watch}}
+    return difference_detection_processor(datastore, 'some-uuid')
+
+
+@pytest.mark.parametrize("bad_name", [
+    "",
+    ".",
+    "..",
+    "../pwned.json",
+    "../../etc/passwd",
+    "sub/dir.json",
+    "/etc/passwd",
+    "..\\pwned.json" if os.sep == "\\" else "/tmp/pwned.json",
+    None,
+    123,
+])
+def test_unsafe_filenames_are_rejected(bad_name):
+    with tempfile.TemporaryDirectory() as data_dir:
+        assert resolve_extra_watch_config_path(data_dir, bad_name) is None
+
+
+def test_safe_filename_resolves_inside_data_dir():
+    with tempfile.TemporaryDirectory() as data_dir:
+        path = resolve_extra_watch_config_path(data_dir, "restock_diff.json")
+        assert path == os.path.join(os.path.realpath(data_dir), "restock_diff.json")
+
+
+def test_symlinked_filename_outside_data_dir_is_rejected():
+    with tempfile.TemporaryDirectory() as outside, tempfile.TemporaryDirectory() as data_dir:
+        target = os.path.join(outside, "target.json")
+        with open(target, "w") as f:
+            f.write("{}")
+        os.symlink(target, os.path.join(data_dir, "evil.json"))
+        assert resolve_extra_watch_config_path(data_dir, "evil.json") is None
+
+
+def test_update_and_get_refuse_traversal_and_do_not_touch_outside_files():
+    with tempfile.TemporaryDirectory() as root:
+        data_dir = os.path.join(root, "watch-uuid")
+        os.makedirs(data_dir)
+        processor = _make_processor(data_dir)
+
+        # A processor name of "../victim" would produce this filename
+        traversal_name = "../victim.json"
+        processor.update_extra_watch_config(traversal_name, {"owned": True})
+
+        assert not os.path.exists(os.path.join(root, "victim.json"))
+        assert os.listdir(data_dir) == []
+
+        # Reading via the same name must not leak a file that sits outside the watch dir
+        with open(os.path.join(root, "victim.json"), "w") as f:
+            json.dump({"secret": "yes"}, f)
+        assert processor.get_extra_watch_config(traversal_name) == {}
+
+
+def test_update_and_get_round_trip_for_safe_name():
+    with tempfile.TemporaryDirectory() as data_dir:
+        processor = _make_processor(data_dir)
+        processor.update_extra_watch_config("text_json_diff.json", {"a": 1})
+        processor.update_extra_watch_config("text_json_diff.json", {"b": 2})
+        assert processor.get_extra_watch_config("text_json_diff.json") == {"a": 1, "b": 2}
+        assert os.path.isfile(os.path.join(data_dir, "text_json_diff.json"))
