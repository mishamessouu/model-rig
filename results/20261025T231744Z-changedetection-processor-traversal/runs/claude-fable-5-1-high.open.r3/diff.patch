+def resolve_extra_watch_config_path(data_dir, filename):
+    """
+    Resolve a processor config filename to a path that is guaranteed to live directly
+    inside the watch's own data directory.
+
+    The filename is usually derived from the watch's ``processor`` value
+    (``f"{processor_name}.json"``). The processor name is validated at the API and form
+    edges, but this is the sink that actually touches the filesystem, so it must not
+    trust its input: a value such as ``"../../etc/foo"`` or an absolute path must never
+    be able to read or overwrite files outside the watch directory.
+
+    :param data_dir: The watch's data directory
+    :param filename: Bare filename (no directory components)
+    :return: The resolved absolute path, or None if the filename is unsafe
+    """
+    if not filename or not isinstance(filename, str):
+        logger.warning(f"Rejecting extra watch config filename {filename!r}: empty or not a string")
+        return None
+
+    # Must be a bare filename - no separators, no "." / "..", no absolute paths
+    if filename in ('.', '..') or os.path.basename(filename) != filename or os.path.isabs(filename):
+        logger.warning(f"Rejecting extra watch config filename {filename!r}: must be a bare filename")
+        return None
+
+    # Belt and braces: even a bare name must resolve to inside data_dir (also blocks symlink escapes)
+    safe_data_dir = os.path.realpath(data_dir)
+    resolved_path = os.path.realpath(os.path.join(data_dir, filename))
+    if not resolved_path.startswith(safe_data_dir + os.sep):
+        logger.warning(f"Rejecting extra watch config filename {filename!r}: resolves outside watch data dir")
+        return None
+
+    return resolved_path
+
