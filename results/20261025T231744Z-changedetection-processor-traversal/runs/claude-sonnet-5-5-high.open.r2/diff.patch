@@ -0,0 +1,51 @@
+#!/usr/bin/env python3
+"""
+add_watch() must only accept the names of installed processors.
+
+The processor name is used to build filenames inside the watch data_dir
+(history-{name}.txt, {name}.json) and reaches add_watch() from client input
+(Add Watch form, URL importer, share links), so a value like '../../x' must never stick.
+
+Run from the tests/ directory:
+    python -m unittest unit/test_add_watch_processor_validation.py
+"""
+
+import os
+import shutil
+import tempfile
+import time
+import unittest
+
+from changedetectionio.store import ChangeDetectionStore
+
+
+class TestAddWatchProcessorValidation(unittest.TestCase):
+    def setUp(self):
+        self.test_datastore_path = tempfile.mkdtemp()
+        self.store = ChangeDetectionStore(
+            datastore_path=self.test_datastore_path,
+            include_default_watches=False,
+        )
+
+    def tearDown(self):
+        self.store.stop_thread = True
+        time.sleep(0.5)
+        shutil.rmtree(self.test_datastore_path, ignore_errors=True)
+
+    def test_known_processor_is_kept(self):
+        new_uuid = self.store.add_watch(url="https://example.com", extras={'processor': 'restock_diff'})
+        self.assertEqual(self.store.data['watching'][new_uuid]['processor'], 'restock_diff')
+
+    def test_traversal_processor_is_rejected(self):
+        new_uuid = self.store.add_watch(url="https://example.com", extras={'processor': '../../evil'})
+        watch = self.store.data['watching'][new_uuid]
+        self.assertEqual(watch['processor'], 'text_json_diff')
+        self.assertEqual(watch.history_index_filename, 'history.txt')
+
+    def test_unknown_processor_is_rejected(self):
+        new_uuid = self.store.add_watch(url="https://example.com", extras={'processor': 'does_not_exist'})
+        self.assertEqual(self.store.data['watching'][new_uuid]['processor'], 'text_json_diff')
+
+
+if __name__ == '__main__':
+    unittest.main()
