+++ b/changedetectionio/tests/unit/test_extra_watch_config_path.py
@@ -0,0 +1,40 @@
+"""
+The processor config filename is built from the watch's 'processor' value
+(f'{processor_name}.json'), which can come from a restored backup or a hand-edited
+watch.json. It must never resolve outside the watch data directory.
+"""
+import json
+import os
+from types import SimpleNamespace
+
+from changedetectionio.processors.base import difference_detection_processor
+
+
+def _processor_for(data_dir):
+    watch = SimpleNamespace(data_dir=str(data_dir), ensure_data_dir_exists=lambda: os.makedirs(data_dir, exist_ok=True))
+    instance = difference_detection_processor.__new__(difference_detection_processor)
+    instance.datastore = SimpleNamespace(data={'watching': {'uuid-1': watch}})
+    instance.watch_uuid = 'uuid-1'
+    return instance
+
+
+def test_plain_filename_round_trips(tmp_path):
+    proc = _processor_for(tmp_path / 'uuid-1')
+    proc.update_extra_watch_config('restock_diff.json', {'a': 1})
+    assert proc.get_extra_watch_config('restock_diff.json') == {'a': 1}
+
+
+def test_traversal_filenames_are_refused(tmp_path):
+    data_dir = tmp_path / 'datastore' / 'uuid-1'
+    data_dir.mkdir(parents=True)
+    outside = tmp_path / 'outside.json'
+    outside.write_text(json.dumps({'secret': True}))
+
+    proc = _processor_for(data_dir)
+    for bad in ('../../outside.json', str(outside), 'sub/../../../outside.json', '..', '', 'x\x00.json'):
+        assert proc.get_extra_watch_config(bad) == {}
+        proc.update_extra_watch_config(bad, {'pwned': True})
+
+    assert json.loads(outside.read_text()) == {'secret': True}
+    assert sorted(os.listdir(tmp_path)) == ['datastore', 'outside.json']
+    assert os.listdir(data_dir) == []
