@@ -0,0 +1,85 @@
+#!/usr/bin/env python3
+"""
+Regression tests: processor-specific extra config files must never escape the
+watch's data_dir, even if the watch's 'processor' value (used as the filename)
+contains path traversal or an absolute path.
+
+Run from the tests/ directory:
+    python -m unittest unit/test_processor_config_path_traversal.py
+"""
+
+import json
+import os
+import shutil
+import tempfile
+import time
+import unittest
+
+from changedetectionio.store import ChangeDetectionStore
+from changedetectionio.processors.base import difference_detection_processor
+from changedetectionio import processors
+
+
+class TestProcessorConfigPathTraversal(unittest.TestCase):
+    def setUp(self):
+        self.datastore_path = tempfile.mkdtemp()
+        self.store = ChangeDetectionStore(datastore_path=self.datastore_path, include_default_watches=False)
+        self.uuid = self.store.add_watch(url='https://example.com', extras={'processor': 'text_json_diff'})
+        self.watch = self.store.data['watching'][self.uuid]
+        self.processor = difference_detection_processor(self.store, self.uuid)
+
+    def tearDown(self):
+        self.store.stop_thread = True
+        time.sleep(0.5)
+        shutil.rmtree(self.datastore_path, ignore_errors=True)
+
+    def test_safe_filename_round_trips(self):
+        self.processor.update_extra_watch_config('restock_diff.json', {'a': 1})
+        self.assertTrue(os.path.isfile(os.path.join(self.watch.data_dir, 'restock_diff.json')))
+        self.assertEqual(self.processor.get_extra_watch_config('restock_diff.json'), {'a': 1})
+
+    def test_traversal_filenames_rejected_on_write(self):
+        bad_names = [
+            '../evil.json',
+            '../../evil.json',
+            '..',
+            '.',
+            '/tmp/evil.json',
+            'sub/dir.json',
+            'back\\slash.json',
+            'nul\x00byte.json',
+            '',
+        ]
+        for name in bad_names:
+            with self.subTest(name=name):
+                with self.assertRaises(ValueError):
+                    self.processor.update_extra_watch_config(name, {'owned': True})
+        # Nothing escaped into the datastore root
+        self.assertFalse(os.path.exists(os.path.join(self.datastore_path, 'evil.json')))
+        self.assertFalse(os.path.exists(os.path.join(os.path.dirname(self.datastore_path), 'evil.json')))
+        self.assertFalse(os.path.exists('/tmp/evil.json'))
+
+    def test_traversal_filenames_rejected_on_read(self):
+        # Plant a file one level up that must NOT be readable through the watch helper
+        with open(os.path.join(self.datastore_path, 'secret.json'), 'w', encoding='utf-8') as f:
+            json.dump({'secret': 'yes'}, f)
+        self.assertEqual(self.processor.get_extra_watch_config('../secret.json'), {})
+        self.assertEqual(self.processor.get_extra_watch_config('/etc/passwd'), {})
+
+    def test_save_processor_config_with_malicious_processor_name_does_not_escape(self):
+        # Simulate a watch whose 'processor' value carries a traversal payload
+        self.watch['processor'] = '../../url-watches'
+        ok = processors.save_processor_config(self.store, self.uuid, {'owned': True})
+        self.assertFalse(ok)
+        # Nothing was written outside the watch's own directory
+        self.assertFalse(os.path.exists(os.path.join(os.path.dirname(self.datastore_path), 'url-watches.json')))
+        self.assertFalse(os.path.exists(os.path.join(self.datastore_path, 'url-watches.json')))
+        # And nothing was written into the watch directory under the mangled name either
+        self.assertEqual(
+            [f for f in os.listdir(self.watch.data_dir) if 'owned' in open(os.path.join(self.watch.data_dir, f), 'rb').read().decode('utf-8', 'ignore')],
+            [],
+        )
+
+
+if __name__ == '__main__':
+    unittest.main()
