+    @staticmethod
+    def _safe_extra_watch_config_path(data_dir, filename):
+        """
+        Resolve an extra-config filename to a path that is guaranteed to live directly
+        inside the watch's data_dir.
+
+        The filename is often derived from the watch's 'processor' value, which can arrive
+        from the API, imports, shared-watch metadata or plugins, so it must never be allowed
+        to escape the watch directory (e.g. '../../url-watches.json' or an absolute path).
+
+        Raises ValueError if the filename is not a plain, single-component file name or the
+        resolved path is not inside data_dir.
+        """
+        import os
+
+        if not isinstance(filename, str) or not filename.strip():
+            raise ValueError("extra watch config filename must be a non-empty string")
+
+        # Must be a single path component, no separators, no traversal, no NULs
+        if (filename in ('.', '..')
+                or os.path.isabs(filename)
+                or os.path.basename(filename) != filename
+                or '/' in filename or '\\' in filename
+                or '\x00' in filename):
+            raise ValueError(f"Unsafe extra watch config filename rejected: {filename!r}")
+
+        base_real = os.path.realpath(data_dir)
+        full_real = os.path.realpath(os.path.join(data_dir, filename))
+        if os.path.dirname(full_real) != base_real:
+            raise ValueError(f"Extra watch config path escapes watch data_dir: {filename!r}")
+
+        return os.path.join(data_dir, filename)
+
