diff --git a/src/backend/InvenTree/common/api.py b/src/backend/InvenTree/common/api.py
index 489530c..9d2674a 100644
--- a/src/backend/InvenTree/common/api.py
+++ b/src/backend/InvenTree/common/api.py
@@ -796,6 +796,30 @@ class AttachmentMixin:
     serializer_class = common.serializers.AttachmentSerializer
     permission_classes = [IsAuthenticatedOrReadScope]
 
+    def get_queryset(self):
+        """Only return attachments for model types the user has permission to view.
+
+        Write operations perform their own (stricter) permission checks.
+        """
+        from rest_framework.permissions import SAFE_METHODS
+
+        from common.validators import attachment_model_types
+
+        queryset = super().get_queryset()
+
+        if self.request.method not in SAFE_METHODS:
+            return queryset
+
+        user = self.request.user
+
+        allowed_types = [
+            model.__name__.lower()
+            for model in attachment_model_types()
+            if model.check_related_permission('view', user)
+        ]
+
+        return queryset.filter(model_type__in=allowed_types)
+
 
 class AttachmentList(AttachmentMixin, BulkDeleteMixin, ListCreateAPI):
     """List API endpoint for Attachment objects."""
