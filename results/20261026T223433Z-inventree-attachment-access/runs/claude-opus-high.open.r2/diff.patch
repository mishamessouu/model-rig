@@ -1062,6 +1062,40 @@ class AttachmentAPITests(InvenTreeAPITestCase):
             # Ensure that the file associated with each attachment has been removed
             self.assertFalse(default_storage.exists(att.attachment.path))
 
+    def test_attachment_view_permission(self):
+        """Attachments are only visible to users who can view the linked model."""
+        from common.models import Attachment
+        from part.models import Part
+
+        part = Part.objects.create(name='Test Part', description='A part for testing')
+
+        att = Attachment.objects.create(
+            model_type='part',
+            model_id=part.pk,
+            link='https://www.example.com/secret',
+            comment='Secret attachment',
+        )
+
+        list_url = reverse('api-attachment-list')
+        detail_url = reverse('api-attachment-detail', kwargs={'pk': att.pk})
+
+        # Without 'view' permission, the attachment is hidden
+        self.clearRoles()
+
+        response = self.get(list_url, {'model_type': 'part'}, expected_code=200)
+        self.assertEqual(len(response.data), 0)
+
+        self.get(detail_url, expected_code=404)
+
+        # With 'view' permission, the attachment is visible
+        self.assignRole('part.view')
+
+        response = self.get(list_url, {'model_type': 'part'}, expected_code=200)
+        self.assertIn(att.pk, [item['pk'] for item in response.data])
+
+        response = self.get(detail_url, expected_code=200)
+        self.assertEqual(response.data['comment'], 'Secret attachment')
+
 
