@@ -32,7 +32,7 @@ from pint._typing import UnitLike
 from rest_framework import serializers, viewsets
 from rest_framework.decorators import action
 from rest_framework.exceptions import NotAcceptable, NotFound, PermissionDenied
-from rest_framework.permissions import IsAdminUser, IsAuthenticated
+from rest_framework.permissions import SAFE_METHODS, IsAdminUser, IsAuthenticated
 from rest_framework.response import Response
 from rest_framework.views import APIView
 from sql_util.utils import SubqueryCount
@@ -796,6 +796,33 @@ class AttachmentMixin:
     serializer_class = common.serializers.AttachmentSerializer
     permission_classes = [IsAuthenticatedOrReadScope]
 
+    def get_queryset(self):
+        """Limit attachments to those linked to models the user can view.
+
+        Write operations perform their own (more specific) permission checks.
+        """
+        from common.validators import attachment_model_types
+
+        queryset = super().get_queryset()
+
+        request = getattr(self, 'request', None)
+
+        if request is not None and request.method not in SAFE_METHODS:
+            return queryset
+
+        user = getattr(request, 'user', None)
+
+        if not user or not user.is_authenticated:
+            return queryset.none()
+
+        allowed_types = [
+            model.__name__.lower()
+            for model in attachment_model_types()
+            if model.check_related_permission('view', user)
+        ]
+
+        return queryset.filter(model_type__in=allowed_types)
+
 
 class AttachmentList(AttachmentMixin, BulkDeleteMixin, ListCreateAPI):
