diff --git a/src/backend/InvenTree/common/api.py b/src/backend/InvenTree/common/api.py
index 489530c..ce976be 100644
--- a/src/backend/InvenTree/common/api.py
+++ b/src/backend/InvenTree/common/api.py
@@ -796,6 +796,43 @@ class AttachmentMixin:
     serializer_class = common.serializers.AttachmentSerializer
     permission_classes = [IsAuthenticatedOrReadScope]
 
+    def filter_queryset(self, queryset):
+        """Restrict read access to attachments the user is permitted to view.
+
+        An attachment inherits its permissions from the model it is attached to.
+        For read requests, only return attachments linked to model types for which
+        the user has 'view' permission - otherwise any authenticated user could
+        enumerate (and download) attachments for models they cannot otherwise access.
+
+        Write requests (change / delete) are explicitly checked against the target
+        model elsewhere, and are not filtered here (so that they return 403, not 404).
+        """
+        from rest_framework.permissions import SAFE_METHODS
+
+        from common.validators import attachment_model_types
+        from users.permissions import check_user_permission
+
+        queryset = super().filter_queryset(queryset)
+
+        if self.request.method not in SAFE_METHODS:
+            return queryset
+
+        user = getattr(self.request, 'user', None)
+
+        if user is None or not user.is_authenticated:
+            return queryset.none()
+
+        if user.is_superuser:
+            return queryset
+
+        allowed_models = [
+            model.__name__.lower()
+            for model in attachment_model_types()
+            if check_user_permission(user, model, 'view')
+        ]
+
+        return queryset.filter(model_type__in=allowed_models)
+
 
 class AttachmentList(AttachmentMixin, BulkDeleteMixin, ListCreateAPI):
     """List API endpoint for Attachment objects."""
