@@ -796,6 +797,38 @@ class AttachmentMixin:
     serializer_class = common.serializers.AttachmentSerializer
     permission_classes = [IsAuthenticatedOrReadScope]
 
+    def get_queryset(self):
+        """Hide attachments for models which the user is not allowed to view.
+
+        Write requests are not filtered here, as the detail view performs its own
+        (explicit) permission checks against the target model.
+        """
+        from users.permissions import check_user_permission
+
+        queryset = super().get_queryset()
+
+        if self.request.method not in SAFE_METHODS:
+            return queryset
+
+        user = getattr(self.request, 'user', None)
+
+        if not user or not user.is_authenticated:
+            return queryset.none()
+
+        hidden = []
+
+        for model_class in common.validators.attachment_model_types():
+            if not (
+                check_user_permission(user, model_class, 'view')
+                and model_class.check_related_permission('view', user)
+            ):
+                hidden.append(model_class.__name__.lower())
+
+        if hidden:
+            queryset = queryset.exclude(model_type__in=hidden)
+
+        return queryset
+
 
