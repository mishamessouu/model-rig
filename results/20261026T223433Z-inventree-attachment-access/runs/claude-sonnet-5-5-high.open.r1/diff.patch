+    def test_view_permission(self):
+        """Attachments are only visible to users who can view the target model."""
+        from common.models import Attachment
+        from part.models import Part
+        from stock.models import StockItem
+
+        part = Part.objects.create(name='Visible Part', description='A part')
+        item = StockItem.objects.create(part=part, quantity=1)
+
+        att_part = Attachment.objects.create(
+            model_type='part', model_id=part.pk, link='https://example.com/part'
+        )
+        att_item = Attachment.objects.create(
+            model_type='stockitem', model_id=item.pk, link='https://example.com/item'
+        )
+
+        list_url = reverse('api-attachment-list')
+        part_url = reverse('api-attachment-detail', kwargs={'pk': att_part.pk})
+        item_url = reverse('api-attachment-detail', kwargs={'pk': att_item.pk})
+
+        # No roles: nothing is visible
+        self.assertEqual(len(self.get(list_url, expected_code=200).data), 0)
+        self.get(part_url, expected_code=404)
+        self.get(item_url, expected_code=404)
+
+        # The 'part' role exposes only part attachments
+        self.assignRole('part.view')
+
+        data = self.get(list_url, expected_code=200).data
+        self.assertEqual([item['pk'] for item in data], [att_part.pk])
+        self.get(part_url, expected_code=200)
+        self.get(item_url, expected_code=404)
+
+        # Filtering explicitly by an inaccessible model type returns nothing
+        self.assertEqual(
+            len(self.get(list_url, {'model_type': 'stockitem'}).data), 0
+        )
+
+        # The 'stock' role exposes stock item attachments
+        self.assignRole('stock.view')
+        self.get(item_url, expected_code=200)
+
+
