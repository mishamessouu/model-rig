     serializer_class = common.serializers.AttachmentSerializer
     permission_classes = [IsAuthenticatedOrReadScope]
 
+    def filter_queryset(self, queryset):
+        """Restrict read access to attachments the user is permitted to view.
+
+        The Attachment model itself does not carry any permissions - access is
+        derived from the model the attachment is linked to. Write access is already
+        enforced by the serializer (create) and the detail view (update / delete),
+        so here we only filter *read* requests, hiding any attachment linked to a
+        model type for which the user does not have 'view' permission.
+        """
+        from InvenTree.models import InvenTreeAttachmentMixin
+        from users.permissions import check_user_permission
+
+        queryset = super().filter_queryset(queryset)
+
+        if self.request.method not in SAFE_METHODS:
+            return queryset
+
+        user = self.request.user
+
+        allowed_model_types = [
+            model_class.__name__.lower()
+            for model_class in common.validators.attachment_model_types()
+            if issubclass(model_class, InvenTreeAttachmentMixin)
+            and check_user_permission(user, model_class, 'view')
+            and model_class.check_related_permission('view', user)
+        ]
+
+        return queryset.filter(model_type__in=allowed_model_types)
+
 
