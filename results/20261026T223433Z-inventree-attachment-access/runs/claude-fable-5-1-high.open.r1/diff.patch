+    def test_read_via_api(self):
+        """Test that attachments are only visible to users who can view the linked model.
+
+        The Attachment model itself has no permissions - read access must be derived
+        from the 'view' permission of the model the attachment is linked to.
+        """
+        part = Part.objects.first()
+
+        attachment = Attachment.objects.create(
+            link='https://www.example.org',
+            comment='Read permission test',
+            model_type='part',
+            model_id=part.pk,
+        )
+
+        list_url = reverse('api-attachment-list')
+        detail_url = reverse('api-attachment-detail', kwargs={'pk': attachment.pk})
+
+        self.user.is_staff = False
+        self.user.is_superuser = False
+        self.user.save()
+        self.clearRoles()
+
+        # Without 'part.view' the attachment must be hidden entirely
+        response = self.get(list_url, expected_code=200)
+        self.assertEqual(len(response.data), 0)
+
+        response = self.get(list_url, {'model_type': 'part'}, expected_code=200)
+        self.assertEqual(len(response.data), 0)
+
+        self.get(detail_url, expected_code=404)
+
+        # Permissions against an unrelated model do not grant access
+        self.assignRole('stock.view')
+
+        response = self.get(list_url, expected_code=200)
+        self.assertEqual(len(response.data), 0)
+
+        self.get(detail_url, expected_code=404)
+
+        # With 'part.view' the attachment becomes visible
+        self.assignRole('part.view')
+
+        response = self.get(list_url, expected_code=200)
+        self.assertEqual(len(response.data), 1)
+        self.assertEqual(response.data[0]['pk'], attachment.pk)
+
+        response = self.get(detail_url, expected_code=200)
+        self.assertEqual(response.data['pk'], attachment.pk)
+        self.assertEqual(response.data['comment'], 'Read permission test')
+
+        # A superuser can always view attachments
+        self.clearRoles()
+        self.user.is_superuser = True
+        self.user.save()
+
+        response = self.get(list_url, expected_code=200)
+        self.assertEqual(len(response.data), 1)
+
