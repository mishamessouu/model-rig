+    def test_view_permission_via_api(self):
+        """Test that attachments are only visible to users who can view the related model.
+
+        - A user without 'view' permission for a model must not be able to list
+          or retrieve attachments which are linked to that model type.
+        """
+        from company.models import Company
+
+        part = Part.objects.first()
+        company = Company.objects.create(name='Attachment Co', is_supplier=True)
+
+        part_attachment = Attachment.objects.create(
+            link='https://www.example.com/part',
+            comment='Part attachment',
+            model_type='part',
+            model_id=part.pk,
+        )
+
+        company_attachment = Attachment.objects.create(
+            link='https://www.example.com/company',
+            comment='Company attachment',
+            model_type='company',
+            model_id=company.pk,
+        )
+
+        list_url = reverse('api-attachment-list')
+        part_url = reverse('api-attachment-detail', kwargs={'pk': part_attachment.pk})
+        company_url = reverse(
+            'api-attachment-detail', kwargs={'pk': company_attachment.pk}
+        )
+
+        self.user.is_staff = False
+        self.user.is_superuser = False
+        self.user.save()
+        self.clearRoles()
+
+        # Without any roles, no attachments should be visible
+        response = self.get(list_url, expected_code=200)
+        self.assertEqual(len(response.data), 0)
+
+        self.get(part_url, expected_code=404)
+        self.get(company_url, expected_code=404)
+
+        # Grant 'view' permission for the 'part' model only
+        self.assignRole('part.view')
+
+        response = self.get(list_url, expected_code=200)
+        self.assertEqual(len(response.data), 1)
+        self.assertEqual(response.data[0]['pk'], part_attachment.pk)
+
+        # Explicitly filtering by model type must not leak hidden attachments
+        response = self.get(list_url, {'model_type': 'company'}, expected_code=200)
+        self.assertEqual(len(response.data), 0)
+
+        self.get(part_url, expected_code=200)
+        self.get(company_url, expected_code=404)
+
+        # Hidden attachments cannot be edited or deleted either
+        self.patch(company_url, {'comment': 'Changed'}, expected_code=404)
+        self.delete(company_url, expected_code=404)
+
+        # Grant 'view' permission for the 'company' model (via purchase orders)
+        self.assignRole('purchase_order.view')
+
+        response = self.get(list_url, expected_code=200)
+        self.assertEqual(len(response.data), 2)
+
+        self.get(part_url, expected_code=200)
+        self.get(company_url, expected_code=200)
+
