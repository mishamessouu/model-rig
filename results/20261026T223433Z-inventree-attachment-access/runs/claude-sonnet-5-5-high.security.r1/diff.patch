+    def get_queryset(self):
+        """Limit read access to attachments for models the user is allowed to view.
+
+        Write operations are checked separately against the relevant model permissions.
+        """
+        from InvenTree.models import InvenTreeAttachmentMixin
+
+        queryset = super().get_queryset()
+        user = self.request.user if self.request else None
+
+        if (
+            getattr(self, 'swagger_fake_view', False)
+            or not user
+            or self.request.method not in SAFE_METHODS
+        ):
+            return queryset
+
+        viewable = [
+            model.__name__.lower()
+            for model in common.validators.attachment_model_types()
+            if issubclass(model, InvenTreeAttachmentMixin)
+            and model.check_related_permission('view', user)
+        ]
+
+        return queryset.filter(model_type__in=viewable)
+
 
