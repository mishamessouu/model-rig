+    def test_view_permission(self):
+        """Attachments are only visible to users with 'view' access to the target model."""
+        from common.models import Attachment
+        from part.models import Part
+        from stock.models import StockLocation
+
+        part = Part.objects.create(name='Test Part', description='A part for testing')
+        location = StockLocation.objects.create(name='Loc', description='Location')
+
+        pa = Attachment.objects.create(
+            model_type='part', model_id=part.pk, link='https://example.com/part'
+        )
+        sa = Attachment.objects.create(
+            model_type='stocklocation',
+            model_id=location.pk,
+            link='https://example.com/location',
+        )
+
+        list_url = reverse('api-attachment-list')
+
+        # Authenticated, but without any roles
+        self.assertEqual(len(self.get(list_url, expected_code=200).data), 0)
+        self.get(
+            reverse('api-attachment-detail', kwargs={'pk': pa.pk}), expected_code=404
+        )
+
+        # Grant access to parts only
+        self.assignRole('part.view')
+
+        response = self.get(list_url, expected_code=200)
+        self.assertEqual([a['pk'] for a in response.data], [pa.pk])
+
+        self.get(
+            reverse('api-attachment-detail', kwargs={'pk': pa.pk}), expected_code=200
+        )
+        self.get(
+            reverse('api-attachment-detail', kwargs={'pk': sa.pk}), expected_code=404
+        )
+
+
