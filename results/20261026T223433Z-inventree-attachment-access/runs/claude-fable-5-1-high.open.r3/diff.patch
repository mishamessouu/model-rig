 class AttachmentTest(InvenTreeAPITestCase):
     """Unit tests for the Attachment API endpoint."""
 
-    fixtures = ['category', 'part', 'location']
+    fixtures = [
+        'category',
+        'part',
+        'location',
+        'company',
+        'manufacturer_part',
+        'supplier_part',
+        'order',
+    ]
+
+    def test_view_permissions(self):
+        """Test that attachments are only visible for models the user can view."""
+        list_url = reverse('api-attachment-list')
+        link = 'https://www.inventree.org/'
+
+        part_attachment = Attachment.objects.create(
+            model_type='part', model_id=1, link=link, comment='Part attachment'
+        )
+        order_attachment = Attachment.objects.create(
+            model_type='purchaseorder', model_id=1, link=link, comment='PO attachment'
+        )
+
+        part_url = reverse('api-attachment-detail', kwargs={'pk': part_attachment.pk})
+        order_url = reverse('api-attachment-detail', kwargs={'pk': order_attachment.pk})
+
+        # Without any 'view' permissions, no attachments are visible
+        self.clearRoles()
+        response = self.get(list_url, expected_code=200)
+        self.assertEqual(len(response.data), 0)
+        self.get(part_url, expected_code=404)
+        self.get(order_url, expected_code=404)
+
+        # Grant 'view' permission for the Part model only
+        self.assignRole('part.view')
+        response = self.get(list_url, expected_code=200)
+        pks = [item['pk'] for item in response.data]
+        self.assertIn(part_attachment.pk, pks)
+        self.assertNotIn(order_attachment.pk, pks)
+        self.get(part_url, expected_code=200)
+        self.get(order_url, expected_code=404)
+
+        # Filtering by an unviewable model type must not leak anything either
+        response = self.get(
+            list_url, {'model_type': 'purchaseorder'}, expected_code=200
+        )
+        self.assertEqual(len(response.data), 0)
+
+        # Grant 'view' permission for the PurchaseOrder model too
+        self.assignRole('purchase_order.view')
+        response = self.get(list_url, expected_code=200)
+        pks = [item['pk'] for item in response.data]
+        self.assertIn(part_attachment.pk, pks)
+        self.assertIn(order_attachment.pk, pks)
+        self.get(order_url, expected_code=200)
 
