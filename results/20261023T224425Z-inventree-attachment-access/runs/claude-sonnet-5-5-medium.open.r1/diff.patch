@@ -806,6 +806,35 @@ class AttachmentList(AttachmentMixin, BulkDeleteMixin, ListCreateAPI):
     ordering_fields = ['model_id', 'model_type', 'upload_date', 'file_size']
     search_fields = ['comment', 'model_id', 'model_type']
 
+    def get_queryset(self):
+        """Restrict attachments to model types the user is permitted to view."""
+        from common.validators import attachment_model_class_from_label
+        from InvenTree.models import InvenTreeAttachmentMixin
+        from users.permissions import check_user_permission
+
+        queryset = super().get_queryset()
+        user = self.request.user
+
+        if user.is_superuser:
+            return queryset
+
+        denied = []
+
+        model_types = queryset.order_by().values_list('model_type', flat=True)
+
+        for model_type in model_types.distinct():
+            model_class = attachment_model_class_from_label(model_type)
+
+            if (
+                model_class is None
+                or not issubclass(model_class, InvenTreeAttachmentMixin)
+                or not check_user_permission(user, model_class, 'view')
+                or not model_class.check_related_permission('view', user)
+            ):
+                denied.append(model_type)
+
+        return queryset.exclude(model_type__in=denied) if denied else queryset
+
     def perform_create(self, serializer):
         """Save the user information when a file is uploaded."""
         serializer.save(upload_user=self.request.user)
