+@pytest.mark.parametrize(
+    "client",
+    [{"MLFLOW_AUTH_CONFIG_PATH": "fixtures/no_permission_auth.ini"}],
+    indirect=True,
+)
+def test_graphql_run_model_versions_filtered_by_model_permission(client, monkeypatch):
+    username1, password1 = create_user(client.tracking_uri)
+    username2, password2 = create_user(client.tracking_uri)
+    readable_model = "gql_run_mv_readable"
+    hidden_model = "gql_run_mv_hidden"
+
+    with User(username1, password1, monkeypatch):
+        experiment_id = client.create_experiment("gql_run_mv_exp")
+        run_id = client.create_run(experiment_id).info.run_id
+        for name in (readable_model, hidden_model):
+            client.create_registered_model(name)
+            client.create_model_version(name, f"runs:/{run_id}/model", run_id=run_id)
+        # user2 can read the run (via its experiment) but only one of the linked models.
+        grant_role_permission(client.tracking_uri, username2, "experiment", experiment_id, "READ")
+        grant_role_permission(
+            client.tracking_uri, username2, "registered_model", readable_model, "READ"
+        )
+
+    # ``run.modelVersions`` is resolved by the schema extension, not by the top-level
+    # ``mlflowSearchModelVersions`` field, so cover both entry points that expose it.
+    query = """
+    query($runId: String!, $expIds: [String]!) {
+        mlflowGetRun(input: {runId: $runId}) {
+            run { modelVersions { name version } }
+        }
+        mlflowSearchRuns(input: {experimentIds: $expIds}) {
+            runs { modelVersions { name version } }
+        }
+    }
+    """
+    variables = {"runId": run_id, "expIds": [experiment_id]}
+
+    def _model_names(auth):
+        response = _graphql_query(client.tracking_uri, query, variables=variables, auth=auth)
+        assert response.status_code == 200
+        payload = response.json()
+        assert payload.get("errors") in (None, [])
+        get_run_names = {
+            mv["name"] for mv in payload["data"]["mlflowGetRun"]["run"]["modelVersions"]
+        }
+        search_runs_names = {
+            mv["name"]
+            for run in payload["data"]["mlflowSearchRuns"]["runs"]
+            for mv in run["modelVersions"]
+        }
+        return get_run_names, search_runs_names
+
+    all_models = {readable_model, hidden_model}
+    assert _model_names((username1, password1)) == (all_models, all_models)
+    assert _model_names((username2, password2)) == ({readable_model}, {readable_model})
+
+
