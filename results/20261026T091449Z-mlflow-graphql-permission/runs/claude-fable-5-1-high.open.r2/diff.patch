diff --git a/tests/server/auth/test_client_workspace.py b/tests/server/auth/test_client_workspace.py
index f35fb1a..d140881 100644
--- a/tests/server/auth/test_client_workspace.py
+++ b/tests/server/auth/test_client_workspace.py
@@ -343,3 +343,68 @@ def test_registered_model_access_controls_across_workspaces(workspace_setup, mon
     )
     assert resp.status_code == 403
     assert "Permission denied" in resp.text
+
+
+def _graphql_get_run_model_versions(
+    tracking_uri: str, workspace_name: str, auth: tuple[str, str], run_id: str
+):
+    query = """
+    query GetRun($input: MlflowGetRunInput){
+      mlflowGetRun(input: $input){
+        run { modelVersions { name version } }
+      }
+    }
+    """
+    resp = requests.post(
+        f"{tracking_uri}/graphql",
+        json={"query": query, "variables": {"input": {"runId": run_id}}},
+        auth=auth,
+        headers={WORKSPACE_HEADER_NAME: workspace_name},
+    )
+    resp.raise_for_status()
+    payload = resp.json()
+    assert payload.get("errors") in (None, [])
+    return payload["data"]["mlflowGetRun"]["run"]["modelVersions"]
+
+
+def test_graphql_run_model_versions_filtered_by_workspace_model_grant(
+    workspace_setup, monkeypatch
+):
+    client, tracking_uri, workspace_a, username, password = workspace_setup
+    grant_role_permission(tracking_uri, username, "workspace", "*", "MANAGE", workspace=workspace_a)
+
+    exp_a = _create_experiment(tracking_uri, workspace_a, auth=(username, password))
+    run_a = _create_run(tracking_uri, workspace_a, exp_a, auth=(username, password))
+    readable_model = f"model-readable-{random_str()}"
+    hidden_model = f"model-hidden-{random_str()}"
+    for model_name in (readable_model, hidden_model):
+        _create_registered_model(tracking_uri, workspace_a, model_name, auth=(username, password))
+        _create_model_version(
+            tracking_uri, workspace_a, model_name, run_a, auth=(username, password)
+        )
+
+    # Limited user can read the run's experiment but holds a grant on only one of the
+    # models linked to that run; ``run.modelVersions`` must honor the model grants.
+    limited_user, limited_password = create_user(tracking_uri)
+    grant_role_permission(
+        tracking_uri, limited_user, "experiment", exp_a, "READ", workspace=workspace_a
+    )
+    grant_role_permission(
+        tracking_uri,
+        limited_user,
+        "registered_model",
+        readable_model,
+        "READ",
+        workspace=workspace_a,
+    )
+
+    versions = _graphql_get_run_model_versions(
+        tracking_uri, workspace_a, auth=(limited_user, limited_password), run_id=run_a
+    )
+    assert {v["name"] for v in versions} == {readable_model}
+
+    # The workspace admin still sees every linked version.
+    versions = _graphql_get_run_model_versions(
+        tracking_uri, workspace_a, auth=(username, password), run_id=run_a
+    )
+    assert {v["name"] for v in versions} == {readable_model, hidden_model}
