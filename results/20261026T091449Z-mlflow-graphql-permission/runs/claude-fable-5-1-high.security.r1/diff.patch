diff --git a/tests/server/auth/test_client_workspace.py b/tests/server/auth/test_client_workspace.py
index f35fb1a..64ea587 100644
--- a/tests/server/auth/test_client_workspace.py
+++ b/tests/server/auth/test_client_workspace.py
@@ -343,3 +343,58 @@ def test_registered_model_access_controls_across_workspaces(workspace_setup, mon
     )
     assert resp.status_code == 403
     assert "Permission denied" in resp.text
+
+
+def _graphql_get_run_model_versions(
+    tracking_uri: str, workspace_name: str, auth: tuple[str, str], run_id: str
+):
+    query = """
+    query GetRun($input: MlflowGetRunInput){
+      mlflowGetRun(input: $input){
+        run { info { runId } modelVersions { name version } }
+      }
+    }
+    """
+    variables = {"input": {"runId": run_id}}
+    resp = requests.post(
+        f"{tracking_uri}/graphql",
+        json={"query": query, "variables": variables},
+        auth=auth,
+        headers={WORKSPACE_HEADER_NAME: workspace_name},
+    )
+    resp.raise_for_status()
+    payload = resp.json()
+    assert payload.get("errors") in (None, [])
+    run = payload["data"]["mlflowGetRun"]["run"]
+    assert run["info"]["runId"] == run_id
+    return run["modelVersions"]
+
+
+def test_graphql_run_model_versions_filtered_by_registered_model_permission(workspace_setup):
+    client, tracking_uri, workspace, username, password = workspace_setup
+    grant_role_permission(tracking_uri, username, "workspace", "*", "MANAGE", workspace=workspace)
+
+    exp = _create_experiment(tracking_uri, workspace, auth=(username, password))
+    run = _create_run(tracking_uri, workspace, exp, auth=(username, password))
+    model = f"model-{random_str()}"
+    _create_registered_model(tracking_uri, workspace, model, auth=(username, password))
+    _create_model_version(tracking_uri, workspace, model, run, auth=(username, password))
+
+    # A user who can read the experiment but holds no registered-model grant must not see
+    # the model versions linked to the run through the nested GraphQL field.
+    limited_user, limited_password = create_user(tracking_uri)
+    grant_role_permission(
+        tracking_uri, limited_user, "experiment", exp, "READ", workspace=workspace
+    )
+    versions = _graphql_get_run_model_versions(
+        tracking_uri, workspace, auth=(limited_user, limited_password), run_id=run
+    )
+    assert versions == []
+
+    grant_role_permission(
+        tracking_uri, limited_user, "registered_model", model, "READ", workspace=workspace
+    )
+    versions = _graphql_get_run_model_versions(
+        tracking_uri, workspace, auth=(limited_user, limited_password), run_id=run
+    )
+    assert [(v["name"], v["version"]) for v in versions] == [(model, "1")]
