diff --git a/tests/server/auth/test_auth.py b/tests/server/auth/test_auth.py
index f3df01e..cc80f49 100644
--- a/tests/server/auth/test_auth.py
+++ b/tests/server/auth/test_auth.py
@@ -1530,6 +1530,66 @@ def test_graphql_search_model_versions(client, monkeypatch):
     assert names == [f"gql_mv_model{i}" for i in readable]
 
 
+@pytest.mark.parametrize(
+    "client",
+    [{"MLFLOW_AUTH_CONFIG_PATH": "fixtures/no_permission_auth.ini"}],
+    indirect=True,
+)
+def test_graphql_run_model_versions_filtered_by_registered_model_permission(
+    client, monkeypatch
+):
+    username1, password1 = create_user(client.tracking_uri)
+    username2, password2 = create_user(client.tracking_uri)
+
+    readable = [0, 2]
+
+    with User(username1, password1, monkeypatch):
+        experiment_id = client.create_experiment("gql_run_mv_test_exp")
+        run = client.create_run(experiment_id)
+        run_id = run.info.run_id
+        client.set_terminated(run_id)
+        for i in range(4):
+            rm = client.create_registered_model(f"gql_run_mv_model{i}")
+            client.create_model_version(rm.name, f"runs:/{run_id}/model", run_id=run_id)
+            if i in readable:
+                grant_role_permission(
+                    client.tracking_uri, username2, "registered_model", rm.name, "READ"
+                )
+        # user2 may read the run, but holds grants on only some of its registered models.
+        grant_role_permission(client.tracking_uri, username2, "experiment", experiment_id, "READ")
+
+    query = """
+    query($runId: String!) {
+        mlflowGetRun(input: {runId: $runId}) {
+            run {
+                info { runId }
+                modelVersions { name version }
+            }
+        }
+    }
+    """
+
+    resp = _graphql_query(
+        client.tracking_uri, query, variables={"runId": run_id}, auth=(username1, password1)
+    )
+    resp.raise_for_status()
+    payload = resp.json()
+    assert payload.get("errors") in (None, [])
+    names = sorted(mv["name"] for mv in payload["data"]["mlflowGetRun"]["run"]["modelVersions"])
+    assert names == [f"gql_run_mv_model{i}" for i in range(4)]
+
+    resp = _graphql_query(
+        client.tracking_uri, query, variables={"runId": run_id}, auth=(username2, password2)
+    )
+    resp.raise_for_status()
+    payload = resp.json()
+    assert payload.get("errors") in (None, [])
+    run_data = payload["data"]["mlflowGetRun"]["run"]
+    assert run_data["info"]["runId"] == run_id
+    names = sorted(mv["name"] for mv in run_data["modelVersions"])
+    assert names == [f"gql_run_mv_model{i}" for i in readable]
+
+
 @pytest.mark.parametrize(
