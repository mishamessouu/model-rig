     assert not auth_module._graphql_can_read_model("model-other-ws", username)
 
 
+def test_graphql_search_model_versions_filters_prompts_by_prompt_grants(monkeypatch):
+    grants = {"registered_model": {"model-ok"}, "prompt": {"prompt-ok"}}
+    monkeypatch.setattr(
+        auth_module,
+        "_role_based_read_predicate",
+        lambda username, resource_type: lambda name: name in grants[resource_type],
+    )
+
+    def _version(name, is_prompt):
+        tags = [SimpleNamespace(key=IS_PROMPT_TAG_KEY, value="true")] if is_prompt else []
+        return SimpleNamespace(name=name, tags=tags)
+
+    result = SimpleNamespace(
+        model_versions=[
+            _version("model-ok", is_prompt=False),
+            _version("model-denied", is_prompt=False),
+            _version("prompt-ok", is_prompt=True),
+            # Readable as a registered model, but not as a prompt
+            _version("model-ok", is_prompt=True),
+        ]
+    )
+
+    middleware = auth_module.GraphQLAuthorizationMiddleware()
+    filtered = middleware._filter_model_versions_result(result, "alice")
+
+    assert [(mv.name, bool(mv.tags)) for mv in filtered.model_versions] == [
+        ("model-ok", False),
+        ("prompt-ok", True),
+    ]
+
