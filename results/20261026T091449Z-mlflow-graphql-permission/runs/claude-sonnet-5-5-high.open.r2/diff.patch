diff --git a/tests/server/auth/test_auth.py b/tests/server/auth/test_auth.py
index f3df01e..d932ee7 100644
--- a/tests/server/auth/test_auth.py
+++ b/tests/server/auth/test_auth.py
@@ -1530,6 +1530,52 @@ def test_graphql_search_model_versions(client, monkeypatch):
     assert names == [f"gql_mv_model{i}" for i in readable]
 
 
+@pytest.mark.parametrize(
+    "client",
+    [{"MLFLOW_AUTH_CONFIG_PATH": "fixtures/no_permission_auth.ini"}],
+    indirect=True,
+)
+def test_graphql_get_run_filters_unreadable_model_versions(client, monkeypatch):
+    username1, password1 = create_user(client.tracking_uri)
+    username2, password2 = create_user(client.tracking_uri)
+
+    with User(username1, password1, monkeypatch):
+        experiment_id = client.create_experiment("gql_run_mv_exp")
+        run_id = client.create_run(experiment_id).info.run_id
+        for name in ("gql_run_mv_readable", "gql_run_mv_hidden"):
+            client.create_registered_model(name)
+            client.create_model_version(name, f"runs:/{run_id}/model", run_id=run_id)
+        grant_role_permission(client.tracking_uri, username2, "experiment", experiment_id, "READ")
+        grant_role_permission(
+            client.tracking_uri, username2, "registered_model", "gql_run_mv_readable", "READ"
+        )
+
+    query = """
+    query($runId: String!) {
+        mlflowGetRun(input: {runId: $runId}) {
+            run {
+                modelVersions { name }
+            }
+        }
+    }
+    """
+
+    def get_model_version_names(auth):
+        response = _graphql_query(
+            client.tracking_uri, query, variables={"runId": run_id}, auth=auth
+        )
+        response.raise_for_status()
+        payload = response.json()
+        assert payload.get("errors") is None
+        return sorted(mv["name"] for mv in payload["data"]["mlflowGetRun"]["run"]["modelVersions"])
+
+    assert get_model_version_names((username1, password1)) == [
+        "gql_run_mv_hidden",
+        "gql_run_mv_readable",
+    ]
+    assert get_model_version_names((username2, password2)) == ["gql_run_mv_readable"]
+
+
 @pytest.mark.parametrize(
