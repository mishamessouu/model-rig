+            return [mv for mv in result if can_read(mv.name)]
         return result
 
     def _filter_model_versions_result(self, result, username: str):
diff --git a/tests/server/auth/test_auth.py b/tests/server/auth/test_auth.py
index f3df01e..1f33ba6 100644
--- a/tests/server/auth/test_auth.py
+++ b/tests/server/auth/test_auth.py
@@ -1530,6 +1530,47 @@ def test_graphql_search_model_versions(client, monkeypatch):
     assert names == [f"gql_mv_model{i}" for i in readable]
 
 
+@pytest.mark.parametrize(
+    "client",
+    [{"MLFLOW_AUTH_CONFIG_PATH": "fixtures/no_permission_auth.ini"}],
+    indirect=True,
+)
+def test_graphql_run_model_versions_filtered_by_model_permission(client, monkeypatch):
+    username1, password1 = create_user(client.tracking_uri)
+    username2, password2 = create_user(client.tracking_uri)
+
+    with User(username1, password1, monkeypatch):
+        experiment_id = client.create_experiment("gql_run_mv_exp")
+        run_id = client.create_run(experiment_id).info.run_id
+        for name in ("gql_run_mv_readable", "gql_run_mv_hidden"):
+            rm = client.create_registered_model(name)
+            client.create_model_version(rm.name, f"runs:/{run_id}/model", run_id=run_id)
+    grant_role_permission(client.tracking_uri, username2, "experiment", experiment_id, "READ")
+    grant_role_permission(
+        client.tracking_uri, username2, "registered_model", "gql_run_mv_readable", "READ"
+    )
+
+    query = """
+    query GetRun($input: MlflowGetRunInput){
+      mlflowGetRun(input: $input){
+        run { modelVersions { name } }
+      }
+    }
+    """
+    variables = {"input": {"runId": run_id}}
+
+    for auth, expected in [
+        ((username1, password1), ["gql_run_mv_hidden", "gql_run_mv_readable"]),
+        ((username2, password2), ["gql_run_mv_readable"]),
+    ]:
+        resp = _graphql_query(client.tracking_uri, query, variables, auth=auth)
+        resp.raise_for_status()
+        payload = resp.json()
+        assert payload.get("errors") in (None, [])
+        run = payload["data"]["mlflowGetRun"]["run"]
+        assert sorted(mv["name"] for mv in run["modelVersions"]) == expected
+
+
 @pytest.mark.parametrize(
     "client",
     [{"MLFLOW_AUTH_CONFIG_PATH": "fixtures/no_permission_auth.ini"}],
