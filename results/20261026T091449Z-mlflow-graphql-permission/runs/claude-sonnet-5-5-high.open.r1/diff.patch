         "mlflowSearchRuns",
         "mlflowSearchDatasets",
         "mlflowSearchModelVersions",
+        RUN_MODEL_VERSIONS_FIELD,
     }
 
     def resolve(self, next, root, info, **args):
@@ -5117,6 +5121,10 @@ class GraphQLAuthorizationMiddleware:
             The resolved value or an error response
         """
         field_name = info.field_name
+        # ``modelVersions`` on the search response is filtered via ``mlflowSearchModelVersions``;
+        # the one nested under a run is resolved separately and would otherwise be unfiltered.
+        if field_name == "modelVersions" and info.parent_type.name == "MlflowRunExtension":
