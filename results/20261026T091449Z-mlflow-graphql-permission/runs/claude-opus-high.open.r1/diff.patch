@@ -2730,6 +2730,53 @@ def test_graphql_get_run_authorization(client, monkeypatch):
     assert data.get("data", {}).get("mlflowGetRun") is None
 
 
+@pytest.mark.parametrize(
+    "client",
+    [{"MLFLOW_AUTH_CONFIG_PATH": "fixtures/no_permission_auth.ini"}],
+    indirect=True,
+)
+def test_graphql_run_model_versions_authorization(client, monkeypatch):
+    username1, password1 = create_user(client.tracking_uri)
+    username2, password2 = create_user(client.tracking_uri)
+
+    with User(username1, password1, monkeypatch):
+        experiment_id = client.create_experiment("graphql_run_mv_exp")
+        run_id = client.create_run(experiment_id).info.run_id
+        for name in ("gql_run_mv_readable", "gql_run_mv_private"):
+            client.create_registered_model(name)
+            client.create_model_version(name, f"runs:/{run_id}/model", run_id=run_id)
+
+    grant_role_permission(client.tracking_uri, username2, "experiment", experiment_id, "READ")
+    grant_role_permission(
+        client.tracking_uri, username2, "registered_model", "gql_run_mv_readable", "READ"
+    )
+
+    query = """
+    query($runId: String!) {
+        mlflowGetRun(input: {runId: $runId}) {
+            run {
+                modelVersions { name }
+            }
+        }
+    }
+    """
+
+    def model_version_names(auth):
+        response = _graphql_query(
+            client.tracking_uri, query, variables={"runId": run_id}, auth=auth
+        )
+        assert response.status_code == 200
+        data = response.json()
+        assert data.get("errors") in (None, [])
+        return sorted(mv["name"] for mv in data["data"]["mlflowGetRun"]["run"]["modelVersions"])
+
+    assert model_version_names((username1, password1)) == [
+        "gql_run_mv_private",
+        "gql_run_mv_readable",
+    ]
+    assert model_version_names((username2, password2)) == ["gql_run_mv_readable"]
+
+
 @pytest.mark.parametrize(
     "client",
     [{"MLFLOW_AUTH_CONFIG_PATH": "fixtures/no_permission_auth.ini"}],
