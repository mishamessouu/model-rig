+@pytest.mark.parametrize("existing_local_tool", [False, True])
+def test_create_recipe_from_zip_scopes_tools_to_importing_group(
+    api_client: TestClient,
+    unique_user: TestUser,
+    g2_user: TestUser,
+    tempdir: str,
+    existing_local_tool: bool,
+) -> None:
+    name = random_string()
+    response = api_client.post(api_routes.organizers_tools, json={"name": name}, headers=g2_user.token)
+    assert response.status_code == 201
+    foreign_tool = response.json()
+    local_tool = None
+    if existing_local_tool:
+        response = api_client.post(api_routes.organizers_tools, json={"name": name}, headers=unique_user.token)
+        assert response.status_code == 201
+        local_tool = response.json()
+
+    imported_recipe = Recipe(name=random_string(), tools=[foreign_tool])
+    response = api_client.post(
+        api_routes.recipes_create_zip,
+        files=zip_recipe(tempdir, imported_recipe),
+        headers=unique_user.token,
+    )
+    assert response.status_code == 201
+
+    imported = api_client.get(api_routes.recipes_slug(response.json()), headers=unique_user.token).json()
+    assert len(imported["tools"]) == 1
+    tool = imported["tools"][0]
+    assert tool["name"] == name
+    assert tool["groupId"] == str(unique_user.group_id)
+    assert tool["id"] != foreign_tool["id"]
+    if local_tool:
+        assert tool["id"] == local_tool["id"]
+
+    unchanged = api_client.get(api_routes.organizers_tools_item_id(foreign_tool["id"]), headers=g2_user.token)
+    assert unchanged.status_code == 200
+    assert unchanged.json()["groupId"] == str(g2_user.group_id)
+    assert unchanged.json()["name"] == name
+
+
