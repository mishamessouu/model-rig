+@pytest.mark.parametrize("existing_local_tool", [False, True])
+@pytest.mark.parametrize("with_slug", [False, True])
+def test_create_recipe_from_zip_cannot_modify_another_groups_tool(
+    api_client: TestClient,
+    unique_user: TestUser,
+    g2_user: TestUser,
+    tempdir: str,
+    existing_local_tool: bool,
+    with_slug: bool,
+) -> None:
+    foreign_tool = g2_user.repos.tools.create(RecipeToolSave(name=random_string(), group_id=g2_user.group_id))
+    imported_name = random_string()
+    local_tool = (
+        unique_user.repos.tools.create(RecipeToolSave(name=imported_name, group_id=unique_user.group_id))
+        if existing_local_tool
+        else None
+    )
+    recipe = Recipe(
+        name=random_string(),
+        tools=[foreign_tool.model_copy(update={"name": imported_name, "slug": imported_name if with_slug else ""})],
+    )
+
+    response = api_client.post(
+        api_routes.recipes_create_zip, files=zip_recipe(tempdir, recipe), headers=unique_user.token
+    )
+    assert response.status_code == 201
+
+    # Check through the owning group's API, so a reassigned group_id cannot hide the mutation.
+    response = api_client.get(api_routes.organizers_tools_item_id(foreign_tool.id), headers=g2_user.token)
+    assert response.status_code == 200
+    assert response.json()["name"] == foreign_tool.name
+    assert response.json()["slug"] == foreign_tool.slug
+    assert response.json()["groupId"] == str(g2_user.group_id)
+
+    imported = unique_user.repos.recipes.get_one(recipe.slug)
+    assert imported and imported.tools and len(imported.tools) == 1
+    tool = imported.tools[0]
+    assert tool.id != foreign_tool.id
+    assert str(tool.group_id) == unique_user.group_id
+    assert tool.name == imported_name
+    if local_tool:
+        assert tool.id == local_tool.id
+
