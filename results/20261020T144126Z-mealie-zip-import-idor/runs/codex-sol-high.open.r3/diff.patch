+    def _transform_tool(self, data: dict[str, Any]) -> dict[str, Any]:
+        # Resolve tools within this group before the ORM sees them: exported ids may
+        # belong to another group, and the ORM's relationship lookup is unscoped.
+        tool = self.repos.tools.get_one(data.get("slug") or slugify(data["name"]), "slug")
