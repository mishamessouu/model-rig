+@pytest.mark.parametrize("matching_local_tool", [False, True])
+@pytest.mark.parametrize("empty_slug", [False, True])
+def test_create_recipe_from_zip_cannot_modify_foreign_tool(
+    api_client: TestClient,
+    unique_user: TestUser,
+    g2_user: TestUser,
+    tempdir: str,
+    matching_local_tool: bool,
+    empty_slug: bool,
+):
+    foreign_tool = g2_user.repos.tools.create(RecipeToolSave(name=random_string(), group_id=g2_user.group_id))
+    imported_name = random_string()
+    local_tool = (
+        unique_user.repos.tools.create(RecipeToolSave(name=imported_name, group_id=unique_user.group_id))
+        if matching_local_tool
+        else None
+    )
+    recipe = RecipeSummary(
+        name=random_string(),
+        tools=[
+            {
+                "id": foreign_tool.id,
+                "name": imported_name,
+                "slug": "" if empty_slug else slugify(imported_name),
+                "group_id": g2_user.group_id,
+                "households_with_tool": [g2_user.repos.households.get_one(g2_user.household_id).slug],
+            }
+        ],
+    )
+
+    response = api_client.post(
+        api_routes.recipes_create_zip, files=zip_recipe(tempdir, recipe), headers=unique_user.token
+    )
+    assert response.status_code == 201
+    imported = api_client.get(api_routes.recipes_slug(response.json()), headers=unique_user.token).json()
+    assert len(imported["tools"]) == 1
+    assert imported["tools"][0]["id"] != str(foreign_tool.id)
+    assert imported["tools"][0]["name"] == imported_name
+    assert imported["tools"][0]["groupId"] == str(unique_user.group_id)
+    assert imported["tools"][0]["householdsWithTool"] == []
+    if local_tool:
+        assert imported["tools"][0]["id"] == str(local_tool.id)
+
+    g2_user.repos.session.expire_all()
+    unchanged = g2_user.repos.tools.get_one(foreign_tool.id)
+    assert unchanged is not None
+    assert unchanged.model_dump() == foreign_tool.model_dump()
+
+
