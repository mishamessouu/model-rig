+@pytest.mark.parametrize("existing_local_tool", [False, True])
+def test_create_recipe_from_zip_foreign_tool(
+    api_client: TestClient, unique_user: TestUser, g2_user: TestUser, tempdir: str, existing_local_tool: bool
+) -> None:
+    tool_name = random_string()
+    foreign_tool = api_client.post(
+        api_routes.organizers_tools, json={"name": tool_name}, headers=g2_user.token
+    ).json()
+    local_tool = None
+    if existing_local_tool:
+        local_tool = api_client.post(
+            api_routes.organizers_tools, json={"name": tool_name}, headers=unique_user.token
+        ).json()
+
+    recipe = Recipe(name=random_string(), tools=[foreign_tool])
+    response = api_client.post(
+        api_routes.recipes_create_zip, files=zip_recipe(tempdir, recipe), headers=unique_user.token
+    )
+    assert response.status_code == 201
+    imported = api_client.get(api_routes.recipes_slug(response.json()), headers=unique_user.token).json()
+    imported_tool = imported["tools"][0]
+    assert imported_tool["id"] != foreign_tool["id"]
+    assert imported_tool["groupId"] == str(unique_user.group_id)
+    assert imported_tool["name"] == tool_name
+    if local_tool:
+        assert imported_tool["id"] == local_tool["id"]
+
+    g2_user.repos.session.expire_all()
+    unchanged = g2_user.repos.tools.get_one(foreign_tool["id"])
+    assert unchanged is not None
+    assert str(unchanged.group_id) == str(g2_user.group_id)
+    assert unchanged.name == tool_name
+
+
