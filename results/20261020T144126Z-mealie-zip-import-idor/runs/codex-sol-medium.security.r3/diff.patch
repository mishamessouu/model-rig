+@pytest.mark.parametrize("existing_local_tool", [False, True])
+def test_create_recipe_from_zip_cannot_take_another_groups_tool(
+    api_client: TestClient, unique_user: TestUser, g2_user: TestUser, tempdir: str, existing_local_tool: bool
+):
+    other_tool = api_client.post(
+        api_routes.organizers_tools, json={"name": random_string()}, headers=g2_user.token
+    ).json()
+    imported_name = random_string()
+    local_tool = None
+    if existing_local_tool:
+        local_tool = api_client.post(
+            api_routes.organizers_tools, json={"name": imported_name}, headers=unique_user.token
+        ).json()
+
+    recipe = Recipe(
+        name=random_string(),
+        user_id=unique_user.user_id,
+        group_id=unique_user.group_id,
+        tools=[{**other_tool, "name": imported_name, "slug": slugify(imported_name)}],
+    )
+    response = api_client.post(
+        api_routes.recipes_create_zip, files=zip_recipe(tempdir, recipe), headers=unique_user.token
+    )
+    assert response.status_code == 201
+    imported = api_client.get(api_routes.recipes_slug(response.json()), headers=unique_user.token).json()
+    assert imported["tools"][0]["id"] != other_tool["id"]
+    assert imported["tools"][0]["name"] == imported_name
+    if local_tool:
+        assert imported["tools"][0]["id"] == local_tool["id"]
+
+    # Fetch through a fresh request to verify the victim's tool remains in its original group.
+    victim_tool = api_client.get(
+        f"{api_routes.organizers_tools}/{other_tool['id']}", headers=g2_user.token
+    )
+    assert victim_tool.status_code == 200
+    assert victim_tool.json() == other_tool
+
+
