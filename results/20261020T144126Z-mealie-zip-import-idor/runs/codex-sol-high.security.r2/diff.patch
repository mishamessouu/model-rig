+@pytest.mark.parametrize("reuse_local", [False, True])
+@pytest.mark.parametrize(
+    ("field", "route", "empty_slug"),
+    [
+        ("recipe_category", api_routes.organizers_categories, False),
+        ("recipeCategory", api_routes.organizers_categories, False),
+        ("recipe_category", api_routes.organizers_categories, True),
+        ("recipeCategory", api_routes.organizers_categories, True),
+        ("tags", api_routes.organizers_tags, False),
+        ("tags", api_routes.organizers_tags, True),
+        ("tools", api_routes.organizers_tools, False),
+        ("tools", api_routes.organizers_tools, True),
+    ],
+)
+def test_create_recipe_from_zip_scopes_organizers(
+    api_client: TestClient,
+    unique_user: TestUser,
+    g2_user: TestUser,
+    tempdir: str,
+    field: str,
+    route: str,
+    empty_slug: bool,
+    reuse_local: bool,
+):
+    repo_name = route.rsplit("/", 1)[1]
+    victim_repo = getattr(g2_user.repos, repo_name)
+    victim = victim_repo.create({"name": random_string(), "group_id": g2_user.group_id}).model_dump(
+        mode="json", by_alias=True
+    )
+
+    imported_name = random_string()
+    local = None
+    if reuse_local:
+        local = (
+            getattr(unique_user.repos, repo_name)
+            .create({"name": imported_name, "group_id": unique_user.group_id})
+            .model_dump(mode="json", by_alias=True)
+        )
+
+    # A foreign id must never reach the ORM's global relationship lookup, even when
+    # the archive uses API aliases or omits a usable slug.
+    organizer = {
+        **victim,
+        "name": imported_name,
+        "slug": "" if empty_slug else slugify(imported_name),
+    }
+    zip_file = Path(tempdir) / "organizer.zip"
+    with ZipFile(zip_file, "w") as archive:
+        archive.writestr("recipe.json", json.dumps({"name": random_string(), field: [organizer]}))
+
+    response = api_client.post(
+        api_routes.recipes_create_zip, files={"archive": zip_file.read_bytes()}, headers=unique_user.token
+    )
+    assert response.status_code == 201
+    imported = api_client.get(api_routes.recipes_slug(response.json()), headers=unique_user.token).json()
+    imported_field = "recipeCategory" if field == "recipe_category" else field
+    saved_organizer = imported[imported_field][0]
+    assert saved_organizer["id"] != victim["id"]
+    assert saved_organizer["groupId"] == str(unique_user.group_id)
+    assert saved_organizer["name"] == imported_name
+    if local:
+        assert saved_organizer["id"] == local["id"]
+
+    victim_repo.session.expire_all()
+    untouched = victim_repo.get_one(victim["id"])
+    assert untouched is not None
+    for key in ("id", "groupId", "name", "slug"):
+        assert untouched.model_dump(mode="json", by_alias=True)[key] == victim[key]
+
+
