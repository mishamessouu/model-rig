+@pytest.mark.parametrize("empty_slug", [False, True])
+@pytest.mark.parametrize("reuse_local", [False, True])
+def test_create_recipe_from_zip_scopes_tools(
+    api_client: TestClient, unique_user: TestUser, g2_user: TestUser, tempdir: str, empty_slug: bool, reuse_local: bool
+) -> None:
+    route = api_routes.organizers_tools
+    response = api_client.post(route, json={"name": random_string()}, headers=g2_user.token)
+    assert response.status_code == 201
+    foreign = response.json()
+    imported_name = random_string()
+    local = None
+    if reuse_local:
+        response = api_client.post(route, json={"name": imported_name}, headers=unique_user.token)
+        assert response.status_code == 201
+        local = response.json()
+
+    # The archive claims a foreign ID but supplies a new name and slug in our group.
+    supplied = foreign | {"name": imported_name, "slug": "" if empty_slug else slugify(imported_name)}
+    recipe = RecipeSummary(name=random_string(), tools=[supplied])
+    response = api_client.post(
+        api_routes.recipes_create_zip, files=zip_recipe(tempdir, recipe), headers=unique_user.token
+    )
+    assert response.status_code == 201
+
+    imported = api_client.get(api_routes.recipes_slug(response.json()), headers=unique_user.token).json()
+    imported_tool = imported["tools"][0]
+    assert imported_tool["id"] != foreign["id"]
+    assert imported_tool["groupId"] == str(unique_user.group_id)
+    assert imported_tool["name"] == imported_name
+    if local:
+        assert imported_tool["id"] == local["id"]
+
+    unchanged = api_client.get(f"{route}/{foreign['id']}", headers=g2_user.token)
+    assert unchanged.status_code == 200
+    assert unchanged.json()["name"] == foreign["name"]
+    assert unchanged.json()["groupId"] == foreign["groupId"]
+
+
