+@pytest.mark.parametrize("by_alias", [False, True])
+def test_create_recipe_from_zip_cannot_take_other_group_tools(
+    api_client: TestClient, unique_user: TestUser, g2_user: TestUser, tempdir: str, by_alias: bool
+) -> None:
+    original = api_client.post(
+        api_routes.organizers_tools, json={"name": random_string()}, headers=g2_user.token
+    ).json()
+    payload = Recipe(name=random_string(), tools=[original])
+
+    archive = Path(tempdir) / "foreign_tools.zip"
+    with ZipFile(archive, "w") as zf:
+        zf.writestr("recipe.json", payload.model_dump_json(by_alias=by_alias))
+
+    response = api_client.post(
+        api_routes.recipes_create_zip, files={"archive": archive.read_bytes()}, headers=unique_user.token
+    )
+    assert response.status_code == 201
+    imported = api_client.get(api_routes.recipes_slug(response.json()), headers=unique_user.token).json()
+    unchanged = api_client.get(f"{api_routes.organizers_tools}/{original['id']}", headers=g2_user.token)
+    assert unchanged.status_code == 200
+    assert unchanged.json()["groupId"] == original["groupId"]
+    assert unchanged.json()["name"] == original["name"]
+    assert imported["tools"][0]["id"] != original["id"]
+    assert imported["tools"][0]["groupId"] == str(unique_user.group_id)
+    assert imported["tools"][0]["name"] == original["name"]
+
+
