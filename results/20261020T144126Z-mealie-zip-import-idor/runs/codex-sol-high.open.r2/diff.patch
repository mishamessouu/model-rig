+@pytest.mark.parametrize("same_group", [False, True])
+@pytest.mark.parametrize("include_slug", [False, True])
+def test_create_recipe_from_zip_does_not_modify_existing_tool(
+    api_client: TestClient,
+    unique_user: TestUser,
+    g2_user: TestUser,
+    tempdir: str,
+    same_group: bool,
+    include_slug: bool,
+) -> None:
+    owner = unique_user if same_group else g2_user
+    response = api_client.post(api_routes.organizers_tools, json={"name": random_string()}, headers=owner.token)
+    assert response.status_code == 201
+    original_tool = response.json()
+
+    recipe_name = random_string()
+    imported_tool_name = random_string()
+    recipe = Recipe(
+        name=recipe_name,
+        tools=[{**original_tool, "name": imported_tool_name, "slug": original_tool["slug"] if include_slug else ""}],
+    )
+    response = api_client.post(
+        api_routes.recipes_create_zip, files=zip_recipe(tempdir, recipe), headers=unique_user.token
+    )
+    assert response.status_code == 201
+
+    tool_response = api_client.get(f"{api_routes.organizers_tools}/{original_tool['id']}", headers=owner.token)
+    assert tool_response.status_code == 200
+    assert tool_response.json() == original_tool
+
+    imported = api_client.get(api_routes.recipes_slug(response.json()), headers=unique_user.token).json()
+    imported_tool = imported["tools"][0]
+    assert imported_tool["groupId"] == str(unique_user.group_id)
+    if same_group and include_slug:
+        assert imported_tool["id"] == original_tool["id"]
+        assert imported_tool["name"] == original_tool["name"]
+    else:
+        assert imported_tool["id"] != original_tool["id"]
+        assert imported_tool["name"] == imported_tool_name
+
+
