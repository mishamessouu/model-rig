+@pytest.mark.parametrize("local_tool_exists", [False, True])
+def test_create_recipe_from_zip_cannot_take_another_groups_tool(
+    api_client: TestClient, unique_user: TestUser, g2_user: TestUser, tempdir: str, local_tool_exists: bool
+):
+    tool_name = random_string()
+    victim_tool = api_client.post(
+        api_routes.organizers_tools, json={"name": tool_name}, headers=g2_user.token
+    ).json()
+    local_tool = None
+    if local_tool_exists:
+        local_tool = api_client.post(
+            api_routes.organizers_tools, json={"name": tool_name}, headers=unique_user.token
+        ).json()
+
+    recipe_name = random_string()
+    recipe = Recipe(
+        name=recipe_name,
+        slug=recipe_name,
+        tools=[victim_tool],
+    )
+    response = api_client.post(
+        api_routes.recipes_create_zip, files=zip_recipe(tempdir, recipe), headers=unique_user.token
+    )
+    assert response.status_code == 201
+    imported = api_client.get(api_routes.recipes_slug(response.json()), headers=unique_user.token).json()
+    assert imported["tools"][0]["id"] != victim_tool["id"]
+    assert imported["tools"][0]["groupId"] == str(unique_user.group_id)
+    assert imported["tools"][0]["name"] == tool_name
+    if local_tool:
+        assert imported["tools"][0]["id"] == local_tool["id"]
+
+    # Importing must neither move nor modify the other group's tool.
+    victim_tools = api_client.get(api_routes.organizers_tools, headers=g2_user.token).json()["items"]
+    assert next(tool for tool in victim_tools if tool["id"] == victim_tool["id"]) == victim_tool
+
+
