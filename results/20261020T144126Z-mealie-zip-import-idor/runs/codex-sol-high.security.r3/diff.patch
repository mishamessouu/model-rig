+@pytest.mark.parametrize("organizer", ["recipe_category", "tags", "tools"])
+@pytest.mark.parametrize("empty_slug", [False, True])
+def test_create_recipe_from_zip_cannot_modify_other_group_organizers(
+    api_client: TestClient, unique_user: TestUser, g2_user: TestUser, tempdir: str, organizer: str, empty_slug: bool
+):
+    repo = getattr(g2_user.repos, {"recipe_category": "categories"}.get(organizer, organizer))
+    original = repo.create({"name": random_string(), "group_id": g2_user.group_id}).model_dump(mode="json", by_alias=True)
+
+    forged = {**original, "name": random_string()}
+    if empty_slug:
+        forged["slug"] = ""
+    recipe = RecipeSummary(name=random_string(), **{organizer: [forged]})
+    response = api_client.post(
+        api_routes.recipes_create_zip, files=zip_recipe(tempdir, recipe), headers=unique_user.token
+    )
+    assert response.status_code == 201
+
+    repo.session.expire_all()
+    unchanged = repo.get_one(original["id"])
+    assert unchanged is not None
+    assert unchanged.model_dump(mode="json", by_alias=True) == original
+
+    imported = api_client.get(api_routes.recipes_slug(response.json()), headers=unique_user.token).json()
+    imported_organizer = imported[{"recipe_category": "recipeCategory"}.get(organizer, organizer)][0]
+    assert imported_organizer["id"] != original["id"]
+    assert imported_organizer["groupId"] == unique_user.group_id
+    assert imported_organizer["name"] == forged["name"]
+
+
