+def test_create_recipe_from_zip_cannot_take_another_groups_tool(
+    api_client: TestClient, unique_user: TestUser, g2_user: TestUser, tempdir: str
+) -> None:
+    tool = api_client.post(
+        api_routes.organizers_tools, json={"name": random_string()}, headers=g2_user.token
+    ).json()
+    imported_name = random_string()
+    recipe_name = random_string()
+    recipe = Recipe(
+        name=recipe_name,
+        tools=[{**tool, "name": imported_name, "slug": slugify(imported_name)}],
+    )
+
+    response = api_client.post(
+        api_routes.recipes_create_zip, files=zip_recipe(tempdir, recipe), headers=unique_user.token
+    )
+    assert response.status_code == 201
+
+    original = api_client.get(api_routes.organizers_tools_item_id(tool["id"]), headers=g2_user.token)
+    assert original.status_code == 200
+    assert original.json()["name"] == tool["name"]
+    assert original.json()["groupId"] == tool["groupId"]
+    imported = api_client.get(api_routes.recipes_slug(response.json()), headers=unique_user.token).json()
+    assert imported["tools"][0]["id"] != tool["id"]
+    assert imported["tools"][0]["groupId"] == str(unique_user.group_id)
+    assert imported["tools"][0]["name"] == imported_name
+
+
