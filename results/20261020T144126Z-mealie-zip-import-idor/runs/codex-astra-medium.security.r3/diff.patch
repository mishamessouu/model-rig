+@pytest.mark.parametrize("existing_local_tool", [False, True])
+def test_create_recipe_from_zip_foreign_tool(
+    api_client: TestClient, unique_user: TestUser, g2_user: TestUser, tempdir: str, existing_local_tool: bool
+) -> None:
+    victim = api_client.post(
+        api_routes.organizers_tools, json={"name": random_string()}, headers=g2_user.token
+    ).json()
+    tool_name = random_string()
+    local_tool = None
+    if existing_local_tool:
+        local_tool = api_client.post(
+            api_routes.organizers_tools, json={"name": tool_name}, headers=unique_user.token
+        ).json()
+
+    recipe = Recipe(
+        name=random_string(),
+        tools=[{**victim, "name": tool_name, "slug": slugify(tool_name)}],
+    )
+    response = api_client.post(
+        api_routes.recipes_create_zip, files=zip_recipe(tempdir, recipe), headers=unique_user.token
+    )
+    assert response.status_code == 201
+
+    # Importing an attacker-supplied ID must neither move nor edit the victim's tool.
+    unchanged = api_client.get(api_routes.organizers_tools_item_id(victim["id"]), headers=g2_user.token)
+    assert unchanged.status_code == 200
+    for field in ("id", "groupId", "name", "slug", "householdsWithTool"):
+        assert unchanged.json()[field] == victim[field]
+
+    imported = api_client.get(api_routes.recipes_slug(response.json()), headers=unique_user.token).json()
+    tool = imported["tools"][0]
+    assert tool["id"] != victim["id"]
+    assert tool["groupId"] == str(unique_user.group_id)
+    assert tool["name"] == tool_name
+    if local_tool:
+        assert tool["id"] == local_tool["id"]
+
+
