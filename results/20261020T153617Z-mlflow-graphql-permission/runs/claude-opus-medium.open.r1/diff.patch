diff --git a/tests/server/auth/test_client_workspace.py b/tests/server/auth/test_client_workspace.py
index f35fb1a..5228736 100644
--- a/tests/server/auth/test_client_workspace.py
+++ b/tests/server/auth/test_client_workspace.py
@@ -343,3 +343,44 @@ def test_registered_model_access_controls_across_workspaces(workspace_setup, mon
     )
     assert resp.status_code == 403
     assert "Permission denied" in resp.text
+
+
+def test_graphql_run_model_versions_filtered_by_model_permission(workspace_setup):
+    _, tracking_uri, workspace, username, password = workspace_setup
+    grant_role_permission(tracking_uri, username, "workspace", "*", "MANAGE", workspace=workspace)
+
+    exp_id = _create_experiment(tracking_uri, workspace, auth=(username, password))
+    run_id = _create_run(tracking_uri, workspace, exp_id, auth=(username, password))
+    readable_model = f"readable-{random_str()}"
+    hidden_model = f"hidden-{random_str()}"
+    for model_name in (readable_model, hidden_model):
+        _create_registered_model(tracking_uri, workspace, model_name, auth=(username, password))
+        _create_model_version(
+            tracking_uri, workspace, model_name, run_id, auth=(username, password)
+        )
+
+    limited_user, limited_password = create_user(tracking_uri)
+    grant_role_permission(tracking_uri, limited_user, "experiment", exp_id, "READ", workspace)
+    grant_role_permission(
+        tracking_uri, limited_user, "registered_model", readable_model, "READ", workspace
+    )
+
+    query = """
+    query GetRun($input: MlflowGetRunInput){
+      mlflowGetRun(input: $input){
+        run { info { runId } modelVersions { name } }
+      }
+    }
+    """
+    resp = requests.post(
+        f"{tracking_uri}/graphql",
+        json={"query": query, "variables": {"input": {"runId": run_id}}},
+        auth=(limited_user, limited_password),
+        headers={WORKSPACE_HEADER_NAME: workspace},
+    )
+    resp.raise_for_status()
+    payload = resp.json()
+    assert payload.get("errors") in (None, [])
+    run = payload["data"]["mlflowGetRun"]["run"]
+    assert run["info"]["runId"] == run_id
+    assert [mv["name"] for mv in run["modelVersions"]] == [readable_model]
