 class AttachmentAPITests(InvenTreeAPITestCase):
     """Tests for the Attachment API."""
 
+    def test_attachment_read_permissions(self):
+        """Only expose attachments for models the user can view."""
+        from company.models import Company
+        from part.models import Part
+
+        self.user.is_staff = False
+        self.user.save()
+
+        part = Part.objects.create(name='Restricted part')
+        company = Company.objects.create(name='Restricted company')
+        attachments = [
+            common.models.Attachment.objects.create(
+                model_type=model_type,
+                model_id=obj.pk,
+                link=f'https://example.com/{model_type}/private',
+                comment='Private attachment',
+            )
+            for model_type, obj in [('part', part), ('company', company)]
+        ]
+        list_url = reverse('api-attachment-list')
+        detail_urls = [
+            reverse('api-attachment-detail', kwargs={'pk': attachment.pk})
+            for attachment in attachments
+        ]
+
+        self.assertEqual(self.get(list_url).data, [])
+        for url in detail_urls:
+            self.get(url, expected_code=404)
+            self.assertEqual(self.client.head(url).status_code, 404)
+
+        self.assignRole('part.view')
+        response = self.get(list_url, data={'limit': 1})
+        self.assertEqual(response.data['count'], 1)
+        self.assertEqual(response.data['results'][0]['pk'], attachments[0].pk)
+        self.assertEqual(self.get(list_url, data={'model_type': 'company'}).data, [])
+        self.get(detail_urls[0], expected_code=200)
+        self.get(detail_urls[1], expected_code=404)
+
+        self.assignRole('purchase_order.view')
+        self.get(detail_urls[1], expected_code=200)
+        self.assertEqual(len(self.get(list_url).data), 2)
+
+        self.clearRoles()
+        self.assertEqual(self.get(list_url).data, [])
+        self.user.is_superuser = True
+        self.user.save()
+        self.assertEqual(len(self.get(list_url).data), 2)
+
+        self.logout()
+        self.get(list_url, expected_code=401)
+        self.get(detail_urls[0], expected_code=401)
+
