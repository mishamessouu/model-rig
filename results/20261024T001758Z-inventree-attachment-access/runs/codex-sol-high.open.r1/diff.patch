 class AttachmentAPITests(InvenTreeAPITestCase):
     """Tests for the Attachment API."""
 
+    def test_read_permissions(self):
+        """Only expose attachments for models the user can view."""
+        from part.models import Part
+        from stock.models import StockItem
+
+        self.user.is_staff = False
+        self.user.save()
+
+        part = Part.objects.create(name='Attachment permission test')
+        stock = StockItem.objects.create(part=part, quantity=1)
+        attachments = [
+            common.models.Attachment.objects.create(
+                model_type=model_type,
+                model_id=instance.pk,
+                link='https://example.com/attachment',
+            )
+            for model_type, instance in [('part', part), ('stockitem', stock)]
+        ]
+        url = reverse('api-attachment-list')
+        detail_urls = [
+            reverse('api-attachment-detail', kwargs={'pk': attachment.pk})
+            for attachment in attachments
+        ]
+
+        self.logout()
+        self.get(url, expected_code=401)
+        self.get(detail_urls[0], expected_code=401)
+        self.login()
+
+        # No model permissions: neither listing nor a known ID exposes attachments.
+        self.assertEqual(self.get(url, expected_code=200).data, [])
+        for detail_url in detail_urls:
+            self.get(detail_url, expected_code=404)
+            self.assertEqual(self.client.head(detail_url).status_code, 404)
+
+        self.assignRole('part.view')
+        response = self.get(url, expected_code=200)
+        self.assertEqual([item['pk'] for item in response.data], [attachments[0].pk])
+        self.get(detail_urls[0], expected_code=200)
+        self.assertEqual(self.client.head(detail_urls[0]).status_code, 200)
+        self.get(detail_urls[1], expected_code=404)
+
+        # Filters and pagination must operate on the permitted attachments only.
+        response = self.get(
+            url,
+            {'model_type': 'stockitem', 'model_id': stock.pk},
+            expected_code=200,
+        )
+        self.assertEqual(response.data, [])
+        response = self.get(url, {'limit': 1}, expected_code=200)
+        self.assertEqual(response.data['count'], 1)
+        self.assertEqual(response.data['results'][0]['pk'], attachments[0].pk)
+
+        self.assignRole('stock.view')
+        response = self.get(url, expected_code=200)
+        self.assertCountEqual(
+            [item['pk'] for item in response.data],
+            [attachment.pk for attachment in attachments],
+        )
+        self.get(detail_urls[1], expected_code=200)
+
+        self.clearRoles()
+        self.assertEqual(self.get(url, expected_code=200).data, [])
+
+        self.user.is_superuser = True
+        self.user.save()
+        response = self.get(url, expected_code=200)
+        self.assertEqual(len(response.data), 2)
+        for detail_url in detail_urls:
+            self.get(detail_url, expected_code=200)
+
     def test_attachments(self):
         """Test API functionality for attachments."""
