 class AttachmentAPITests(InvenTreeAPITestCase):
     """Tests for the Attachment API."""
 
+    def test_attachment_read_permissions(self):
+        """Attachment reads require view permission for the parent model."""
+        from company.models import Company
+        from part.models import Part
+
+        part = Part.objects.create(name='Restricted part')
+        company = Company.objects.create(name='Restricted company')
+        attachments = [
+            common.models.Attachment.objects.create(
+                model_type=model_type,
+                model_id=instance.pk,
+                link='https://example.com/private-document',
+            )
+            for model_type, instance in [('part', part), ('company', company)]
+        ]
+        url = reverse('api-attachment-list')
+        detail_urls = [
+            reverse('api-attachment-detail', kwargs={'pk': attachment.pk})
+            for attachment in attachments
+        ]
+
+        self.assertEqual(self.get(url, expected_code=200).data, [])
+        for detail_url in detail_urls:
+            self.get(detail_url, expected_code=404)
+            self.assertEqual(self.client.head(detail_url).status_code, 404)
+
+        self.assignRole('part.view')
+        self.assertEqual(
+            [item['pk'] for item in self.get(url, expected_code=200).data],
+            [attachments[0].pk],
+        )
+        self.get(detail_urls[0], expected_code=200)
+        self.get(detail_urls[1], expected_code=404)
+        self.assertEqual(
+            self.get(url, {'model_type': 'company'}, expected_code=200).data, []
+        )
+
+        self.user.is_superuser = True
+        self.user.save()
+        self.assertEqual(len(self.get(url, expected_code=200).data), 2)
+        self.get(detail_urls[1], expected_code=200)
+
