 class AttachmentAPITests(InvenTreeAPITestCase):
     """Tests for the Attachment API."""
 
+    def test_attachment_view_permissions(self):
+        """Attachments require view permission for their parent model type."""
+        from company.models import Company
+        from part.models import Part
+
+        part = Part.objects.create(name='Restricted part')
+        company = Company.objects.create(name='Restricted company')
+        attachments = [
+            common.models.Attachment.objects.create(
+                model_type=model_type,
+                model_id=parent.pk,
+                link='https://example.com/private-document',
+                comment='Confidential attachment',
+            )
+            for model_type, parent in [('part', part), ('company', company)]
+        ]
+        list_url = reverse('api-attachment-list')
+        detail_urls = [
+            reverse('api-attachment-detail', kwargs={'pk': attachment.pk})
+            for attachment in attachments
+        ]
+
+        self.assertEqual(self.get(list_url).data, [])
+        for url in detail_urls:
+            self.get(url, expected_code=404)
+
+        self.assignRole('part.view')
+        self.assertEqual(
+            [item['pk'] for item in self.get(list_url).data], [attachments[0].pk]
+        )
+        self.get(detail_urls[0])
+        self.get(detail_urls[1], expected_code=404)
+        self.assertEqual(
+            self.get(
+                list_url, {'model_type': 'company', 'model_id': company.pk}
+            ).data,
+            [],
+        )
+
+        self.assignRole('purchase_order.view')
+        self.assertEqual(
+            {item['pk'] for item in self.get(list_url).data},
+            {attachment.pk for attachment in attachments},
+        )
+        self.get(detail_urls[1])
+
