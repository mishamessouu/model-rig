+    def get_queryset(self):
+        """Restrict attachment reads to models the user may view."""
+        queryset = super().get_queryset()
+
+        if self.request.method in ['GET', 'HEAD', 'OPTIONS']:
+            model_types = [
+                model.__name__.lower()
+                for model in common.validators.attachment_model_types()
+                if model.check_related_permission('view', self.request.user)
+            ]
+            queryset = queryset.filter(model_type__in=model_types)
+
+        return queryset
+
 
 class AttachmentList(AttachmentMixin, BulkDeleteMixin, ListCreateAPI):
