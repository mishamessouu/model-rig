diff --git a/src/backend/InvenTree/common/api.py b/src/backend/InvenTree/common/api.py
index 489530c..ca6fe76 100644
--- a/src/backend/InvenTree/common/api.py
+++ b/src/backend/InvenTree/common/api.py
@@ -806,6 +806,25 @@ class AttachmentList(AttachmentMixin, BulkDeleteMixin, ListCreateAPI):
     ordering_fields = ['model_id', 'model_type', 'upload_date', 'file_size']
     search_fields = ['comment', 'model_id', 'model_type']
 
+    def get_queryset(self):
+        """Limit attachment lists to model types the user can view."""
+        from common.validators import attachment_model_class_from_label
+        from InvenTree.models import InvenTreeAttachmentMixin
+
+        user = self.request.user
+        allowed_model_types = []
+
+        for model_type, _ in common.validators.attachment_model_options():
+            model_class = attachment_model_class_from_label(model_type)
+            if (
+                model_class
+                and issubclass(model_class, InvenTreeAttachmentMixin)
+                and model_class.check_related_permission('view', user)
+            ):
+                allowed_model_types.append(model_type)
+
+        return super().get_queryset().filter(model_type__in=allowed_model_types)
+
     def perform_create(self, serializer):
         """Save the user information when a file is uploaded."""
         serializer.save(upload_user=self.request.user)
