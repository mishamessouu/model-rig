+    def test_read_permissions(self):
+        """Attachment reads require view permission for the associated model."""
+        part = Part.objects.first()
+        stock_item = StockItem.objects.create(part=part, quantity=1)
+        part_attachment = Attachment.objects.create(
+            model_type='part', model_id=part.pk, link='https://example.com/part'
+        )
+        stock_attachment = Attachment.objects.create(
+            model_type='stockitem',
+            model_id=stock_item.pk,
+            link='https://example.com/stock',
+        )
+        url = reverse('api-attachment-list')
+        part_url = reverse('api-attachment-detail', kwargs={'pk': part_attachment.pk})
+        stock_url = reverse(
+            'api-attachment-detail', kwargs={'pk': stock_attachment.pk}
+        )
+
+        self.user.is_staff = False
+        self.user.save()
+        self.clearRoles()
+
+        self.assertEqual(self.get(url, expected_code=200).data, [])
+        self.get(part_url, expected_code=404)
+        self.get(stock_url, expected_code=404)
+
+        self.assignRole('part.view')
+        response = self.get(url, expected_code=200)
+        self.assertEqual([item['pk'] for item in response.data], [part_attachment.pk])
+        self.get(part_url, expected_code=200)
+        self.get(stock_url, expected_code=404)
+        self.assertEqual(
+            self.get(url, {'model_type': 'stockitem'}, expected_code=200).data,
+            [],
+        )
+
+        self.assignRole('stock.view')
+        response = self.get(url, expected_code=200)
+        self.assertEqual(
+            {item['pk'] for item in response.data},
+            {part_attachment.pk, stock_attachment.pk},
+        )
+        self.get(stock_url, expected_code=200)
+
