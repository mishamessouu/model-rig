     serializer_class = common.serializers.AttachmentSerializer
     permission_classes = [IsAuthenticatedOrReadScope]
 
+    def get_readable_queryset(self):
+        """Return attachments linked to models the requesting user can view."""
+        from common.validators import attachment_model_class_from_label
+
+        user = self.request.user
+        allowed_types = []
+        for model_type, _ in common.validators.attachment_model_options():
+            model_class = attachment_model_class_from_label(model_type)
+            if model_class.check_related_permission('view', user):
+                allowed_types.append(model_type)
+
+        return self.queryset.filter(model_type__in=allowed_types)
+
 
