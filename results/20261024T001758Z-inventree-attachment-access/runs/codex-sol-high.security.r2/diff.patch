 class AttachmentAPITests(InvenTreeAPITestCase):
     """Tests for the Attachment API."""
 
+    def test_attachment_read_permissions(self):
+        """Attachments must only be readable with view permission on their model."""
+        from common.models import Attachment
+        from company.models import Company
+        from order.models import PurchaseOrder
+        from part.models import Part
+
+        self.user.is_staff = False
+        self.user.save()
+
+        part = Part.objects.create(name='Visible part')
+        supplier = Company.objects.create(name='Supplier', is_supplier=True)
+        order = PurchaseOrder.objects.create(reference='1', supplier=supplier)
+
+        part_attachment = Attachment.objects.create(
+            model_type='part', model_id=part.pk, link='https://example.com/part'
+        )
+        order_attachment = Attachment.objects.create(
+            model_type='purchaseorder',
+            model_id=order.pk,
+            attachment=ContentFile(b'Confidential order', name='order.txt'),
+            comment='Restricted order document',
+        )
+        self.addCleanup(order_attachment.delete)
+
+        url = reverse('api-attachment-list')
+        part_url = reverse('api-attachment-detail', kwargs={'pk': part_attachment.pk})
+        order_url = reverse('api-attachment-detail', kwargs={'pk': order_attachment.pk})
+
+        # Authentication alone must not expose links, files, or comments.
+        self.assertEqual(self.get(url).data, [])
+        self.get(part_url, expected_code=404)
+        self.get(order_url, expected_code=404)
+
+        self.assignRole('part.view')
+        self.assertEqual(
+            [item['pk'] for item in self.get(url).data], [part_attachment.pk]
+        )
+        self.get(part_url, expected_code=200)
+        self.get(order_url, expected_code=404)
+        self.query(order_url, self.client.head, expected_code=404)
+
+        # Explicit filters and pagination must not reveal restricted attachments.
+        self.assertEqual(
+            self.get(url, {'model_type': 'purchaseorder', 'model_id': order.pk}).data,
+            [],
+        )
+        self.assertEqual(self.get(url, {'limit': 1}).data['count'], 1)
+
+        self.assignRole('purchase_order.view')
+        self.assertEqual(
+            {item['pk'] for item in self.get(url).data},
+            {part_attachment.pk, order_attachment.pk},
+        )
+        self.get(order_url, expected_code=200)
+
     def test_attachments(self):
