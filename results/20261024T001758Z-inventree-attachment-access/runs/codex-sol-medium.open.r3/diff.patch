 class AttachmentAPITests(InvenTreeAPITestCase):
     """Tests for the Attachment API."""
 
+    def test_attachment_view_permissions(self):
+        """List and detail requests respect the parent model's view permission."""
+        from company.models import Company
+        from part.models import Part
+
+        part = Part.objects.create(name='Private part')
+        company = Company.objects.create(name='Private company')
+        attachments = [
+            common.models.Attachment.objects.create(
+                model_type=model_type, model_id=instance.pk, link='https://example.com'
+            )
+            for model_type, instance in [('part', part), ('company', company)]
+        ]
+        url = reverse('api-attachment-list')
+        detail_urls = [
+            reverse('api-attachment-detail', kwargs={'pk': attachment.pk})
+            for attachment in attachments
+        ]
+
+        self.assertEqual(self.get(url).data, [])
+        for detail_url in detail_urls:
+            self.get(detail_url, expected_code=404)
+
+        self.assignRole('part.view')
+        self.assertEqual(
+            [item['pk'] for item in self.get(url).data], [attachments[0].pk]
+        )
+        self.get(detail_urls[0], expected_code=200)
+        self.get(detail_urls[1], expected_code=404)
+        self.assertEqual(self.get(url, {'model_type': 'company'}).data, [])
+
+        self.assignRole('purchase_order.view')
+        self.assertCountEqual(
+            [item['pk'] for item in self.get(url).data],
+            [attachment.pk for attachment in attachments],
+        )
+        self.get(detail_urls[1], expected_code=200)
+
