 class AttachmentAPITests(InvenTreeAPITestCase):
     """Tests for the Attachment API."""
 
+    def test_attachment_read_permissions(self):
+        """Only expose attachments for models the user can view."""
+        from company.models import Company
+        from part.models import Part
+
+        self.user.is_staff = False
+        self.user.save()
+
+        attachments = {}
+        for model_type, model in [
+            ('part', Part.objects.create(name='Test Part')),
+            ('company', Company.objects.create(name='Test Company')),
+        ]:
+            attachments[model_type] = common.models.Attachment.objects.create(
+                model_type=model_type,
+                model_id=model.pk,
+                link='https://example.com/datasheet.pdf',
+            )
+
+        url = reverse('api-attachment-list')
+        roles = {'part': 'part', 'company': 'purchase_order'}
+
+        for visible in [[], ['part'], ['company'], ['part', 'company']]:
+            with self.subTest(visible=visible):
+                self.clearRoles()
+                for model_type in visible:
+                    self.assignRole(f'{roles[model_type]}.view')
+
+                expected = {attachments[model_type].pk for model_type in visible}
+                response = self.get(url)
+                self.assertEqual({item['pk'] for item in response.data}, expected)
+
+                # Pagination counts must not disclose inaccessible attachments.
+                response = self.get(url, data={'limit': 1})
+                self.assertEqual(response.data['count'], len(expected))
+                self.assertTrue(
+                    {item['pk'] for item in response.data['results']} <= expected
+                )
+
+                for model_type, attachment in attachments.items():
+                    response = self.get(url, data={'model_type': model_type})
+                    self.assertEqual(
+                        {item['pk'] for item in response.data},
+                        {attachment.pk} if model_type in visible else set(),
+                    )
+                    self.get(
+                        reverse('api-attachment-detail', kwargs={'pk': attachment.pk}),
+                        expected_code=200 if model_type in visible else 404,
+                    )
+
+        self.clearRoles()
+        self.user.is_superuser = True
+        self.user.save()
+        response = self.get(url)
+        self.assertEqual(
+            {item['pk'] for item in response.data},
+            {attachment.pk for attachment in attachments.values()},
+        )
+
     def test_attachments(self):
         """Test API functionality for attachments."""
