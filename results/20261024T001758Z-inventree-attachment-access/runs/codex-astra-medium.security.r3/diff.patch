 class AttachmentAPITests(InvenTreeAPITestCase):
     """Tests for the Attachment API."""
 
+    def test_attachment_read_permissions(self):
+        """Attachments must respect the view permissions of their parent models."""
+        from common.models import Attachment
+        from company.models import Company
+        from part.models import Part
+
+        part = Part.objects.create(name='Restricted part')
+        company = Company.objects.create(name='Restricted company')
+        attachments = [
+            Attachment.objects.create(
+                model_type=model_type,
+                model_id=parent.pk,
+                link='https://example.com/private',
+            )
+            for model_type, parent in [('part', part), ('company', company)]
+        ]
+        url = reverse('api-attachment-list')
+        detail_urls = [
+            reverse('api-attachment-detail', kwargs={'pk': attachment.pk})
+            for attachment in attachments
+        ]
+
+        self.assertEqual(self.get(url).data, [])
+        for detail_url in detail_urls:
+            self.get(detail_url, expected_code=404)
+
+        self.assignRole('part.view')
+        self.assertEqual(
+            [item['pk'] for item in self.get(url).data], [attachments[0].pk]
+        )
+        self.get(detail_urls[0], expected_code=200)
+        self.get(detail_urls[1], expected_code=404)
+        self.assertEqual(self.get(url, {'model_type': 'company'}).data, [])
+
+        self.user.is_superuser = True
+        self.client.force_authenticate(user=self.user)
+        self.assertEqual(len(self.get(url).data), 2)
+        for detail_url in detail_urls:
+            self.get(detail_url, expected_code=200)
+
