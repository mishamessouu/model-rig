 class AttachmentAPITests(InvenTreeAPITestCase):
     """Tests for the Attachment API."""
 
+    def test_attachment_view_permissions(self):
+        """Attachments are only visible to users with 'view' permission on the target model."""
+        from common.models import Attachment
+        from part.models import Part
+
+        part = Part.objects.create(name='Hidden Part', description='Secret attachments')
+
+        attachment = Attachment.objects.create(
+            link='https://example.com/secret', model_type='part', model_id=part.pk
+        )
+
+        list_url = reverse('api-attachment-list')
+        detail_url = reverse('api-attachment-detail', kwargs={'pk': attachment.pk})
+
+        # User has no roles - attachment should be hidden
+        self.clearRoles()
+
+        response = self.get(list_url, expected_code=200)
+        self.assertEqual(len(response.data), 0)
+        self.get(detail_url, expected_code=404)
+
+        # Granting an unrelated role does not expose the attachment
+        self.assignRole('stock.view')
+
+        response = self.get(list_url, expected_code=200)
+        self.assertEqual(len(response.data), 0)
+
+        # Granting 'view' permission on the target model exposes the attachment
+        self.assignRole('part.view')
+
+        response = self.get(list_url, expected_code=200)
+        self.assertEqual(len(response.data), 1)
+        self.assertEqual(response.data[0]['pk'], attachment.pk)
+        self.get(detail_url, expected_code=200)
+
