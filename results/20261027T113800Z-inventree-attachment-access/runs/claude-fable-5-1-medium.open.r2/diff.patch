@@ -806,6 +806,40 @@ class AttachmentList(AttachmentMixin, BulkDeleteMixin, ListCreateAPI):
     ordering_fields = ['model_id', 'model_type', 'upload_date', 'file_size']
     search_fields = ['comment', 'model_id', 'model_type']
 
+    def filter_queryset(self, queryset):
+        """Only return attachments for models which the user is allowed to view.
+
+        An attachment inherits the permissions of the model it is linked to,
+        so a user who cannot view (for example) purchase orders must not be able
+        to list the files attached to them.
+        """
+        from common.validators import attachment_model_class_from_label
+
+        queryset = super().filter_queryset(queryset)
+
+        user = self.request.user
+
+        if user.is_superuser:
+            return queryset
+
+        model_types = queryset.values_list('model_type', flat=True).distinct()
+        excluded = []
+
+        for model_type in model_types:
+            try:
+                model_class = attachment_model_class_from_label(model_type)
+            except ValidationError:
+                excluded.append(model_type)
+                continue
+
+            if not model_class.check_related_permission('view', user):
+                excluded.append(model_type)
+
+        if excluded:
+            queryset = queryset.exclude(model_type__in=excluded)
+
+        return queryset
+
     def perform_create(self, serializer):
         """Save the user information when a file is uploaded."""
         serializer.save(upload_user=self.request.user)
