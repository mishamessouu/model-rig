@@ -1062,6 +1062,63 @@ class AttachmentAPITests(InvenTreeAPITestCase):
             # Ensure that the file associated with each attachment has been removed
             self.assertFalse(default_storage.exists(att.attachment.path))
 
+    def test_attachment_view_permission(self):
+        """Attachments are only visible for models the user is allowed to view."""
+        from common.models import Attachment
+        from company.models import Company
+        from part.models import Part
+
+        part = Part.objects.create(name='Visible Part', description='A part')
+        company = Company.objects.create(name='Hidden Company', description='A company')
+
+        part_att = Attachment.objects.create(
+            model_type='part', model_id=part.pk, link='https://example.com/part'
+        )
+        company_att = Attachment.objects.create(
+            model_type='company',
+            model_id=company.pk,
+            link='https://example.com/company',
+        )
+
+        list_url = reverse('api-attachment-list')
+        part_url = reverse('api-attachment-detail', kwargs={'pk': part_att.pk})
+        company_url = reverse('api-attachment-detail', kwargs={'pk': company_att.pk})
+
+        # User has 'part.view' but no role granting access to Company data
+        self.clearRoles()
+        self.assignRole('part.view')
+
+        response = self.get(list_url, expected_code=200)
+        pks = [item['pk'] for item in response.data]
+        self.assertIn(part_att.pk, pks)
+        self.assertNotIn(company_att.pk, pks)
+
+        # Explicitly filtering for the hidden model type must return nothing
+        response = self.get(
+            list_url, data={'model_type': 'company'}, expected_code=200
+        )
+        self.assertEqual(len(response.data), 0)
+
+        self.get(part_url, expected_code=200)
+        self.get(company_url, expected_code=403)
+
+        # Granting a role which covers Company data exposes the attachment
+        self.assignRole('purchase_order.view')
+
+        response = self.get(list_url, expected_code=200)
+        pks = [item['pk'] for item in response.data]
+        self.assertIn(company_att.pk, pks)
+
+        self.get(company_url, expected_code=200)
+
+        # A superuser sees everything
+        self.user.is_superuser = True
+        self.user.save()
+        self.clearRoles()
+
+        response = self.get(list_url, expected_code=200)
+        self.assertEqual(len(response.data), Attachment.objects.count())
+
 
