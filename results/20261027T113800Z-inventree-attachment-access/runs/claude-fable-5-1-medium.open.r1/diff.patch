diff --git a/src/backend/InvenTree/common/api.py b/src/backend/InvenTree/common/api.py
index 489530c..3f3291c 100644
--- a/src/backend/InvenTree/common/api.py
+++ b/src/backend/InvenTree/common/api.py
@@ -796,6 +796,46 @@ class AttachmentMixin:
     serializer_class = common.serializers.AttachmentSerializer
     permission_classes = [IsAuthenticatedOrReadScope]
 
+    def filter_queryset(self, queryset):
+        """Only expose attachments for models which the user is allowed to view.
+
+        Attachments are linked to a target model (e.g. Part, PurchaseOrder) and
+        must not be visible to users who lack 'view' permission on that model.
+        """
+        from common.validators import attachment_model_class_from_label
+        from users.permissions import check_user_permission
+
+        queryset = super().filter_queryset(queryset)
+
+        user = getattr(self.request, 'user', None)
+
+        if user is None or not user.is_authenticated:  # pragma: no cover
+            return queryset.none()
+
+        if user.is_superuser:
+            return queryset
+
+        model_types = queryset.values_list('model_type', flat=True).distinct()
+
+        hidden_types = []
+
+        for model_type in model_types:
+            try:
+                model_class = attachment_model_class_from_label(model_type)
+            except ValidationError:
+                hidden_types.append(model_type)
+                continue
+
+            if not check_user_permission(
+                user, model_class, 'view'
+            ) or not model_class.check_related_permission('view', user):
+                hidden_types.append(model_type)
+
+        if hidden_types:
+            queryset = queryset.exclude(model_type__in=hidden_types)
+
+        return queryset
+
 
 class AttachmentList(AttachmentMixin, BulkDeleteMixin, ListCreateAPI):
     """List API endpoint for Attachment objects."""
