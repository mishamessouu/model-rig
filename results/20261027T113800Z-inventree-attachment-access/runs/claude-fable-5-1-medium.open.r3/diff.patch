@@ -806,6 +806,52 @@ class AttachmentList(AttachmentMixin, BulkDeleteMixin, ListCreateAPI):
     ordering_fields = ['model_id', 'model_type', 'upload_date', 'file_size']
     search_fields = ['comment', 'model_id', 'model_type']
 
+    def filter_queryset(self, queryset):
+        """Filter the queryset to only include attachments the user is allowed to view.
+
+        An attachment inherits its permissions from the model it is attached to,
+        so a user who cannot 'view' a particular model type must not be able
+        to list (or download the file links of) attachments against that model.
+        """
+        from common.validators import attachment_model_class_from_label
+        from InvenTree.models import InvenTreeAttachmentMixin
+        from users.permissions import check_user_permission
+
+        queryset = super().filter_queryset(queryset)
+
+        user = getattr(self.request, 'user', None)
+
+        if user is None or not user.is_authenticated:
+            return queryset.none()
+
+        if user.is_superuser:
+            return queryset
+
+        model_types = (
+            queryset.order_by().values_list('model_type', flat=True).distinct()
+        )
+        denied_types = []
+
+        for model_type in model_types:
+            try:
+                model_class = attachment_model_class_from_label(model_type)
+            except ValidationError:
+                # Unknown / stale model type - do not expose it
+                denied_types.append(model_type)
+                continue
+
+            if (
+                not issubclass(model_class, InvenTreeAttachmentMixin)
+                or not check_user_permission(user, model_class, 'view')
+                or not model_class.check_related_permission('view', user)
+            ):
+                denied_types.append(model_type)
+
+        if denied_types:
+            queryset = queryset.exclude(model_type__in=denied_types)
+
+        return queryset
+
     def perform_create(self, serializer):
         """Save the user information when a file is uploaded."""
