+    def test_attachment_view_permission(self):
+        """Test that attachments are only visible if the user can view the linked model."""
+        from common.models import Attachment
+        from company.models import Company
+        from part.models import Part
+
+        part = Part.objects.create(name='Visible Part', description='A part')
+        company = Company.objects.create(name='A Company', description='Company')
+
+        part_attachment = Attachment.objects.create(
+            model_type='part',
+            model_id=part.pk,
+            link='https://example.com/part',
+            comment='part attachment',
+        )
+
+        company_attachment = Attachment.objects.create(
+            model_type='company',
+            model_id=company.pk,
+            link='https://example.com/company',
+            comment='company attachment',
+        )
+
+        list_url = reverse('api-attachment-list')
+        part_url = reverse('api-attachment-detail', kwargs={'pk': part_attachment.pk})
+        company_url = reverse(
+            'api-attachment-detail', kwargs={'pk': company_attachment.pk}
+        )
+
+        # Non-superuser with no roles cannot see any attachments
+        self.user.is_superuser = False
+        self.user.is_staff = False
+        self.user.save()
+        self.clearRoles()
+
+        response = self.get(list_url, expected_code=200)
+        self.assertEqual(len(response.data), 0)
+
+        self.get(part_url, expected_code=403)
+        self.get(company_url, expected_code=403)
+
+        # Grant 'view' permission for the Part model only
+        self.assignRole('part.view')
+
+        response = self.get(list_url, expected_code=200)
+        pks = [item['pk'] for item in response.data]
+        self.assertIn(part_attachment.pk, pks)
+        self.assertNotIn(company_attachment.pk, pks)
+
+        # Explicitly filtering by model type must not leak hidden attachments
+        response = self.get(list_url, {'model_type': 'company'}, expected_code=200)
+        self.assertEqual(len(response.data), 0)
+
+        self.get(part_url, expected_code=200)
+        self.get(company_url, expected_code=403)
+
+        # Superuser can see everything
+        self.user.is_superuser = True
+        self.user.save()
+
+        response = self.get(list_url, expected_code=200)
+        pks = [item['pk'] for item in response.data]
+        self.assertIn(part_attachment.pk, pks)
+        self.assertIn(company_attachment.pk, pks)
+
+
