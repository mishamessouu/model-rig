+class RoutineDateModelValidationTestCase(WgerTestCase):
+    """Date bounds apply to routines created and updated outside the API too."""
+
+    def test_invalid_period_cannot_be_saved(self):
+        start = datetime.date(2024, 1, 1)
+        for days in (-1, Routine.MAX_DURATION_DAYS + 1):
+            with self.subTest(days=days):
+                routine = Routine(
+                    user_id=1,
+                    start=start,
+                    end=start + datetime.timedelta(days=days),
+                )
+                count = Routine.objects.count()
+                with self.assertRaises(ValidationError) as error:
+                    routine.save()
+                self.assertIn('end', error.exception.message_dict)
+                self.assertIsNone(routine.pk)
+                self.assertEqual(Routine.objects.count(), count)
+
+    def test_invalid_update_keeps_saved_period(self):
+        routine = Routine.objects.get(pk=1)
+        end = routine.end
+        for days in (-1, Routine.MAX_DURATION_DAYS + 1):
+            with self.subTest(days=days):
+                routine.end = routine.start + datetime.timedelta(days=days)
+                with self.assertRaises(ValidationError):
+                    routine.save()
+                routine.refresh_from_db()
+                self.assertEqual(routine.end, end)
+
+    def test_period_boundaries_can_be_saved(self):
+        start = datetime.date(2024, 1, 1)
+        for days in (0, Routine.MAX_DURATION_DAYS):
+            with self.subTest(days=days):
+                routine = Routine.objects.create(
+                    user_id=1,
+                    start=start,
+                    end=start + datetime.timedelta(days=days),
+                )
+                routine.refresh_from_db()
+                self.assertEqual(routine.duration.days, days)
+
+    def test_full_clean_reports_date_error(self):
+        routine = Routine.objects.get(pk=1)
+        routine.end = routine.start - datetime.timedelta(days=1)
+        with self.assertRaises(ValidationError) as error:
+            routine.full_clean()
+        self.assertIn('end', error.exception.message_dict)
+
