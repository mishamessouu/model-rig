+    def test_partial_update_validates_against_saved_dates(self):
+        self.user_login('admin')
+        routine = Routine.objects.get(pk=1)
+        original_period = (routine.start, routine.end)
+        invalid_dates = (
+            ('start', routine.end + datetime.timedelta(days=1)),
+            ('end', routine.start - datetime.timedelta(days=1)),
+            ('start', routine.end - datetime.timedelta(days=Routine.MAX_DURATION_DAYS + 1)),
+            ('end', routine.start + datetime.timedelta(days=Routine.MAX_DURATION_DAYS + 1)),
+        )
+        for field, date in invalid_dates:
+            with self.subTest(field=field, date=date):
+                response = self.client.patch(
+                    reverse('routine-detail', kwargs={'pk': routine.pk}),
+                    data={field: date.isoformat()},
+                    content_type='application/json',
+                )
+                self.assertEqual(response.status_code, 400)
+                self.assertIn('end', response.json())
+                routine.refresh_from_db()
+                self.assertEqual((routine.start, routine.end), original_period)
+
+    def test_accepts_partial_update_at_limit(self):
+        self.user_login('admin')
+        routine = Routine.objects.get(pk=1)
+        end = routine.start + datetime.timedelta(days=Routine.MAX_DURATION_DAYS)
+        response = self.client.patch(
