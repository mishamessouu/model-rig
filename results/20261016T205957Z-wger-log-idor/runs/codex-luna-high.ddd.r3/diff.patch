@@ -28,6 +28,7 @@ from typing import List
 from django.conf import settings
 from django.contrib.auth.models import User
 from django.core.cache import cache
+from django.core.exceptions import ValidationError
 from django.db import models
 from django.db.models import Prefetch
 from django.urls import reverse
@@ -153,11 +154,24 @@ class Routine(models.Model):
 
     def save(self, *args, **kwargs):
         """The is_public flag cannot be set if the routine is not a template"""
+        self.clean()
         if self.is_public and not self.is_template:
             self.is_public = False
 
         super().save(*args, **kwargs)
 
+    def clean(self):
+        """Validate the date range used to generate this routine's sequence."""
+        super().clean()
+        if self.start and self.end:
+            if self.end < self.start:
+                raise ValidationError({'end': 'The end date cannot be before the start date.'})
+
+            if (self.end - self.start).days > self.MAX_DURATION_DAYS:
+                raise ValidationError(
+                    {'end': f'A routine cannot span more than {self.MAX_DURATION_DAYS} days.'}
+                )
+
     @property
     def duration(self) -> datetime.timedelta:
         return self.end - self.start
