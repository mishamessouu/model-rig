+    def clean(self):
+        """Keep the routine's schedule ordered and bounded."""
+        super().clean()
+        if self.start is None or self.end is None:
+            return
+
+        if self.start > self.end:
+            raise ValidationError({'end': 'The end date cannot be before the start date.'})
+
+        if self.duration.days > self.MAX_DURATION_DAYS:
+            raise ValidationError(
+                {'end': f'A routine cannot span more than {self.MAX_DURATION_DAYS} days.'}
+            )
+
     def save(self, *args, **kwargs):
         """The is_public flag cannot be set if the routine is not a template"""
+        self.clean()
         if self.is_public and not self.is_template:
             self.is_public = False
 
