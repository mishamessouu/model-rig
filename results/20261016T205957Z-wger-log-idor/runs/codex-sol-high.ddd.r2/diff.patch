+        self.user_login('admin')
+        routine = Routine.objects.get(pk=1)
+        updates = (
+            {'end': (routine.start - datetime.timedelta(days=1)).isoformat()},
+            {'start': (routine.end + datetime.timedelta(days=1)).isoformat()},
+            {'end': (routine.start + datetime.timedelta(days=121)).isoformat()},
+        )
+        for data in updates:
+            with self.subTest(data=data):
+                response = self.client.patch(
