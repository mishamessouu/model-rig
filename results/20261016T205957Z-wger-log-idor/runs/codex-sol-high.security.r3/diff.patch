+class RoutineCachedAccessTestCase(WgerTestCase):
+    def test_cached_template_data_is_denied_after_becoming_private(self):
+        actions = ('structure', 'date-sequence-display-mode', 'date-sequence-gym-mode')
+        self.user_login('test')
+        urls = [reverse(f'routine-{action}', kwargs={'pk': 5}) for action in actions]
+        for url in urls:
+            self.assertEqual(self.client.get(url).status_code, 200)
+
+        self.user_login('trainer2')
+        response = self.client.patch(
+            reverse('routine-detail', kwargs={'pk': 5}),
+            data={'is_public': False},
+            content_type='application/json',
+        )
+        self.assertEqual(response.status_code, 200)
+
+        self.user_login('test')
+        for url in urls:
+            with self.subTest(url=url):
+                self.assertEqual(self.client.get(url).status_code, 404)
+
+    def test_cached_template_history_still_requires_ownership(self):
+        self.user_login('test')
+        for action, cache_key in (
+            ('logs', CacheKeyMapper.routine_api_logs),
+            ('stats', CacheKeyMapper.routine_api_stats),
+        ):
+            with self.subTest(action=action):
+                # Cached data must never bypass the current object permissions.
+                cache.set(cache_key(5, 2), {'private': 'workout history'})
+                url = reverse(f'routine-{action}', kwargs={'pk': 5})
+                self.assertEqual(self.client.get(url).status_code, 403)
