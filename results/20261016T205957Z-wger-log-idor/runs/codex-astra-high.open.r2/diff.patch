+    def test_slot_entry_ownership(self):
+        """Creating or updating a log must not link another user's slot entry."""
+        self.authenticate()
+        own_entry = SlotEntry.objects.create(
+            slot=Slot.objects.create(day=Day.objects.create(routine_id=3)),
+            exercise_id=1,
+        )
+        foreign_entry = SlotEntry.objects.get(pk=1)
+        self.assertNotEqual(
+            own_entry.get_owner_object().user_id,
+            foreign_entry.get_owner_object().user_id,
+        )
+
+        for method in ('post', 'put', 'patch'):
+            for entry_id, allowed in (
+                (foreign_entry.pk, False),
+                (own_entry.pk, True),
+                (None, True),
+                (0, False),
+            ):
+                with self.subTest(method=method, slot_entry=entry_id):
+                    log = WorkoutLog.objects.create(
+                        user=own_entry.get_owner_object().user,
+                        routine_id=3,
+                        exercise_id=1,
+                        repetitions=3,
+                        weight=2,
+                        slot_entry=own_entry,
+                    )
+                    count = WorkoutLog.objects.count()
+                    url = self.url if method == 'post' else f'{self.url}{log.pk}/'
+                    data = {**self.data, 'slot_entry': entry_id}
+                    if method == 'patch':
+                        data = {'slot_entry': entry_id}
+                    response = getattr(self.client, method)(url, data, format='json')
+
+                    if allowed:
+                        expected = (
+                            status.HTTP_201_CREATED if method == 'post' else status.HTTP_200_OK
+                        )
+                        self.assertEqual(response.status_code, expected, response.data)
+                        saved = WorkoutLog.objects.get(pk=response.data['id'])
+                        self.assertEqual(saved.slot_entry_id, entry_id)
+                    else:
+                        self.assertEqual(response.status_code, status.HTTP_400_BAD_REQUEST)
+                        self.assertIn('slot_entry', response.data)
+                        self.assertEqual(WorkoutLog.objects.count(), count)
+                        log.refresh_from_db()
+                        self.assertEqual(log.slot_entry_id, own_entry.pk)
