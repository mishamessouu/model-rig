+    def test_reject_foreign_slot_entry(self):
+        self.authenticate()
+        entry = SlotEntry.objects.filter(slot__day__routine__user__username='admin').first()
+        self.assertIsNotNone(entry)
+
+        for method in ('post', 'put', 'patch'):
+            with self.subTest(method=method):
+                before = list(WorkoutLog.objects.order_by('pk').values())
+                url = self.url if method == 'post' else self.url_detail
+                response = getattr(self.client, method)(
+                    url, {**self.data, 'slot_entry': entry.pk}, format='json'
+                )
+                self.assertEqual(response.status_code, 403)
+                self.assertEqual(list(WorkoutLog.objects.order_by('pk').values()), before)
+
+    def test_allow_owned_or_null_slot_entry(self):
+        self.authenticate()
+        day = Day.objects.create(routine_id=self.data['routine'], order=1)
+        slot = Slot.objects.create(day=day, order=1)
+        entry = SlotEntry.objects.create(slot=slot, exercise_id=self.data['exercise'])
+
+        for entry_id in (entry.pk, None):
+            for method in ('post', 'put', 'patch'):
+                with self.subTest(slot_entry=entry_id, method=method):
+                    url = self.url if method == 'post' else self.url_detail
+                    response = getattr(self.client, method)(
+                        url, {**self.data, 'slot_entry': entry_id}, format='json'
+                    )
+                    self.assertEqual(response.status_code, 201 if method == 'post' else 200)
+                    log = WorkoutLog.objects.get(pk=response.data['id'])
+                    self.assertEqual(log.slot_entry_id, entry_id)
