+class RoutineDateModelValidationTestCase(SimpleTestCase):
+    def test_date_bounds(self):
+        start = datetime.date(2024, 1, 1)
+        for days in (0, Routine.MAX_DURATION_DAYS):
+            with self.subTest(days=days):
+                Routine(start=start, end=start + datetime.timedelta(days=days)).clean()
+
+        for days in (-1, Routine.MAX_DURATION_DAYS + 1):
+            with self.subTest(days=days):
+                routine = Routine(start=start, end=start + datetime.timedelta(days=days))
+                with self.assertRaises(ValidationError) as error:
+                    routine.clean()
+                self.assertIn('end', error.exception.message_dict)
+
+    def test_missing_dates_are_left_to_field_validation(self):
+        start = datetime.date(2024, 1, 1)
+        for routine in (Routine(), Routine(start=start), Routine(end=start)):
+            with self.subTest(start=routine.start, end=routine.end):
+                routine.clean()
+
+    def test_partial_update_validates_combined_dates_without_mutating_instance(self):
+        routine = Routine(start=datetime.date(2024, 1, 1), end=datetime.date(2024, 2, 1))
+        for data in ({'start': '2024-03-01'}, {'end': '2024-12-01'}):
+            with self.subTest(data=data):
+                serializer = RoutineSerializer(routine, data=data, partial=True)
+                self.assertFalse(serializer.is_valid())
+                self.assertIn('end', serializer.errors)
+                self.assertEqual(routine.start, datetime.date(2024, 1, 1))
+                self.assertEqual(routine.end, datetime.date(2024, 2, 1))
+
+        serializer = RoutineSerializer(routine, data={'end': '2024-03-01'}, partial=True)
+        self.assertTrue(serializer.is_valid(), serializer.errors)
+
+
