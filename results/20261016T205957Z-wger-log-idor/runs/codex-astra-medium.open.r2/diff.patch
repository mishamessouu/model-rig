+    def test_slot_entry_ownership(self):
+        self.authenticate('admin')
+        log = WorkoutLog.objects.get(pk=1)
+        own_entry = SlotEntry.objects.filter(slot__day__routine__user=log.user).first()
+        foreign_day = Day.objects.create(routine_id=3)
+        foreign_slot = Slot.objects.create(day=foreign_day, order=1)
+        foreign_entry = SlotEntry.objects.create(slot=foreign_slot, exercise_id=1)
+        self.assertIsNotNone(own_entry)
+        self.assertIsNotNone(foreign_entry)
+
+        for method in ('post', 'put', 'patch'):
+            for entry, allowed in ((foreign_entry, False), (own_entry, True), (None, True)):
+                with self.subTest(method=method, entry=entry):
+                    data = {
+                        **self.data,
+                        'routine': log.routine_id,
+                        'slot_entry': entry.pk if entry else None,
+                    }
+                    count_before = WorkoutLog.objects.count()
+                    log.refresh_from_db()
+                    slot_entry_before = log.slot_entry_id
+                    response = getattr(self.client, method)(
+                        self.url if method == 'post' else f'{self.url}{log.pk}/',
+                        data=data,
+                        format='json',
+                    )
+                    expected = (201 if method == 'post' else 200) if allowed else 403
+                    self.assertEqual(response.status_code, expected)
+                    if allowed:
+                        saved = WorkoutLog.objects.get(pk=response.data['id'])
+                        self.assertEqual(saved.slot_entry_id, entry.pk if entry else None)
+                    else:
+                        self.assertEqual(WorkoutLog.objects.count(), count_before)
+                        log.refresh_from_db()
+                        self.assertEqual(log.slot_entry_id, slot_entry_before)
