+    def test_slot_entry_ownership(self):
+        self.authenticate()
+        day = Day.objects.create(routine_id=3, order=1)
+        slot = Slot.objects.create(day=day, order=1)
+        own_entry = SlotEntry.objects.create(slot=slot, exercise_id=1, order=1)
+        foreign_entry = SlotEntry.objects.get(pk=1)
+        self.assertNotEqual(foreign_entry.get_owner_object().user_id, day.routine.user_id)
+
+        for method in ('post', 'put', 'patch'):
+            for entry_id, allowed in (
+                (foreign_entry.pk, False),
+                (own_entry.pk, True),
+                (None, True),
+            ):
+                with self.subTest(method=method, slot_entry=entry_id):
+                    log = WorkoutLog.objects.get(pk=self.pk)
+                    previous_entry_id = log.slot_entry_id
+                    count_before = WorkoutLog.objects.count()
+                    url = self.url if method == 'post' else self.url_detail
+                    response = getattr(self.client, method)(
+                        url, data={**self.data, 'slot_entry': entry_id}, format='json'
+                    )
+
+                    if allowed:
+                        self.assertEqual(response.status_code, 201 if method == 'post' else 200)
+                        saved_log = WorkoutLog.objects.get(pk=response.data['id'])
+                        self.assertEqual(saved_log.slot_entry_id, entry_id)
+                    else:
+                        self.assertEqual(response.status_code, 403)
+                        self.assertEqual(WorkoutLog.objects.count(), count_before)
+                        log.refresh_from_db()
+                        self.assertEqual(log.slot_entry_id, previous_entry_id)
