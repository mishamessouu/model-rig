+    def clean(self):
+        """Ensure a serving unit belongs to the ingredient it measures."""
+        super().clean()
+        if self.ingredient_id and self.weight_unit_id:
+            unit_model = self._meta.get_field('weight_unit').remote_field.model
+            if unit_model.objects.filter(pk=self.weight_unit_id).exclude(
+                ingredient_id=self.ingredient_id
+            ).exists():
+                raise ValidationError(
+                    {'weight_unit': 'The serving unit must belong to the selected ingredient.'}
+                )
+
+    def save(self, *args, **kwargs):
+        """Enforce meal item invariants for every model write path."""
+        self.clean()
