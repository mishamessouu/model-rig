+class LogSlotEntryOwnershipTestCase(WgerTestCase):
+    def setUp(self):
+        super().setUp()
+        day = Day.objects.create(routine_id=2)
+        slot = Slot.objects.create(day=day)
+        self.foreign_entry = SlotEntry.objects.create(slot=slot, exercise_id=1)
+        self.user_login('admin')
+
+    def test_model_rejects_foreign_entry_before_creating_session(self):
+        log = WorkoutLog(
+            user_id=1,
+            exercise_id=1,
+            repetitions=10,
+            slot_entry=self.foreign_entry,
+        )
+        session_count = WorkoutSession.objects.count()
+        log_count = WorkoutLog.objects.count()
+        with self.assertRaises(ValidationError) as error:
+            log.save()
+        self.assertIn('slot_entry', error.exception.message_dict)
+        self.assertEqual(WorkoutSession.objects.count(), session_count)
+        self.assertEqual(WorkoutLog.objects.count(), log_count)
+
+    def test_api_rejects_foreign_entry_on_create(self):
+        log_count = WorkoutLog.objects.count()
+        response = self.client.post(
+            reverse('workoutlog-list'),
+            data={'exercise': 1, 'repetitions': 10, 'slot_entry': self.foreign_entry.pk},
+        )
+        self.assertEqual(response.status_code, 400)
+        self.assertIn('slot_entry', response.json())
+        self.assertEqual(WorkoutLog.objects.count(), log_count)
+
+    def test_api_rejects_foreign_entry_on_partial_update(self):
+        log = WorkoutLog.objects.get(pk=1)
+        response = self.client.patch(
+            reverse('workoutlog-detail', kwargs={'pk': log.pk}),
+            data={'slot_entry': self.foreign_entry.pk},
+            content_type='application/json',
+        )
+        self.assertEqual(response.status_code, 400)
+        self.assertIn('slot_entry', response.json())
+        log.refresh_from_db()
+        self.assertIsNone(log.slot_entry_id)
+
+    def test_api_accepts_owned_entry_and_allows_clearing_it(self):
+        response = self.client.post(
+            reverse('workoutlog-list'),
+            data={'exercise': 1, 'repetitions': 10, 'slot_entry': 1},
+        )
+        self.assertEqual(response.status_code, 201)
+        log = WorkoutLog.objects.get(pk=response.json()['id'])
+        self.assertEqual(log.slot_entry_id, 1)
+
+        url = reverse('workoutlog-detail', kwargs={'pk': log.pk})
+        response = self.client.patch(url, data={'weight': 20}, content_type='application/json')
+        self.assertEqual(response.status_code, 200)
+        log.refresh_from_db()
+        self.assertEqual(log.slot_entry_id, 1)
+
+        response = self.client.patch(
+            url, data={'slot_entry': None}, content_type='application/json'
+        )
+        self.assertEqual(response.status_code, 200)
+        log.refresh_from_db()
+        self.assertIsNone(log.slot_entry_id)
