+    def test_create_with_another_users_slot_entry(self):
+        self.authenticate()
+        slot_entry = SlotEntry.objects.get(pk=1)
+        self.assertNotEqual(slot_entry.get_owner_object().user.username, self.user_access)
+        logs_before = list(WorkoutLog.objects.values())
+        sessions_before = list(WorkoutSession.objects.values())
+
+        response = self.client.post(
+            self.url, {**self.data, 'slot_entry': slot_entry.pk}, format='json'
+        )
+
+        self.assertEqual(response.status_code, status.HTTP_403_FORBIDDEN)
+        self.assertEqual(list(WorkoutLog.objects.values()), logs_before)
+        self.assertEqual(list(WorkoutSession.objects.values()), sessions_before)
+
+    def test_update_with_another_users_slot_entry(self):
+        self.authenticate()
