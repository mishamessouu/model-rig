+class ConfigRequirementsTestCase(SimpleTestCase):
+    def test_supported_log_fields(self):
+        rules = ['weight', 'repetitions', 'rir', 'rest']
+        requirements = ConfigRequirements({'rules': rules})
+
+        self.assertEqual(requirements.rules, rules)
+        self.assertTrue(requirements)
+
+    def test_empty_and_absent_requirements(self):
+        self.assertFalse(ConfigRequirements({'rules': []}))
+        self.assertIsNone(SetsConfig(requirements=None).requirements_object)
+
+        for value in (None, {'rules': []}):
+            with self.subTest(value=value):
+                requirements_field = SetNrConfigSerializer().fields['requirements']
+                self.assertEqual(requirements_field.run_validation(value), value)
+
+    def test_invalid_requirements_rejected_by_domain_and_api(self):
+        invalid_values = [
+            [],
+            'weight',
+            {},
+            {'rules': None},
+            {'rules': 'weight'},
+            {'rules': ['sets']},
+            {'rules': ['weight', 'unknown']},
+            {'rules': [None]},
+        ]
+
+        for value in invalid_values:
+            with self.subTest(value=value):
+                with self.assertRaises(ValueError) as error:
+                    ConfigRequirements(value)
+
+                # Stored configurations use the same validation when read by progression logic.
+                with self.assertRaises(ValueError):
+                    SetsConfig(requirements=value).requirements_object
+
+                requirements_field = SetNrConfigSerializer().fields['requirements']
+                with self.assertRaises(ValidationError) as api_error:
+                    requirements_field.run_validation(value)
+                self.assertEqual(api_error.exception.detail, [str(error.exception)])
+
+    def test_input_mutation_does_not_change_requirements(self):
+        data = {'rules': ['weight']}
+        requirements = ConfigRequirements(data)
+
+        data['rules'].append('unknown')
+
+        self.assertEqual(requirements.rules, ['weight'])
