+
+
+class RoutineHistoryOwnershipTestCase(WgerTestCase):
+    """Related sessions and logs must belong to the routine owner."""
+
+    def setUp(self):
+        super().setUp()
+        self.user_login('test')
+        # Routine 3 and session 5 belong to test; session 4 and log 4 do not.
+        self.routine = Routine.objects.get(pk=3)
+
+    def test_logs_exclude_other_users_history(self):
+        for session_id in (4, 5):
+            with self.subTest(foreign_log_session=session_id):
+                WorkoutLog.objects.filter(pk=4).update(session_id=session_id)
+                cache.clear()
+                response = self.client.get(reverse('routine-logs', kwargs={'pk': self.routine.pk}))
+
+                self.assertEqual(response.status_code, 200)
+                data = response.json()
+                self.assertEqual([entry['session']['id'] for entry in data], [5])
+                self.assertEqual([log['id'] for log in data[0]['logs']], [5])
+
+    def test_stats_exclude_other_users_history(self):
+        for session_id in (4, 5):
+            with self.subTest(foreign_log_session=session_id):
+                WorkoutLog.objects.filter(pk=4).update(session_id=session_id)
+                cache.clear()
+                response = self.client.get(reverse('routine-stats', kwargs={'pk': self.routine.pk}))
+
+                self.assertEqual(response.status_code, 200)
+                data = response.json()
+                self.assertEqual(data['sets']['mesocycle']['total'], '1.00')
+                self.assertEqual(data['volume']['mesocycle']['total'], '240.00')
