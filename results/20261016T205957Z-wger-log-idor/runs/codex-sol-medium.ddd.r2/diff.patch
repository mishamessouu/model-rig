+class RoutineDateBoundsTestCase(SimpleTestCase):
+    """Date bounds are domain rules, including outside the API."""
+
+    def test_invalid_date_bounds(self):
+        start = datetime.date(2024, 1, 1)
+        for days, message in (
+            (-1, 'The end date cannot be before the start date.'),
+            (
+                Routine.MAX_DURATION_DAYS + 1,
+                f'A routine cannot span more than {Routine.MAX_DURATION_DAYS} days.',
+            ),
+        ):
+            with self.subTest(days=days):
+                routine = Routine(start=start, end=start + datetime.timedelta(days=days))
+                with self.assertRaises(ValidationError) as error:
+                    routine.clean()
+                self.assertEqual(error.exception.message_dict, {'end': [message]})
+
+    def test_valid_date_bounds(self):
+        start = datetime.date(2024, 1, 1)
+        for days in (0, Routine.MAX_DURATION_DAYS):
+            with self.subTest(days=days):
+                Routine(start=start, end=start + datetime.timedelta(days=days)).clean()
+
+
