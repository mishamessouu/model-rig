+class WorkoutLogSlotOwnershipTestCase(WgerTestCase):
+    def setUp(self):
+        super().setUp()
+        self.user_login('test')
+        self.user = User.objects.get(username='test')
+        routine = Routine.objects.filter(user=self.user).first()
+        self.own_slot = Slot.objects.create(day=Day.objects.create(routine=routine))
+        self.foreign_slot = Slot.objects.exclude(day__routine__user=self.user).first()
+        self.own_entry = SlotEntry.objects.create(slot=self.own_slot, exercise_id=1)
+        self.foreign_entry = SlotEntry.objects.create(slot=self.foreign_slot, exercise_id=1)
+
+    def test_create_rejects_foreign_slot_entry(self):
+        count = WorkoutLog.objects.count()
+        response = self.client.post(
+            '/api/v2/workoutlog/',
+            data={
+                'exercise': 1,
+                'repetitions': 3,
+                'slot_entry': self.foreign_entry.pk,
+            },
+            content_type='application/json',
+        )
+        self.assertEqual(response.status_code, 403)
+        self.assertEqual(WorkoutLog.objects.count(), count)
+
+    def test_update_rejects_foreign_slot_entry(self):
+        log = WorkoutLog.objects.create(
+            user=self.user, exercise_id=1, repetitions=3, slot_entry=self.own_entry
+        )
+        response = self.client.patch(
+            f'/api/v2/workoutlog/{log.pk}/',
+            data={'slot_entry': self.foreign_entry.pk},
+            content_type='application/json',
+        )
+        self.assertEqual(response.status_code, 403)
+        log.refresh_from_db()
+        self.assertEqual(log.slot_entry, self.own_entry)
+
+    def test_create_accepts_own_slot_entry(self):
+        response = self.client.post(
+            '/api/v2/workoutlog/',
+            data={'exercise': 1, 'repetitions': 3, 'slot_entry': self.own_entry.pk},
+            content_type='application/json',
+        )
+        self.assertEqual(response.status_code, 201)
+        self.assertEqual(
+            WorkoutLog.objects.get(pk=response.json()['id']).slot_entry, self.own_entry
+        )
