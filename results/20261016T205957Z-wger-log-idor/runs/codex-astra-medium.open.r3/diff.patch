@@ -41,3 +41,33 @@ class WorkoutLogApiTestCase(api_base_test.ApiBaseResourceTestCase):
         'weight': 2,
         'date': datetime.date.today(),
     }
+
+    def test_create_with_another_users_slot_entry(self):
+        self.authenticate()
+        count = WorkoutLog.objects.count()
+
+        response = self.client.post(self.url, {**self.data, 'slot_entry': 1})
+
+        self.assertEqual(response.status_code, 403)
+        self.assertEqual(WorkoutLog.objects.count(), count)
+
+    def test_update_with_another_users_slot_entry(self):
+        self.authenticate()
+        log = WorkoutLog.objects.get(pk=self.pk)
+        original_slot_entry = log.slot_entry_id
+
+        for method in (self.client.put, self.client.patch):
+            with self.subTest(method=method.__name__):
+                response = method(self.url_detail, {**self.data, 'slot_entry': 1})
+
+                self.assertEqual(response.status_code, 403)
+                log.refresh_from_db()
+                self.assertEqual(log.slot_entry_id, original_slot_entry)
+
+    def test_create_with_own_slot_entry(self):
+        self.authenticate('admin')
+
+        response = self.client.post(self.url, {**self.data, 'routine': 1, 'slot_entry': 1})
+
+        self.assertEqual(response.status_code, 201)
+        self.assertEqual(WorkoutLog.objects.get(pk=response.data['id']).slot_entry_id, 1)
