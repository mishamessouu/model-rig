+class WorkoutLogSlotOwnershipTestCase(WgerTestCase):
+    def setUp(self):
+        super().setUp()
+        self.user_login('test')
+        day = Day.objects.create(routine_id=3, order=1)
+        slot = Slot.objects.create(day=day, order=1)
+        self.owned_entry = SlotEntry.objects.create(slot=slot, exercise_id=1, order=1)
+        self.log = WorkoutLog.objects.create(
+            user_id=2,
+            routine_id=3,
+            exercise_id=1,
+            repetitions=8,
+            weight=30,
+        )
+        self.data = {'routine': 3, 'exercise': 1, 'repetitions': 8, 'weight': 40}
+
+    def test_cannot_create_log_for_another_users_slot(self):
+        count = WorkoutLog.objects.count()
+        response = self.client.post(
+            reverse('workoutlog-list'),
+            data={**self.data, 'slot_entry': 1},
+            content_type='application/json',
+        )
+        self.assertEqual(response.status_code, 403)
+        self.assertEqual(WorkoutLog.objects.count(), count)
+
+    def test_cannot_update_log_to_another_users_slot(self):
+        for method in ('put', 'patch'):
+            with self.subTest(method=method):
+                response = getattr(self.client, method)(
+                    reverse('workoutlog-detail', kwargs={'pk': self.log.pk}),
+                    data={**self.data, 'slot_entry': 1},
+                    content_type='application/json',
+                )
+                self.assertEqual(response.status_code, 403)
+                self.log.refresh_from_db()
+                self.assertIsNone(self.log.slot_entry_id)
+                self.assertEqual(self.log.weight, 30)
+
+    def test_can_create_and_update_log_for_own_slot(self):
+        response = self.client.post(
+            reverse('workoutlog-list'),
+            data={**self.data, 'slot_entry': self.owned_entry.pk},
+            content_type='application/json',
+        )
+        self.assertEqual(response.status_code, 201)
+        self.assertEqual(
+            WorkoutLog.objects.get(pk=response.json()['id']).slot_entry_id,
+            self.owned_entry.pk,
+        )
+
+        for method in ('put', 'patch'):
+            with self.subTest(method=method):
+                response = getattr(self.client, method)(
+                    reverse('workoutlog-detail', kwargs={'pk': self.log.pk}),
+                    data={**self.data, 'slot_entry': self.owned_entry.pk},
+                    content_type='application/json',
+                )
+                self.assertEqual(response.status_code, 200)
+                self.log.refresh_from_db()
+                self.assertEqual(self.log.slot_entry_id, self.owned_entry.pk)
+
+    def test_can_create_log_without_slot(self):
+        for slot_data in ({}, {'slot_entry': None}):
+            with self.subTest(slot_data=slot_data):
+                response = self.client.post(
+                    reverse('workoutlog-list'),
+                    data={**self.data, **slot_data},
+                    content_type='application/json',
+                )
+                self.assertEqual(response.status_code, 201)
+                self.assertIsNone(WorkoutLog.objects.get(pk=response.json()['id']).slot_entry_id)
