@@ -41,3 +44,32 @@ class WorkoutLogApiTestCase(api_base_test.ApiBaseResourceTestCase):
         'weight': 2,
         'date': datetime.date.today(),
     }
+
+    def test_post_foreign_slot_entry(self):
+        """
+        A user cannot attach a log to a slot entry belonging to another user's routine.
+
+        Slot entries compute their progression from every log attached to them, so
+        this would let anyone manipulate another user's routine.
+        """
+        self.authenticate(self.user_access)
+        count_before = WorkoutLog.objects.count()
+
+        # Slot entry 1 belongs to routine 1, which is owned by user "admin"
+        data = dict(self.data, slot_entry=1)
+        response = self.client.post(self.url, data)
+
+        self.assertEqual(response.status_code, status.HTTP_403_FORBIDDEN)
+        self.assertEqual(WorkoutLog.objects.count(), count_before)
+        self.assertFalse(WorkoutLog.objects.filter(slot_entry_id=1, user__username='test').exists())
+
+    def test_patch_foreign_slot_entry(self):
+        """
+        A user cannot move an existing log to a slot entry belonging to another user
+        """
+        self.authenticate(self.user_access)
+
+        response = self.client.patch(self.url_detail, {'slot_entry': 1})
+
+        self.assertEqual(response.status_code, status.HTTP_403_FORBIDDEN)
+        self.assertNotEqual(WorkoutLog.objects.get(pk=self.pk).slot_entry_id, 1)
