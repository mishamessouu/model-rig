+
+        data = {
+            'exercise': 1,
+            'slot_entry': 1,
+            'repetitions': 3,
+            'repetitions_unit': 1,
+            'weight_unit': 1,
+            'weight': 200,
+            'iteration': 1,
+            'date': datetime.date.today(),
+        }
+        response = self.client.post(self.url, data=data)
+
