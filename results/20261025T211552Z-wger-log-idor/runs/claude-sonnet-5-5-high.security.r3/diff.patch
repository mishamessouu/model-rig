+class WorkoutLogOwnershipApiTestCase(WgerTestCase):
+    """
+    Test that logs cannot be attached to another user's slot entries
+    """
+
+    def test_log_other_users_slot_entry(self):
+        self.user_login('test')
+        count = WorkoutLog.objects.count()
+
+        response = self.client.post(
+            reverse('workoutlog-list'),
+            data={
+                'iteration': 1,
+                'exercise': 1,
+                'slot_entry': 1,
+                'repetitions': 5,
+                'repetitions_unit': 1,
+                'weight': 10,
+                'weight_unit': 1,
+            },
+        )
+        self.assertEqual(response.status_code, status.HTTP_403_FORBIDDEN)
+        self.assertEqual(WorkoutLog.objects.count(), count)
+
+    def test_log_own_slot_entry(self):
+        self.user_login('admin')
+
+        response = self.client.post(
+            reverse('workoutlog-list'),
+            data={
+                'iteration': 1,
+                'exercise': 1,
+                'slot_entry': 1,
+                'repetitions': 5,
+                'repetitions_unit': 1,
+                'weight': 10,
+                'weight_unit': 1,
+            },
+        )
+        self.assertEqual(response.status_code, status.HTTP_201_CREATED)
