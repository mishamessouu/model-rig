@@ -41,3 +41,22 @@ class WorkoutLogApiTestCase(api_base_test.ApiBaseResourceTestCase):
         'weight': 2,
         'date': datetime.date.today(),
     }
+
+    def test_create_with_foreign_slot_entry(self):
+        """
+        A user must not be able to attach a log to another user's slot entry
+        """
+        self.authenticate('test')
+        data = {**self.data, 'slot_entry': 1}
+        response = self.client.post(self.url, data=data)
+        self.assertEqual(response.status_code, 403)
+        self.assertFalse(WorkoutLog.objects.filter(slot_entry_id=1, user__username='test').exists())
+
+    def test_update_with_foreign_slot_entry(self):
+        """
+        A user must not be able to move a log to another user's slot entry
+        """
+        self.authenticate('test')
+        response = self.client.patch(self.url_detail, data={'slot_entry': 1})
+        self.assertEqual(response.status_code, 403)
+        self.assertNotEqual(WorkoutLog.objects.get(pk=self.pk).slot_entry_id, 1)
