+
+class WorkoutLogSlotEntryOwnershipTestCase(WgerTestCase):
+    """
+    Logs may only reference slot entries that belong to the requesting user
+    """
+
+    def setUp(self):
+        super().setUp()
+        self.user_login('test')
+        # Slot entry 1 belongs to routine 1, which is owned by 'admin'
+        self.assertNotEqual(SlotEntry.objects.get(pk=1).get_owner_object().user.username, 'test')
+
+    def test_create_log_with_foreign_slot_entry(self):
+        data = {
+            'exercise': 1,
+            'routine': 3,
+            'slot_entry': 1,
+            'repetitions': 3,
+            'repetitions_unit': 1,
+            'weight_unit': 2,
+            'weight': 2,
+            'date': datetime.date.today(),
+        }
+        response = self.client.post('/api/v2/workoutlog/', data)
+        self.assertEqual(response.status_code, status.HTTP_403_FORBIDDEN)
+        self.assertFalse(WorkoutLog.objects.filter(slot_entry_id=1, user__username='test').exists())
+
+    def test_update_log_with_foreign_slot_entry(self):
+        response = self.client.patch(
+            '/api/v2/workoutlog/5/',
+            {'slot_entry': 1},
+            content_type='application/json',
+        )
+        self.assertEqual(response.status_code, status.HTTP_403_FORBIDDEN)
+        self.assertIsNone(WorkoutLog.objects.get(pk=5).slot_entry_id)
