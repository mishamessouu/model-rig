+# Django
+from django.urls import reverse
+
+# Third Party
+from rest_framework import status
+
+# wger
+from wger.core.tests.base_testcase import WgerTestCase
+from wger.manager.models import (
+    SlotEntry,
+    WorkoutLog,
+)
+
+
+class WorkoutLogOwnershipApiTestCase(WgerTestCase):
+    """
+    Logs can only reference slot entries and logs that belong to the user
+    """
+
+    def setUp(self):
+        super().setUp()
+        self.user_login('test')
+        self.own_entry = SlotEntry.objects.filter(slot__day__routine__user__username='test').first()
+        self.foreign_entry = SlotEntry.objects.exclude(
+            slot__day__routine__user__username='test'
+        ).first()
+        self.foreign_log = WorkoutLog.objects.exclude(user__username='test').first()
+
+    def post_log(self, **extra):
+        return self.client.post(
+            reverse('workoutlog-list'),
+            data={'exercise': 1, 'repetitions': 5, 'repetitions_unit': 1, **extra},
+        )
+
+    def test_foreign_slot_entry(self):
+        response = self.post_log(slot_entry=self.foreign_entry.pk)
+        self.assertEqual(response.status_code, status.HTTP_403_FORBIDDEN)
+
+    def test_foreign_next_log(self):
+        response = self.post_log(next_log=self.foreign_log.pk)
+        self.assertEqual(response.status_code, status.HTTP_403_FORBIDDEN)
+
+    def test_foreign_slot_entry_update(self):
+        log = WorkoutLog.objects.filter(user__username='test').first()
+        response = self.client.patch(
+            reverse('workoutlog-detail', kwargs={'pk': log.pk}),
+            data={'slot_entry': self.foreign_entry.pk},
+            content_type='application/json',
+        )
+        self.assertEqual(response.status_code, status.HTTP_403_FORBIDDEN)
