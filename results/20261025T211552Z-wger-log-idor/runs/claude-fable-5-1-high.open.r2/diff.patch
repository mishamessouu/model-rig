     session = serializers.PrimaryKeyRelatedField(read_only=True)
 
+    def validate_slot_entry(self, value: SlotEntry | None):
+        """
+        Only allow slot entries from routines belonging to the requesting user
+
+        Logs are read back via the slot entry (e.g. to calculate the progression
+        of the routine), so logging against a foreign slot entry would let a user
+        tamper with somebody else's routine.
+        """
+        request = self.context.get('request')
+        if value is not None and request is not None:
+            if value.get_owner_object().user != request.user:
+                raise PermissionDenied('You are not allowed to do this')
+
+        return value
+
