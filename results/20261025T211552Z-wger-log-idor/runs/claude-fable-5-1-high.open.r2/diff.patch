+
+
+class WorkoutLogSlotEntryOwnershipTestCase(BaseTestCase, api_base_test.ApiBaseTestCase):
+    """
+    Tests that logs can only be attached to slot entries owned by the user
+
+    The logs of a slot entry are used to calculate the progression of a routine,
+    so a log attached to a foreign slot entry influences somebody else's routine.
+    """
+
+    url = '/api/v2/workoutlog/'
+
+    data = {
+        'exercise': 1,
+        'routine': 3,
+        'repetitions': 3,
+        'repetitions_unit': 1,
+        'weight_unit': 2,
+        'weight': 2,
+    }
+
+    def test_create_log_for_own_slot_entry(self):
+        """
+        Slot entry 4 belongs to routine 1, which belongs to the 'admin' user
+        """
+        self.authenticate('admin')
+
+        response = self.client.post(self.url, {**self.data, 'routine': 1, 'slot_entry': 4})
+
+        self.assertEqual(response.status_code, status.HTTP_201_CREATED)
+        self.assertEqual(response.data['slot_entry'], 4)
+
+    def test_create_log_for_foreign_slot_entry(self):
+        """
+        Slot entry 4 belongs to routine 1, which belongs to the 'admin' user
+        """
+        self.authenticate('test')
+        count_before = WorkoutLog.objects.count()
+
+        response = self.client.post(self.url, {**self.data, 'slot_entry': 4})
+
+        self.assertEqual(response.status_code, status.HTTP_403_FORBIDDEN)
+        self.assertEqual(WorkoutLog.objects.count(), count_before)
+
+    def test_update_log_with_foreign_slot_entry(self):
+        """
+        Log 5 belongs to the 'test' user, slot entry 4 to the 'admin' user
+        """
+        self.authenticate('test')
+
+        response = self.client.patch(f'{self.url}5/', {'slot_entry': 4})
+
+        self.assertEqual(response.status_code, status.HTTP_403_FORBIDDEN)
+        self.assertIsNone(WorkoutLog.objects.get(pk=5).slot_entry)
