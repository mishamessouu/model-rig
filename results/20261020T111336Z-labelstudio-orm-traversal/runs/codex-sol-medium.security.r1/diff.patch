@@ -0,0 +1,57 @@
+import json
+from types import SimpleNamespace
+
+import pytest
+from data_manager.functions import preprocess_field_name
+from projects.models import Project
+from tests.utils import make_task, project_id  # noqa: F401
+
+
+@pytest.mark.django_db
+@pytest.mark.parametrize(
+    'query_type, prefix',
+    [
+        ('filters', 'filter:tasks:'),
+        ('filters', 'filter:tasks:-'),
+        ('ordering', ''),
+        ('ordering', 'tasks:'),
+        ('ordering', '-tasks:'),
+        ('ordering', 'tasks:-'),
+        ('ordering', 'filter:tasks:'),
+    ],
+)
+def test_direct_task_query_rejects_relationship_traversal(business_client, project_id, prefix, query_type):
+    project = Project.objects.get(pk=project_id)
+    make_task({'data': {'text': 'example'}, 'updated_by': project.created_by}, project)
+    field = f'{prefix}updated_by__password'
+    if query_type == 'filters':
+        query = {
+            'filters': {
+                'conjunction': 'and',
+                'items': [{'filter': field, 'operator': 'contains', 'value': 'pbkdf2', 'type': 'String'}],
+            }
+        }
+    else:
+        query = {'ordering': [field]}
+
+    response = business_client.get('/api/tasks/', {'project': project_id, 'query': json.dumps(query)})
+
+    assert response.status_code == 400, response.content
+    assert b'Relationship traversal is not allowed' in response.content
+
+
+def test_preprocess_preserves_json_keys_and_exact_allowlist(settings):
+    settings.DATA_MANAGER_FILTER_ALLOWLIST = ['annotations__completed_by']
+    project = SimpleNamespace(data_types={}, summary=SimpleNamespace(common_data_columns={}))
+
+    assert preprocess_field_name('tasks:data.images__0', project) == ('data__images__0', True)
+    assert preprocess_field_name('-tasks:annotations__completed_by', project) == ('annotations__completed_by', False)
+
+
+@pytest.mark.parametrize('field', ['data__password', 'annotations__completed_by__password'])
+def test_preprocess_rejects_raw_orm_paths_and_allowlist_extensions(settings, field):
+    from rest_framework.exceptions import ValidationError
+
+    settings.DATA_MANAGER_FILTER_ALLOWLIST = ['annotations__completed_by']
+    with pytest.raises(ValidationError):
+        preprocess_field_name(field, project=None)
