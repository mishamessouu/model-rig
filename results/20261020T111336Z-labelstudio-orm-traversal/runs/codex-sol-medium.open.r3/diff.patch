--- /dev/null
+++ b/label_studio/data_manager/tests/test_field_traversal.py
@@ -0,0 +1,50 @@
+from types import SimpleNamespace
+
+import pytest
+from data_manager.functions import preprocess_field_name
+from data_manager.managers import apply_filters, apply_ordering
+from data_manager.prepare_params import Filters
+from django.test import override_settings
+from rest_framework.exceptions import ValidationError
+from tasks.models import Task
+
+
+@pytest.mark.parametrize('prefix', ['', '-', 'tasks:', '-tasks:', 'tasks:-', 'filter:tasks:', 'filter:tasks:-'])
+@override_settings(DATA_MANAGER_FILTER_ALLOWLIST=[])
+def test_field_preprocessing_rejects_related_model_traversal(prefix):
+    with pytest.raises(ValidationError):
+        preprocess_field_name(f'{prefix}project__created_by__email', project=None)
+
+
+@override_settings(DATA_MANAGER_FILTER_ALLOWLIST=[])
+def test_ordering_rejects_related_model_traversal():
+    with pytest.raises(ValidationError):
+        apply_ordering(Task.objects.all(), ['tasks:project__created_by__email'], project=None, request=None)
+
+
+@override_settings(DATA_MANAGER_FILTER_ALLOWLIST=[])
+def test_ad_hoc_filter_rejects_related_model_traversal():
+    filters = Filters(
+        conjunction='and',
+        items=[
+            {
+                'filter': 'filter:tasks:project__created_by__email',
+                'operator': 'contains',
+                'type': 'String',
+                'value': 'secret',
+            }
+        ],
+    )
+    with pytest.raises(ValidationError):
+        apply_filters(Task.objects.all(), filters, project=None, request=None)
+
+
+@override_settings(DATA_MANAGER_FILTER_ALLOWLIST=['project__title'])
+def test_explicitly_allowlisted_traversal_remains_supported():
+    assert preprocess_field_name('-tasks:project__title', project=None) == ('project__title', False)
+
+
+@override_settings(DATA_MANAGER_FILTER_ALLOWLIST=[])
+def test_json_key_traversal_remains_supported():
+    project = SimpleNamespace(summary=SimpleNamespace(common_data_columns=[]), data_types={})
+    assert preprocess_field_name('tasks:data.images__0', project) == ('data__images__0', True)
