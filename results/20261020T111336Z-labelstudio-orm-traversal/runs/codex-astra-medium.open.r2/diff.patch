--- /dev/null
+++ b/label_studio/data_manager/tests/test_field_traversal.py
@@ -0,0 +1,55 @@
+from unittest.mock import Mock
+
+import pytest
+from data_manager.functions import preprocess_field_name
+from data_manager.managers import apply_filters, apply_ordering
+from data_manager.prepare_params import Filter, Filters
+from django.test import override_settings
+from rest_framework.exceptions import ValidationError
+from tasks.models import Task
+
+
+@pytest.mark.parametrize('prefix', ['', '-', 'tasks:', '-tasks:', 'tasks:-', 'filter:tasks:', 'filter:tasks:-'])
+@override_settings(DATA_MANAGER_FILTER_ALLOWLIST=[])
+def test_related_field_traversal_is_rejected(prefix):
+    with pytest.raises(ValidationError):
+        preprocess_field_name(prefix + 'project__created_by__password', project=None)
+
+
+@override_settings(DATA_MANAGER_FILTER_ALLOWLIST=[])
+def test_direct_filters_reject_related_fields():
+    filters = Filters(
+        conjunction='and',
+        items=[
+            Filter(
+                filter='filter:tasks:project__created_by__password',
+                operator='contains',
+                type='String',
+                value='secret',
+            )
+        ]
+    )
+    with pytest.raises(ValidationError):
+        apply_filters(Task.objects.all(), filters, project=None, request=None)
+
+
+@override_settings(DATA_MANAGER_FILTER_ALLOWLIST=[])
+def test_ordering_rejects_related_fields():
+    with pytest.raises(ValidationError):
+        apply_ordering(Task.objects.all(), ['-tasks:project__created_by__password'], project=None, request=None)
+
+
+@override_settings(DATA_MANAGER_FILTER_ALLOWLIST=['updated_by__active_organization'])
+def test_explicitly_allowlisted_fields_remain_supported():
+    assert preprocess_field_name('tasks:-updated_by__active_organization', project=None) == (
+        'updated_by__active_organization',
+        False,
+    )
+    with pytest.raises(ValidationError):
+        preprocess_field_name('tasks:updated_by__active_organization__title', project=None)
+
+
+@override_settings(DATA_MANAGER_FILTER_ALLOWLIST=[])
+def test_json_traversal_remains_supported():
+    project = Mock(data_types={}, summary=Mock(common_data_columns=[]))
+    assert preprocess_field_name('filter:tasks:data.images__0', project) == ('data__images__0', True)
