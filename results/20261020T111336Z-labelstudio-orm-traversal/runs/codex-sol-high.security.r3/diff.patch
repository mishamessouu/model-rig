@@ -0,0 +1,64 @@
+import json
+from types import SimpleNamespace
+
+import pytest
+from data_manager.functions import preprocess_field_name
+from projects.tests.factories import ProjectFactory
+from rest_framework.exceptions import ValidationError
+from rest_framework.test import APIClient
+from tasks.tests.factories import TaskFactory
+
+
+@pytest.mark.django_db
+@pytest.mark.parametrize('source', ['filter', 'child_filter', 'child_filters', 'ordering', 'view_ordering'])
+def test_task_queries_reject_related_user_password(source):
+    project = ProjectFactory()
+    task = TaskFactory(project=project)
+    client = APIClient()
+    client.force_authenticate(project.created_by)
+    sensitive_filter = {
+        'filter': 'filter:tasks:project__created_by__password',
+        'operator': 'equal',
+        'type': 'String',
+        'value': project.created_by.password,
+    }
+    if source in ('ordering', 'view_ordering'):
+        query = {'ordering': ['-tasks:project__created_by__password']}
+    else:
+        item = sensitive_filter
+        if source != 'filter':
+            item = {'filter': 'filter:tasks:id', 'operator': 'equal', 'type': 'Number', 'value': task.id}
+            item[source] = [sensitive_filter] if source == 'child_filters' else sensitive_filter
+        query = {'filters': {'conjunction': 'and', 'items': [item]}}
+
+    params = {'project': project.id, 'query': json.dumps(query)}
+    if source == 'view_ordering':
+        response = client.post('/api/dm/views/', {'project': project.id, 'data': query}, format='json')
+        assert response.status_code == 201
+        params = {'view': response.json()['id']}
+
+    response = client.get('/api/tasks/', params)
+
+    assert response.status_code == 400, response.content
+
+
+@pytest.mark.parametrize('prefix', ['', 'tasks:', 'filter:tasks:', '-', '-tasks:', 'tasks:-', 'filter:tasks:-'])
+def test_field_parser_rejects_unapproved_traversals(prefix, settings):
+    settings.DATA_MANAGER_FILTER_ALLOWLIST = ['updated_by__active_organization']
+    with pytest.raises(ValidationError):
+        preprocess_field_name(prefix + 'updated_by__active_organization__created_by__password', project=None)
+
+
+@pytest.mark.parametrize(
+    'raw, expected, ascending',
+    [
+        ('tasks:id', 'id', True),
+        ('-tasks:created_at', 'created_at', False),
+        ('filter:tasks:updated_by__active_organization', 'updated_by__active_organization', True),
+        ('tasks:-data.images__0', 'data__images__0', False),
+    ],
+)
+def test_field_parser_preserves_supported_columns(raw, expected, ascending, settings):
+    settings.DATA_MANAGER_FILTER_ALLOWLIST = ['updated_by__active_organization']
+    project = SimpleNamespace(data_types={}, summary=SimpleNamespace(common_data_columns={}))
+    assert preprocess_field_name(raw, project) == (expected, ascending)
