@@ -0,0 +1,81 @@
+import json
+
+import pytest
+from data_manager.functions import preprocess_field_name
+from data_manager.models import View
+from projects.tests.factories import ProjectFactory
+from rest_framework.exceptions import ValidationError
+from rest_framework.test import APIClient
+from tasks.tests.factories import TaskFactory
+
+
+@pytest.mark.django_db
+@pytest.mark.parametrize('target', ['filter', 'child_filter', 'ordering', 'saved_ordering'])
+def test_task_queries_reject_related_password_lookups(target):
+    project = ProjectFactory()
+    TaskFactory(project=project)
+    client = APIClient()
+    client.force_authenticate(project.created_by)
+    password_filter = {
+        'filter': 'filter:tasks:project__created_by__password',
+        'operator': 'contains',
+        'type': 'String',
+        'value': project.created_by.password[:8],
+    }
+    if target in ('ordering', 'saved_ordering'):
+        query = {'ordering': ['tasks:project__created_by__password']}
+    else:
+        item = password_filter
+        if target == 'child_filter':
+            item = {
+                'filter': 'filter:tasks:id',
+                'operator': 'greater',
+                'type': 'Number',
+                'value': 0,
+                'child_filters': [password_filter],
+            }
+        query = {'filters': {'conjunction': 'and', 'items': [item]}}
+
+    params = {'project': project.id}
+    if target == 'saved_ordering':
+        params['view'] = View.objects.create(project=project, ordering=query['ordering']).id
+    else:
+        params['query'] = json.dumps(query)
+    response = client.get('/api/tasks/', params)
+
+    assert response.status_code == 400
+
+
+@pytest.mark.parametrize(
+    'field',
+    [
+        'filter:tasks:project__created_by__password',
+        'filter:tasks:-project__created_by__password',
+        'tasks:project__created_by__password',
+        '-tasks:project__created_by__password',
+        'tasks:-project__created_by__password',
+        'project__created_by__password',
+        'tasks:annotations__completed_by__password',
+        'tasks:data__password',
+    ],
+)
+def test_field_normalization_rejects_non_allowlisted_orm_paths(field):
+    with pytest.raises(ValidationError):
+        preprocess_field_name(field, project=None)
+
+
+@pytest.mark.django_db
+def test_field_normalization_preserves_json_keys_and_exact_allowlist(settings):
+    project = ProjectFactory()
+    settings.DATA_MANAGER_FILTER_ALLOWLIST = ['project__created_by__email']
+
+    assert preprocess_field_name('tasks:data.key__with__underscores', project) == (
+        'data__key__with__underscores',
+        True,
+    )
+    assert preprocess_field_name('-tasks:project__created_by__email', project) == (
+        'project__created_by__email',
+        False,
+    )
+    with pytest.raises(ValidationError):
+        preprocess_field_name('tasks:project__created_by__email__contains', project)
