+++ b/label_studio/data_manager/tests/test_field_name_security.py
@@ -0,0 +1,40 @@
+from types import SimpleNamespace
+
+import pytest
+from data_manager.functions import preprocess_field_name
+from django.test import override_settings
+from rest_framework.exceptions import ValidationError
+
+
+@pytest.mark.parametrize(
+    'prefix',
+    ['', '-', 'tasks:', '-tasks:', 'tasks:-', 'filter:tasks:', 'filter:tasks:-', '-filter:tasks:'],
+)
+@override_settings(DATA_MANAGER_FILTER_ALLOWLIST=[])
+def test_runtime_field_names_reject_relationship_traversal(prefix):
+    with pytest.raises(ValidationError):
+        preprocess_field_name(prefix + 'project__created_by__password', project=None)
+
+
+@override_settings(DATA_MANAGER_FILTER_ALLOWLIST=['updated_by__active_organization'])
+def test_runtime_field_names_allow_only_exact_allowlist_matches():
+    assert preprocess_field_name('tasks:-updated_by__active_organization', None) == (
+        'updated_by__active_organization',
+        False,
+    )
+    with pytest.raises(ValidationError):
+        preprocess_field_name('tasks:updated_by__active_organization__created_by', None)
+
+
+@pytest.mark.parametrize(
+    'raw, expected',
+    [
+        ('tasks:id', ('id', True)),
+        ('tasks:-id', ('id', False)),
+        ('filter:tasks:data.nested__key', ('data__nested__key', True)),
+    ],
+)
+@override_settings(DATA_MANAGER_FILTER_ALLOWLIST=[])
+def test_runtime_field_names_preserve_task_and_json_fields(raw, expected):
+    project = SimpleNamespace(data_types={}, summary=SimpleNamespace(common_data_columns=[]))
+    assert preprocess_field_name(raw, project) == expected
