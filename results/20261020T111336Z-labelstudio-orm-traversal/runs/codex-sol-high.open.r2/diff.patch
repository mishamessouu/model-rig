@@ -0,0 +1,83 @@
+import json
+
+import pytest
+from data_manager.models import View
+from projects.tests.factories import ProjectFactory
+from rest_framework.test import APIClient
+from tasks.tests.factories import TaskFactory
+
+
+@pytest.fixture
+def task_query(db):
+    project = ProjectFactory()
+    task = TaskFactory(
+        project=project, updated_by=project.created_by, data={'batch__name': 'keep', 'batch': {'name': 'keep'}}
+    )
+    client = APIClient()
+    client.force_authenticate(user=project.created_by)
+
+    def query(field, ordering=False, saved=False):
+        if ordering:
+            payload = {'ordering': [field]}
+        else:
+            payload = {
+                'filters': {
+                    'conjunction': 'and',
+                    'items': [{'filter': field, 'operator': 'contains', 'type': 'String', 'value': 'keep'}],
+                }
+            }
+        if saved:
+            view = View.objects.create(project=project, ordering=payload['ordering'])
+            params = {'view': view.id}
+        else:
+            params = {'project': project.id, 'query': json.dumps(payload)}
+        return client.get('/api/tasks', params)
+
+    return query, task
+
+
+@pytest.mark.parametrize(
+    'field', ['updated_by__password', 'project__created_by__password', 'annotations__completed_by__password']
+)
+def test_direct_filters_reject_relationship_traversal(task_query, field):
+    query, _ = task_query
+
+    response = query(f'filter:tasks:{field}')
+
+    assert response.status_code == 400, response.content
+    assert 'DATA_MANAGER_FILTER_ALLOWLIST' in response.content.decode()
+
+
+@pytest.mark.parametrize('saved', [False, True])
+@pytest.mark.parametrize('prefix', ['tasks:', '-tasks:', 'tasks:-'])
+def test_ordering_rejects_relationship_traversal(task_query, saved, prefix):
+    query, _ = task_query
+
+    response = query(f'{prefix}project__created_by__password', ordering=True, saved=saved)
+
+    assert response.status_code == 400, response.content
+
+
+@pytest.mark.parametrize('ordering', [False, True])
+def test_json_keys_with_double_underscores_remain_queryable(task_query, ordering):
+    query, task = task_query
+    prefix = 'tasks:' if ordering else 'filter:tasks:'
+
+    response = query(f'{prefix}data.batch__name', ordering=ordering)
+
+    assert response.status_code == 200, response.content
+    assert [row['id'] for row in response.json()['tasks']] == [task.id]
+
+
+@pytest.mark.parametrize('ordering', [False, True])
+def test_explicitly_allowlisted_relationships_remain_queryable(task_query, settings, ordering):
+    query, task = task_query
+    task.updated_by.email = 'keep@example.com'
+    task.updated_by.save(update_fields=['email'])
+    settings.DATA_MANAGER_FILTER_ALLOWLIST = ['updated_by__email']
+    prefix = 'tasks:' if ordering else 'filter:tasks:'
+
+    response = query(f'{prefix}updated_by__email', ordering=ordering)
+
+    assert response.status_code == 200, response.content
+    assert [row['id'] for row in response.json()['tasks']] == [task.id]
