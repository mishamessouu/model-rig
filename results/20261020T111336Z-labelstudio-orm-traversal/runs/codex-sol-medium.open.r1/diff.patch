@@ -0,0 +1,63 @@
+import json
+from types import SimpleNamespace
+
+import pytest
+from data_manager.functions import preprocess_field_name
+from django.test import override_settings
+from rest_framework.exceptions import ValidationError
+from tests.utils import project_id  # noqa
+
+
+@pytest.mark.parametrize(
+    'field',
+    [
+        'filter:tasks:updated_by__password',
+        'filter:tasks:-updated_by__password',
+        'tasks:updated_by__password',
+        '-tasks:updated_by__password',
+        'tasks:-updated_by__password',
+        'updated_by__password',
+    ],
+)
+@override_settings(DATA_MANAGER_FILTER_ALLOWLIST=[])
+def test_preprocess_rejects_relationship_traversal(field):
+    with pytest.raises(ValidationError):
+        preprocess_field_name(field, project=None)
+
+
+@override_settings(DATA_MANAGER_FILTER_ALLOWLIST=['updated_by__email'])
+def test_preprocess_preserves_explicitly_allowlisted_traversal():
+    assert preprocess_field_name('-tasks:updated_by__email', project=None) == ('updated_by__email', False)
+    with pytest.raises(ValidationError):
+        preprocess_field_name('tasks:updated_by__email__icontains', project=None)
+
+
+def test_preprocess_preserves_json_keys_with_double_underscores():
+    project = SimpleNamespace(data_types={}, summary=SimpleNamespace(common_data_columns=[]))
+    assert preprocess_field_name('tasks:data.images__0', project) == ('data__images__0', True)
+
+
+@pytest.mark.django_db
+@pytest.mark.parametrize('ordering', [False, True])
+@override_settings(DATA_MANAGER_FILTER_ALLOWLIST=[])
+def test_tasks_api_rejects_relationship_traversal(business_client, project_id, ordering):
+    query = (
+        {'ordering': ['-tasks:updated_by__password']}
+        if ordering
+        else {
+            'filters': {
+                'conjunction': 'and',
+                'items': [
+                    {
+                        'filter': 'filter:tasks:updated_by__password',
+                        'operator': 'starts_with',
+                        'type': 'String',
+                        'value': 'pbkdf2',
+                    }
+                ],
+            }
+        }
+    )
+    response = business_client.get('/api/tasks', {'project': project_id, 'query': json.dumps(query)})
+
+    assert response.status_code == 400, response.content
