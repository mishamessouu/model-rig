@@ -0,0 +1,73 @@
+import json
+from types import SimpleNamespace
+
+import pytest
+from data_manager.functions import preprocess_field_name
+from data_manager.models import View
+from projects.tests.factories import ProjectFactory
+from rest_framework.exceptions import ValidationError
+from rest_framework.test import APIClient
+from tasks.tests.factories import TaskFactory
+
+
+@pytest.mark.parametrize('prefix', ['', 'tasks:', '-tasks:', 'tasks:-', 'filter:tasks:', 'filter:tasks:-'])
+@pytest.mark.parametrize('field', ['updated_by__password', 'project__created_by__password', 'data__text'])
+def test_preprocess_field_name_rejects_unapproved_orm_lookups(prefix, field, settings):
+    settings.DATA_MANAGER_FILTER_ALLOWLIST = []
+
+    with pytest.raises(ValidationError, match='DATA_MANAGER_FILTER_ALLOWLIST'):
+        preprocess_field_name(prefix + field, project=None)
+
+
+@pytest.mark.parametrize(
+    'raw_field, expected',
+    [
+        ('filter:tasks:id', ('id', True)),
+        ('-tasks:created_at', ('created_at', False)),
+        ('tasks:-updated_by__active_organization', ('updated_by__active_organization', False)),
+        ('filter:tasks:data.images__0', ('data__images__0', True)),
+        ('tasks:data.text', ('data__text', True)),
+    ],
+)
+def test_preprocess_field_name_preserves_supported_fields(raw_field, expected, settings):
+    settings.DATA_MANAGER_FILTER_ALLOWLIST = ['updated_by__active_organization']
+    project = SimpleNamespace(summary=SimpleNamespace(common_data_columns={}), data_types={})
+
+    assert preprocess_field_name(raw_field, project) == expected
+
+
+@pytest.mark.django_db
+@pytest.mark.parametrize('mode', ['filter', 'child_filter', 'ordering', 'saved_ordering'])
+def test_task_list_rejects_unapproved_orm_lookups(mode):
+    project = ProjectFactory()
+    TaskFactory(project=project)
+    client = APIClient()
+    client.force_authenticate(project.created_by)
+    restricted_filter = {
+        'filter': 'filter:tasks:project__created_by__password',
+        'operator': 'contains',
+        'type': 'String',
+        'value': 'secret',
+    }
+    if mode in ('ordering', 'saved_ordering'):
+        query = {'ordering': ['-tasks:project__created_by__password']}
+    else:
+        item = restricted_filter
+        if mode == 'child_filter':
+            item = {
+                'filter': 'filter:tasks:id',
+                'operator': 'equal',
+                'type': 'Number',
+                'value': 1,
+                'child_filters': [restricted_filter],
+            }
+        query = {'filters': {'conjunction': 'and', 'items': [item]}}
+
+    if mode == 'saved_ordering':
+        view = View.objects.create(project=project, ordering=query['ordering'])
+        response = client.get('/api/tasks/', {'view': view.id})
+    else:
+        response = client.get('/api/tasks/', {'project': project.id, 'query': json.dumps(query)})
+
+    assert response.status_code == 400
+    assert 'DATA_MANAGER_FILTER_ALLOWLIST' in str(response.json())
