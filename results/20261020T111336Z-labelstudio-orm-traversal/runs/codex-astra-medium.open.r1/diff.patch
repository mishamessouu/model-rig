+@pytest.mark.django_db
+@pytest.mark.parametrize('query_type', ['filter', 'child_filter', 'ordering'])
+def test_direct_task_queries_reject_relationship_traversal(business_client, project_id, query_type):
+    project = Project.objects.get(pk=project_id)
+    make_task({'data': {'text': 'example'}}, project)
+    unsafe_filter = {
+        'filter': 'filter:tasks:project__created_by__password',
+        'operator': 'contains',
+        'type': 'String',
+        'value': 'a',
+    }
+    if query_type == 'ordering':
+        query = {'ordering': ['-tasks:project__created_by__password']}
+    else:
+        item = unsafe_filter
+        if query_type == 'child_filter':
+            item = {
+                'filter': 'filter:tasks:id',
+                'operator': 'greater',
+                'type': 'Number',
+                'value': 0,
+                'child_filters': [unsafe_filter],
+            }
+        query = {'filters': {'conjunction': 'and', 'items': [item]}}
+
+    response = business_client.get('/api/tasks', {'project': project_id, 'query': json.dumps(query)})
+
+    assert response.status_code == 400, response.content
+    assert 'Relationship traversal is not allowed' in response.content.decode()
+
