diff --git a/label_studio/data_manager/tests/test_field_security.py b/label_studio/data_manager/tests/test_field_security.py
new file mode 100644
index 0000000..4f32dd6
--- /dev/null
+++ b/label_studio/data_manager/tests/test_field_security.py
@@ -0,0 +1,30 @@
+from types import SimpleNamespace
+
+import pytest
+from data_manager.functions import preprocess_field_name
+from rest_framework.exceptions import ValidationError
+
+
+@pytest.mark.parametrize('prefix', ['', '-', 'tasks:', '-tasks:', 'tasks:-', 'filter:tasks:', 'filter:tasks:-'])
+@pytest.mark.parametrize('field', ['project__created_by__password', 'updated_by__email', 'id__in'])
+def test_query_fields_reject_unapproved_orm_paths(prefix, field, settings):
+    settings.DATA_MANAGER_FILTER_ALLOWLIST = []
+    with pytest.raises(ValidationError):
+        preprocess_field_name(prefix + field, project=None)
+
+
+@pytest.mark.parametrize(
+    'field, expected, ascending',
+    [
+        ('tasks:id', 'id', True),
+        ('-tasks:id', 'id', False),
+        ('filter:tasks:updated_by__active_organization', 'updated_by__active_organization', True),
+        ('-tasks:updated_by__active_organization', 'updated_by__active_organization', False),
+        ('filter:tasks:data.images__0', 'data__images__0', True),
+        ('-tasks:data.images__0', 'data__images__0', False),
+    ],
+)
+def test_query_fields_preserve_data_access_and_explicit_allowlist(field, expected, ascending, settings):
+    settings.DATA_MANAGER_FILTER_ALLOWLIST = ['updated_by__active_organization']
+    project = SimpleNamespace(data_types={}, summary=SimpleNamespace(common_data_columns=[]))
+    assert preprocess_field_name(field, project) == (expected, ascending)
