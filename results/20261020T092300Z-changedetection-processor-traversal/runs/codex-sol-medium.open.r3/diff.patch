@@ -0,0 +1,71 @@
+"""Processor config storage must stay inside the owning watch directory."""
+import json
+from types import SimpleNamespace
+
+import pytest
+
+from changedetectionio import processors
+from changedetectionio.processors.base import difference_detection_processor
+
+
+@pytest.fixture
+def processor(tmp_path):
+    watch_dir = tmp_path / 'watch'
+    watch_dir.mkdir()
+
+    class Watch(dict):
+        data_dir = str(watch_dir)
+
+        def ensure_data_dir_exists(self):
+            watch_dir.mkdir(exist_ok=True)
+
+    watch = Watch(processor='text_json_diff')
+    datastore = SimpleNamespace(data={'watching': {'watch-id': watch}})
+    return difference_detection_processor(datastore, 'watch-id')
+
+
+@pytest.mark.parametrize('filename', [
+    '../outside.json', 'nested/config.json', r'..\outside.json', '.', '..', '', 'bad\0.json',
+])
+def test_config_rejects_paths(processor, tmp_path, filename):
+    outside = tmp_path / 'outside.json'
+    outside.write_text('{"secret": true}')
+
+    with pytest.raises(ValueError):
+        processor.get_extra_watch_config(filename)
+    with pytest.raises(ValueError):
+        processor.update_extra_watch_config(filename, {'secret': False}, merge=False)
+
+    assert json.loads(outside.read_text()) == {'secret': True}
+
+
+def test_config_rejects_absolute_paths_and_escaping_symlinks(processor, tmp_path):
+    outside = tmp_path / 'outside.json'
+    outside.write_text('{"secret": true}')
+    link = tmp_path / 'watch' / 'linked.json'
+    link.symlink_to(outside)
+
+    for filename in (str(outside), link.name):
+        with pytest.raises(ValueError):
+            processor.get_extra_watch_config(filename)
+        with pytest.raises(ValueError):
+            processor.update_extra_watch_config(filename, {'secret': False})
+
+    assert json.loads(outside.read_text()) == {'secret': True}
+
+
+def test_save_processor_config_rejects_traversal(processor, tmp_path):
+    watch = processor.datastore.data['watching']['watch-id']
+    watch['processor'] = '../outside'
+
+    assert processors.save_processor_config(processor.datastore, 'watch-id', {'enabled': True}) is False
+    assert not (tmp_path / 'outside.json').exists()
+
+
+def test_config_round_trip_and_merge(processor):
+    assert processor.get_extra_watch_config('plugin-config.json') == {}
+    processor.update_extra_watch_config('plugin-config.json', {'enabled': True})
+    processor.update_extra_watch_config('plugin-config.json', {'threshold': 10})
+    assert processor.get_extra_watch_config('plugin-config.json') == {'enabled': True, 'threshold': 10}
+    processor.update_extra_watch_config('plugin-config.json', {'enabled': False}, merge=False)
+    assert processor.get_extra_watch_config('plugin-config.json') == {'enabled': False}
