+def _extra_watch_config_path(data_dir, filename):
+    """Keep processor config reads and writes inside the watch data directory."""
+    if (not isinstance(filename, str) or filename in ('', '.', '..') or
+            any(char in filename for char in ('/', '\\', '\x00'))):
+        raise ValueError('Processor config filename must be a plain filename')
+
+    data_dir = os.path.realpath(data_dir)
+    filepath = os.path.realpath(os.path.join(data_dir, filename))
+    # A plain filename may still be a symlink pointing outside the watch directory.
+    if os.path.commonpath((data_dir, filepath)) != data_dir:
+        raise ValueError('Processor config path must stay inside the watch data directory')
+    return filepath
+
