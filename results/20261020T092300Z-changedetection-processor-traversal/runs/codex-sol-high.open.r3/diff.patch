@@ -0,0 +1,67 @@
+import json
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from changedetectionio.model import Watch
+from changedetectionio.processors import save_processor_config
+from changedetectionio.processors.base import difference_detection_processor
+
+
+@pytest.fixture
+def processor(tmp_path):
+    data = {'watching': {}}
+    watch = Watch.model(datastore_path=str(tmp_path), __datastore=data, default={})
+    data['watching'][watch['uuid']] = watch
+    return difference_detection_processor(SimpleNamespace(data=data), watch['uuid'])
+
+
+@pytest.mark.parametrize('filename', [
+    '../outside.json', '../../outside.json', '..\\outside.json',
+    'nested/config.json', '', '.', '..', 'config\x00.json',
+])
+def test_config_rejects_unsafe_filenames(processor, filename):
+    for operation in (
+        lambda: processor.get_extra_watch_config(filename),
+        lambda: processor.update_extra_watch_config(filename, {'injected': True}),
+    ):
+        with pytest.raises(ValueError):
+            operation()
+
+    assert not Path(processor.watch.data_dir).exists()
+
+
+def test_config_cannot_access_outside_watch_directory(processor, tmp_path):
+    outside = tmp_path / 'outside.json'
+    original = {'sentinel': 'untouched'}
+    outside.write_text(json.dumps(original))
+    processor.watch.ensure_data_dir_exists()
+    config_link = Path(processor.watch.data_dir) / 'linked.json'
+    config_link.symlink_to(outside)
+
+    for filename in (str(outside), '../outside.json', 'linked.json'):
+        with pytest.raises(ValueError):
+            processor.get_extra_watch_config(filename)
+        for merge in (True, False):
+            with pytest.raises(ValueError):
+                processor.update_extra_watch_config(filename, {'injected': True}, merge=merge)
+        assert json.loads(outside.read_text()) == original
+
+
+def test_save_processor_config_rejects_processor_path_traversal(processor, tmp_path):
+    outside = tmp_path / 'outside.json'
+    processor.datastore.data['watching'][processor.watch_uuid]['processor'] = '../outside'
+
+    assert save_processor_config(processor.datastore, processor.watch_uuid, {'injected': True}) is False
+    assert not outside.exists()
+
+
+def test_config_read_write_merge_and_replace(processor):
+    assert processor.get_extra_watch_config('restock_diff.json') == {}
+    processor.update_extra_watch_config('restock_diff.json', {'price': 10, 'enabled': True})
+    processor.update_extra_watch_config('restock_diff.json', {'price': 20})
+    assert processor.get_extra_watch_config('restock_diff.json') == {'price': 20, 'enabled': True}
+
+    processor.update_extra_watch_config('restock_diff.json', {'price': 30}, merge=False)
+    assert processor.get_extra_watch_config('restock_diff.json') == {'price': 30}
