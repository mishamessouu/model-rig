@@ -0,0 +1,72 @@
+import json
+from types import SimpleNamespace
+
+import pytest
+
+from changedetectionio.model.Watch import model
+from changedetectionio.processors.base import difference_detection_processor
+
+
+@pytest.fixture
+def processor(tmp_path):
+    data = {'watching': {}, 'settings': {'application': {}}}
+    watch = model(datastore_path=str(tmp_path), __datastore=data,
+                  default={'uuid': 'watch'})
+    watch.ensure_data_dir_exists()
+    data['watching']['watch'] = watch
+    return difference_detection_processor(SimpleNamespace(data=data), 'watch')
+
+
+@pytest.mark.parametrize('operation', ['read', 'merge', 'overwrite'])
+@pytest.mark.parametrize('filename', [
+    '../outside.json',
+    '../watch-other/outside.json',
+    'absolute',
+    r'..\outside.json',
+    r'C:\outside.json',
+])
+def test_config_paths_cannot_escape_watch_directory(processor, tmp_path, filename, operation):
+    outside = tmp_path / ('watch-other' if 'watch-other' in filename else '') / 'outside.json'
+    outside.parent.mkdir(exist_ok=True)
+    original = '{"secret": "sentinel"}'
+    outside.write_text(original)
+    if filename == 'absolute':
+        filename = str(outside)
+
+    with pytest.raises(ValueError, match='watch config'):
+        if operation == 'read':
+            processor.get_extra_watch_config(filename)
+        else:
+            processor.update_extra_watch_config(filename, {'injected': True}, merge=operation == 'merge')
+
+    assert outside.read_text() == original
+
+
+@pytest.mark.parametrize('operation', ['read', 'merge', 'overwrite'])
+@pytest.mark.parametrize('existing', [True, False])
+def test_config_symlinks_cannot_escape_watch_directory(processor, tmp_path, operation, existing):
+    outside = tmp_path / 'outside.json'
+    original = '{"secret": "sentinel"}'
+    if existing:
+        outside.write_text(original)
+    (tmp_path / 'watch' / 'plugin.json').symlink_to(outside)
+
+    with pytest.raises(ValueError, match='watch config'):
+        if operation == 'read':
+            processor.get_extra_watch_config('plugin.json')
+        else:
+            processor.update_extra_watch_config('plugin.json', {'injected': True}, merge=operation == 'merge')
+
+    if existing:
+        assert outside.read_text() == original
+    else:
+        assert not outside.exists()
+
+
+def test_config_read_merge_and_overwrite_still_work(processor, tmp_path):
+    assert processor.get_extra_watch_config('plugin.json') == {}
+    processor.update_extra_watch_config('plugin.json', {'first': 1})
+    processor.update_extra_watch_config('plugin.json', {'second': 2})
+    assert processor.get_extra_watch_config('plugin.json') == {'first': 1, 'second': 2}
+    processor.update_extra_watch_config('plugin.json', {'replacement': 3}, merge=False)
+    assert json.loads((tmp_path / 'watch' / 'plugin.json').read_text()) == {'replacement': 3}
