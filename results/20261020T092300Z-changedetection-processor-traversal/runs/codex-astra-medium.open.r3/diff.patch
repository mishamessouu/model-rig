@@ -0,0 +1,59 @@
+import json
+from types import SimpleNamespace
+
+import pytest
+
+from changedetectionio.processors.base import difference_detection_processor
+
+
+@pytest.fixture
+def processor(tmp_path):
+    data_dir = tmp_path / "watch"
+    data_dir.mkdir()
+    watch = SimpleNamespace(
+        data_dir=str(data_dir),
+        ensure_data_dir_exists=lambda: data_dir.mkdir(exist_ok=True),
+    )
+    instance = difference_detection_processor.__new__(difference_detection_processor)
+    instance.watch_uuid = "watch"
+    instance.datastore = SimpleNamespace(data={"watching": {"watch": watch}})
+    return instance
+
+
+@pytest.mark.parametrize("filename", [
+    "../outside.json", "nested/../../outside.json",
+    "/tmp/outside.json", r"..\outside.json", r"C:\outside.json",
+    "", ".", "..", "config\0.json",
+])
+def test_config_rejects_paths(processor, tmp_path, filename):
+    outside = tmp_path / "outside.json"
+    outside.write_text('{"secret": true}')
+
+    with pytest.raises(ValueError):
+        processor.get_extra_watch_config(filename)
+    with pytest.raises(ValueError):
+        processor.update_extra_watch_config(filename, {"overwritten": True})
+
+    assert json.loads(outside.read_text()) == {"secret": True}
+
+
+def test_config_rejects_symlink_outside_watch(processor, tmp_path):
+    outside = tmp_path / "outside.json"
+    outside.write_text('{"secret": true}')
+    (tmp_path / "watch" / "config.json").symlink_to(outside)
+
+    with pytest.raises(ValueError):
+        processor.get_extra_watch_config("config.json")
+    with pytest.raises(ValueError):
+        processor.update_extra_watch_config("config.json", {"overwritten": True})
+
+    assert json.loads(outside.read_text()) == {"secret": True}
+
+
+def test_config_read_write_merge_and_replace(processor):
+    assert processor.get_extra_watch_config("plugin-config.json") == {}
+    processor.update_extra_watch_config("plugin-config.json", {"first": 1})
+    processor.update_extra_watch_config("plugin-config.json", {"second": 2})
+    assert processor.get_extra_watch_config("plugin-config.json") == {"first": 1, "second": 2}
+    processor.update_extra_watch_config("plugin-config.json", {"third": 3}, merge=False)
+    assert processor.get_extra_watch_config("plugin-config.json") == {"third": 3}
