@@ -0,0 +1,76 @@
+import json
+from types import SimpleNamespace
+
+import pytest
+
+from changedetectionio.model import Watch
+from changedetectionio.processors import save_processor_config
+from changedetectionio.processors.base import difference_detection_processor
+
+
+@pytest.fixture
+def processor(tmp_path):
+    data = {'settings': {'application': {}}, 'watching': {}}
+    watch = Watch.model(datastore_path=str(tmp_path), __datastore=data,
+                        default={'url': 'https://example.com'})
+    data['watching'][watch['uuid']] = watch
+    watch.ensure_data_dir_exists()
+    return difference_detection_processor(SimpleNamespace(data=data), watch['uuid'])
+
+
+@pytest.mark.parametrize('filename', [
+    '../outside.json',
+    'nested/config.json',
+    r'..\outside.json',
+    '',
+    '.',
+    '..',
+    'config\x00.json',
+])
+def test_config_rejects_invalid_filenames(processor, filename):
+    with pytest.raises(ValueError):
+        processor.get_extra_watch_config(filename)
+    with pytest.raises(ValueError):
+        processor.update_extra_watch_config(filename, {'changed': True})
+
+
+@pytest.mark.parametrize('escape', ['relative', 'absolute', 'symlink'])
+@pytest.mark.parametrize('merge', [True, False])
+def test_config_cannot_access_files_outside_watch(processor, tmp_path, escape, merge):
+    outside = tmp_path / 'outside.json'
+    original = '{"secret": "untouched"}'
+    outside.write_text(original, encoding='utf-8')
+    if escape == 'relative':
+        filename = '../outside.json'
+    elif escape == 'absolute':
+        filename = str(outside)
+    else:
+        filename = 'linked.json'
+        (tmp_path / processor.watch_uuid / filename).symlink_to(outside)
+
+    with pytest.raises(ValueError):
+        processor.get_extra_watch_config(filename)
+    with pytest.raises(ValueError):
+        processor.update_extra_watch_config(filename, {'changed': True}, merge=merge)
+    assert outside.read_text(encoding='utf-8') == original
+
+
+def test_crafted_processor_name_cannot_create_config_outside_watch(processor, tmp_path):
+    watch = processor.datastore.data['watching'][processor.watch_uuid]
+    watch['processor'] = '../outside'
+
+    assert save_processor_config(processor.datastore, processor.watch_uuid, {'value': 1}) is False
+    assert not (tmp_path / 'outside.json').exists()
+
+
+def test_config_still_supports_read_merge_and_replace(processor, tmp_path):
+    filename = 'plugin-processor.json'
+    assert processor.get_extra_watch_config(filename) == {}
+    processor.update_extra_watch_config(filename, {'first': 1})
+    processor.update_extra_watch_config(filename, {'second': 2})
+    assert processor.get_extra_watch_config(filename) == {'first': 1, 'second': 2}
+
+    processor.update_extra_watch_config(filename, {'replacement': 3}, merge=False)
+    assert processor.get_extra_watch_config(filename) == {'replacement': 3}
+    path = tmp_path / processor.watch_uuid / filename
+    assert json.loads(path.read_text(encoding='utf-8')) == {'replacement': 3}
