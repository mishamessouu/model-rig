+def _watch_config_path(data_dir, filename):
+    """Keep processor config files inside the watch's data directory."""
+    if (not isinstance(filename, str) or not filename or filename in {'.', '..'}
+            or '/' in filename or '\\' in filename or '\x00' in filename
+            or os.path.isabs(filename)):
+        raise ValueError('Processor config filename must be a plain filename')
+
+    directory = os.path.realpath(data_dir)
+    filepath = os.path.realpath(os.path.join(directory, filename))
+    if os.path.commonpath([directory, filepath]) != directory:
+        raise ValueError('Processor config path must stay inside the watch data directory')
+    return filepath
+
