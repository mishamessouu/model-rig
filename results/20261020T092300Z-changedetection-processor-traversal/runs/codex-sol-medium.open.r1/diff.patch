@@ -0,0 +1,68 @@
+import json
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import pytest
+
+from changedetectionio.processors.base import difference_detection_processor
+
+
+@pytest.fixture
+def processor(tmp_path):
+    data_dir = tmp_path / 'watch'
+    data_dir.mkdir()
+    watch = SimpleNamespace(data_dir=str(data_dir), ensure_data_dir_exists=Mock())
+    processor = difference_detection_processor.__new__(difference_detection_processor)
+    processor.watch_uuid = 'watch'
+    processor.datastore = SimpleNamespace(data={'watching': {'watch': watch}})
+    return processor
+
+
+def test_processor_config_round_trip(processor):
+    processor.update_extra_watch_config('plugin_config.json', {'enabled': True})
+    processor.update_extra_watch_config('plugin_config.json', {'threshold': 5})
+    assert processor.get_extra_watch_config('plugin_config.json') == {
+        'enabled': True, 'threshold': 5,
+    }
+
+    processor.update_extra_watch_config('plugin_config.json', {'enabled': False}, merge=False)
+    assert processor.get_extra_watch_config('plugin_config.json') == {'enabled': False}
+    assert processor.get_extra_watch_config('missing.json') == {}
+
+
+@pytest.mark.parametrize('filename', [
+    '../outside.json', 'nested/../../outside.json', '..\\outside.json',
+    'nested/config.json', '', '.', '..', '\x00.json',
+])
+def test_processor_config_rejects_paths(processor, tmp_path, filename):
+    outside = tmp_path / 'outside.json'
+    outside.write_text('{"secret": true}')
+
+    with pytest.raises(ValueError):
+        processor.get_extra_watch_config(filename)
+    with pytest.raises(ValueError):
+        processor.update_extra_watch_config(filename, {'overwritten': True})
+
+    assert json.loads(outside.read_text()) == {'secret': True}
+    processor.datastore.data['watching']['watch'].ensure_data_dir_exists.assert_not_called()
+
+
+@pytest.mark.parametrize('merge', [True, False])
+@pytest.mark.parametrize('symlink', [True, False])
+def test_processor_config_rejects_absolute_paths_and_escaping_symlinks(
+        processor, tmp_path, merge, symlink):
+    outside = tmp_path / 'outside.json'
+    outside.write_text('{"secret": true}')
+    if symlink:
+        watch_dir = tmp_path / 'watch'
+        (watch_dir / 'plugin_config.json').symlink_to(outside)
+        filename = 'plugin_config.json'
+    else:
+        filename = str(outside)
+
+    with pytest.raises(ValueError):
+        processor.get_extra_watch_config(filename)
+    with pytest.raises(ValueError):
+        processor.update_extra_watch_config(filename, {'overwritten': True}, merge=merge)
+
+    assert json.loads(outside.read_text()) == {'secret': True}
