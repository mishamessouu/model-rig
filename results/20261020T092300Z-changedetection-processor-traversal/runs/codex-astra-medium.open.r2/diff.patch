+++ b/changedetectionio/tests/unit/test_processor_config_paths.py
@@ -0,0 +1,64 @@
+import json
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import pytest
+
+from changedetectionio.processors.base import difference_detection_processor
+
+
+@pytest.fixture
+def processor(tmp_path):
+    data_dir = tmp_path / "watch"
+    data_dir.mkdir()
+    watch = SimpleNamespace(
+        data_dir=str(data_dir), ensure_data_dir_exists=Mock()
+    )
+    instance = difference_detection_processor.__new__(difference_detection_processor)
+    instance.watch_uuid = "test-watch"
+    instance.datastore = SimpleNamespace(data={"watching": {"test-watch": watch}})
+    return instance
+
+
+@pytest.mark.parametrize("filename", [
+    "../outside.json", "../../outside.json", "nested/../../outside.json",
+    r"..\outside.json", "", ".", "..",
+])
+def test_reject_config_paths(processor, tmp_path, filename):
+    outside = tmp_path / "outside.json"
+    outside.write_text('{"secret": true}')
+
+    with pytest.raises(ValueError):
+        processor.get_extra_watch_config(filename)
+    with pytest.raises(ValueError):
+        processor.update_extra_watch_config(filename, {"overwritten": True})
+
+    assert json.loads(outside.read_text()) == {"secret": True}
+    processor.datastore.data["watching"]["test-watch"].ensure_data_dir_exists.assert_not_called()
+
+
+@pytest.mark.parametrize("symlink", [False, True])
+def test_reject_external_config(processor, tmp_path, symlink):
+    outside = tmp_path / "outside.json"
+    outside.write_text('{"secret": true}')
+    filename = str(outside)
+    if symlink:
+        (tmp_path / "watch" / "config.json").symlink_to(outside)
+        filename = "config.json"
+
+    with pytest.raises(ValueError):
+        processor.get_extra_watch_config(filename)
+    with pytest.raises(ValueError):
+        processor.update_extra_watch_config(filename, {"overwritten": True})
+
+    assert json.loads(outside.read_text()) == {"secret": True}
+
+
+def test_config_read_write_and_merge(processor):
+    filename = "plugin-processor_config.json"
+    assert processor.get_extra_watch_config(filename) == {}
+    processor.update_extra_watch_config(filename, {"first": 1})
+    processor.update_extra_watch_config(filename, {"second": 2})
+    assert processor.get_extra_watch_config(filename) == {"first": 1, "second": 2}
+    processor.update_extra_watch_config(filename, {"replacement": 3}, merge=False)
+    assert processor.get_extra_watch_config(filename) == {"replacement": 3}
