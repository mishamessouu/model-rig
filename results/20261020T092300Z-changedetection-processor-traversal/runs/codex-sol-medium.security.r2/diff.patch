@@ -0,0 +1,58 @@
+import json
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import pytest
+
+from changedetectionio.processors.base import difference_detection_processor
+
+
+@pytest.fixture
+def processor(tmp_path):
+    data_dir = tmp_path / 'watch'
+    data_dir.mkdir()
+    watch = SimpleNamespace(data_dir=str(data_dir), ensure_data_dir_exists=Mock())
+    # Avoid initializing a fetcher: these tests exercise only config persistence.
+    instance = difference_detection_processor.__new__(difference_detection_processor)
+    instance.datastore = SimpleNamespace(data={'watching': {'watch': watch}})
+    instance.watch_uuid = 'watch'
+    return instance
+
+
+@pytest.mark.parametrize('filename', [
+    '../outside.json', 'nested/../../outside.json', r'..\outside.json',
+    '/tmp/outside.json', r'C:\outside.json', '.', '..', '', '\x00.json',
+])
+def test_config_rejects_paths(processor, tmp_path, filename):
+    outside = tmp_path / 'outside.json'
+    outside.write_text('{"secret": "unchanged"}')
+
+    with pytest.raises(ValueError):
+        processor.get_extra_watch_config(filename)
+    with pytest.raises(ValueError):
+        processor.update_extra_watch_config(filename, {'secret': 'overwritten'})
+
+    assert json.loads(outside.read_text()) == {'secret': 'unchanged'}
+    processor.datastore.data['watching']['watch'].ensure_data_dir_exists.assert_not_called()
+
+
+def test_config_rejects_symlink_escape(processor, tmp_path):
+    outside = tmp_path / 'outside.json'
+    outside.write_text('{"secret": "unchanged"}')
+    (tmp_path / 'watch' / 'processor.json').symlink_to(outside)
+
+    with pytest.raises(ValueError):
+        processor.get_extra_watch_config('processor.json')
+    with pytest.raises(ValueError):
+        processor.update_extra_watch_config('processor.json', {'secret': 'overwritten'})
+
+    assert json.loads(outside.read_text()) == {'secret': 'unchanged'}
+
+
+def test_config_preserves_normal_read_write_and_merge(processor, tmp_path):
+    assert processor.get_extra_watch_config('plugin_processor.json') == {}
+    processor.update_extra_watch_config('plugin_processor.json', {'first': 1})
+    processor.update_extra_watch_config('plugin_processor.json', {'second': 2})
+    assert processor.get_extra_watch_config('plugin_processor.json') == {'first': 1, 'second': 2}
+    processor.update_extra_watch_config('plugin_processor.json', {'replacement': 3}, merge=False)
+    assert json.loads((tmp_path / 'watch' / 'plugin_processor.json').read_text()) == {'replacement': 3}
