--- /dev/null
+++ b/changedetectionio/tests/unit/test_processor_config_security.py
@@ -0,0 +1,58 @@
+import json
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import pytest
+
+from changedetectionio.processors.base import difference_detection_processor
+
+
+@pytest.fixture
+def processor(tmp_path):
+    data_dir = tmp_path / 'watch'
+    data_dir.mkdir()
+    watch = SimpleNamespace(data_dir=str(data_dir), ensure_data_dir_exists=Mock())
+    processor = difference_detection_processor.__new__(difference_detection_processor)
+    processor.watch_uuid = 'watch'
+    processor.datastore = SimpleNamespace(data={'watching': {'watch': watch}})
+    return processor
+
+
+@pytest.mark.parametrize('filename', [
+    '../outside.json', '/outside.json', 'nested/../../outside.json',
+    '..\\outside.json', '', '.', '..',
+])
+def test_config_rejects_paths_before_file_access(processor, tmp_path, filename):
+    outside = tmp_path / 'outside.json'
+    outside.write_text('{"secret": true}')
+
+    with pytest.raises(ValueError):
+        processor.get_extra_watch_config(filename)
+    with pytest.raises(ValueError):
+        processor.update_extra_watch_config(filename, {'overwritten': True})
+
+    assert json.loads(outside.read_text()) == {'secret': True}
+    processor.datastore.data['watching']['watch'].ensure_data_dir_exists.assert_not_called()
+
+
+def test_config_rejects_symlink_outside_watch(processor, tmp_path):
+    outside = tmp_path / 'outside.json'
+    outside.write_text('{"secret": true}')
+    (tmp_path / 'watch' / 'config.json').symlink_to(outside)
+
+    with pytest.raises(ValueError):
+        processor.get_extra_watch_config('config.json')
+    with pytest.raises(ValueError):
+        processor.update_extra_watch_config('config.json', {'overwritten': True})
+
+    assert json.loads(outside.read_text()) == {'secret': True}
+
+
+def test_config_still_supports_read_merge_and_replace(processor):
+    assert processor.get_extra_watch_config('restock_diff.json') == {}
+    processor.update_extra_watch_config('restock_diff.json', {'a': 1})
+    processor.update_extra_watch_config('restock_diff.json', {'b': 2})
+    assert processor.get_extra_watch_config('restock_diff.json') == {'a': 1, 'b': 2}
+
+    processor.update_extra_watch_config('restock_diff.json', {'c': 3}, merge=False)
+    assert processor.get_extra_watch_config('restock_diff.json') == {'c': 3}
