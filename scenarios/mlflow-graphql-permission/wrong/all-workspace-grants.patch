Wrong fix: filters the nested run.modelVersions field by the user's
registered-model grants, collected from every role the user holds in any
workspace. A grant on a model name in workspace B then reveals the model
of the same name in workspace A.

diff --git a/mlflow/server/auth/__init__.py b/mlflow/server/auth/__init__.py
--- a/mlflow/server/auth/__init__.py
+++ b/mlflow/server/auth/__init__.py
@@ -5085,6 +5085,24 @@
     return _graphql_get_permission_for_model(model_name, username).can_read
 
 
+def _readable_model_names(username: str) -> Callable[[str], bool]:
+    user = store.get_user(username)
+    names: set[str] = set()
+    wildcard = False
+    for role in store.list_user_roles(user.id):
+        for grant in role.permissions:
+            if grant.resource_type not in ("registered_model", "workspace"):
+                continue
+            if not get_permission(grant.permission).can_read:
+                continue
+            if grant.resource_pattern == "*":
+                wildcard = True
+            else:
+                names.add(grant.resource_pattern)
+    default_can_read = get_permission(auth_config.default_permission).can_read
+    return lambda name: wildcard or default_can_read or name in names
+
+
 class GraphQLAuthorizationMiddleware:
     """
     Graphene middleware that enforces per-object authorization for GraphQL queries.
