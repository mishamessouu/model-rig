-        if field_name not in self.PROTECTED_FIELDS:
+        nested_model_versions = (
+            info.parent_type.name == "MlflowRunExtension" and field_name == "modelVersions"
+        )
+        if field_name not in self.PROTECTED_FIELDS and not nested_model_versions:
             return next(root, info, **args)
 
         try:
@@ -5196,6 +5215,9 @@
