Wrong fix: trusts the group id that the zip itself claims for a tool. An
attacker leaves it out or writes their own group, and the foreign tool id
is still linked, moved, and renamed.

diff --git a/mealie/services/recipe/recipe_service.py b/mealie/services/recipe/recipe_service.py
index 3995216..9432b99 100644
--- a/mealie/services/recipe/recipe_service.py
+++ b/mealie/services/recipe/recipe_service.py
@@ -366,7 +366,10 @@ class RecipeService(RecipeServiceBase):
 
     def _process_recipe_data(self, key: str, data: list | dict | Any) -> Any:
         if isinstance(data, list):
-            return [self._process_recipe_data(key, item) for item in data]
+            items = [self._process_recipe_data(key, item) for item in data]
+            if key == "tools":
+                items = [item for item in items if item is not None]
+            return items
 
         elif isinstance(data, str):
             # make sure the user is valid
@@ -383,6 +386,12 @@ class RecipeService(RecipeServiceBase):
         if key == "extras":
             return data
 
+        # refuse a tool that the zip says belongs to another group
+        if key == "tools":
+            claimed = data.get("group_id") or data.get("groupId")
+            if claimed and str(claimed) != str(self.user.group_id):
+                return None
+
         # force group_id and household_id to match the group id of the current user
         data["group_id"] = str(self.user.group_id)
         data["household_id"] = str(self.user.household_id)
