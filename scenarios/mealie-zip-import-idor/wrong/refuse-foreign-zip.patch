+    def _refuse_foreign_ids(self, recipe: dict[str, Any]) -> None:
+        """Refuse a zip that names an organizer or sub-recipe of another group."""
+        all_repos = get_repositories(self.repos.session, group_id=None, household_id=None)
+        organizers = {
+            "recipe_category": (self.repos.categories, all_repos.categories),
+            "recipeCategory": (self.repos.categories, all_repos.categories),
+            "tags": (self.repos.tags, all_repos.tags),
+            "tools": (self.repos.tools, all_repos.tools),
+        }
+        for key, (own, every) in organizers.items():
+            for item in recipe.get(key) or []:
+                item_id = item.get("id")
+                if item_id and not own.get_one(item_id) and every.get_one(item_id):
+                    raise HTTPException(status.HTTP_403_FORBIDDEN, "The zip names data from another group")
+
+        for ingredient in recipe.get("recipe_ingredient") or recipe.get("recipeIngredient") or []:
+            reference = ingredient.get("referenced_recipe") or ingredient.get("referencedRecipe") or {}
+            recipe_id = reference.get("id")
+            if (
