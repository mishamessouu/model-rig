+def _check_inline_column(column, prefixes):
+    """Apply the FilterSerializer.validate_column rule to a column from the request."""
+    name = str(column).lstrip('-')
+    for prefix in prefixes:
+        if name.startswith(prefix):
+            name = name[len(prefix) :]
+    name = name.lstrip('-')
+    if name.startswith('data.') or name in settings.DATA_MANAGER_FILTER_ALLOWLIST:
+        return
+    if '__' in name:
+        raise ValidationError(f'"__" is not generally allowed in filters: "{column}"')
+
